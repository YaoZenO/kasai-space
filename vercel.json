{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run astro:build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "redirects": [
    {
      "source": "/uses",
      "destination": "/now/",
      "permanent": true
    },
    {
      "source": "/uses/",
      "destination": "/now/",
      "permanent": true
    },
    {
      "source": "/city/province/beijing",
      "destination": "/city/beijing/",
      "permanent": true
    },
    {
      "source": "/city/province/beijing/",
      "destination": "/city/beijing/",
      "permanent": true
    },
    {
      "source": "/city/province/tianjin",
      "destination": "/city/tianjin/",
      "permanent": true
    },
    {
      "source": "/city/province/tianjin/",
      "destination": "/city/tianjin/",
      "permanent": true
    },
    {
      "source": "/city/province/shanghai",
      "destination": "/city/shanghai/",
      "permanent": true
    },
    {
      "source": "/city/province/shanghai/",
      "destination": "/city/shanghai/",
      "permanent": true
    },
    {
      "source": "/city/province/chongqing",
      "destination": "/city/chongqing/",
      "permanent": true
    },
    {
      "source": "/city/province/chongqing/",
      "destination": "/city/chongqing/",
      "permanent": true
    },
    {
      "source": "/city/province/xianggang",
      "destination": "/city/xianggang/",
      "permanent": true
    },
    {
      "source": "/city/province/xianggang/",
      "destination": "/city/xianggang/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
