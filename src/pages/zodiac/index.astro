---
// 生肖总览页（/zodiac/）：复刻 themes/fluid/layout/zodiac.ejs 的索引（overview）分支
// （z 为空、ov 非空）。动物页分支未在本阶段移植。
// 数据：source/_data/zodiac.yml；计算：src/lib/zodiac-data.ts（干支、起止、三合六冲）

import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getData } from '../../lib/data';
import { buildOverview } from '../../lib/zodiac-data';
import { fmtItemDate } from '../../lib/dates';
import { urlFor } from '../../lib/url';
import { pageDates } from '../../lib/page-meta';

const ov = buildOverview(getData().zodiac);
const { published, modified } = pageDates('zodiac/index.md');
---

<BaseLayout title="十二生肖" currentPath="/zodiac/" ogDate={published} ogUpdated={modified}>
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>
  <div class="paper-page cal-page z-page">
    <div class="home-wrap ab-page-shell z-v2">
      {!ov ? (
        <>
          <header class="pg-hd">
            <h1 class="pg-hd-title">十二生肖</h1>
          </header>
          <EmptyState>生肖内容还在整理中，页面会随数据录入自动生成，欢迎稍后再来看看。</EmptyState>
        </>
      ) : (
        <>
          <header class="pg-hd z-v2-head">
            <p class="ab-watermark" data-ab-parallax="0.16" aria-hidden="true">ZODIAC</p>
            <nav class="cal-crumb" aria-label="面包屑">
              <a href={urlFor('/library/')}>资料库</a><span aria-hidden="true">/</span><span class="cal-crumb-now">十二生肖</span>
            </nav>
            <h1 class="pg-hd-title">十二生肖</h1>
            <p class="cal-lede"><Fragment set:html={ov.lede} /></p>
            <p class="pg-hd-meta">
              更新于 {fmtItemDate(ov.updated)} · {ov.rows.length} 个生肖 · 本轮 {ov.cycle.from}–{ov.cycle.to}
            </p>
          </header>

          <section class="z-finder" aria-label="按出生年份速查生肖">
            <div class="z-finder-ctrl">
              <label class="z-finder-label" for="z-year-select">速查出生年份</label>
              <select id="z-year-select" class="z-finder-select" data-z-year>
                <option value="">选择年份（1940–2035）…</option>
                {Array.from({ length: 96 }, (_, i) => 2035 - i).map((yr) => (
                  <option value={yr}>{yr} 年</option>
                ))}
              </select>
              <div class="z-finder-quick" aria-label="常用年份快捷选择">
                {[1995, 2000, 2002, 2004, 2026].map((yr) => (
                  <button type="button" class="z-finder-pill" data-z-pick={yr}>{yr}</button>
                ))}
              </div>
            </div>
            <div class="z-finder-res" id="z-finder-res" hidden>
              <span class="z-finder-out" data-z-out />
              <a class="z-finder-go" data-z-go href="#">查看属相档案 →</a>
            </div>
          </section>

          <section class="cal-block">
            <div class="col-head">
              <h2 class="col-title">十二生肖</h2>
              <span class="col-count">/ {ov.rows.length}</span>
            </div>
            <div class="z-cards" data-z-grid>
              {ov.rows.map((zr: any) => (
                <a class="z-card" data-z-key={zr.key} href={urlFor('/zodiac/' + zr.key + '/')}>
                  <span class="z-card-thumb">
                    <img
                      src={zr.thumb}
                      alt={zr.image ? zr.image.alt : zr.animal + '生肖配图'}
                      width="320"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="z-card-body">
                    <span class="z-card-head">
                      <span class="z-card-name">{zr.animal}</span>
                      <span class="z-card-pos">第 {zr.position} 位</span>
                    </span>
                    <span class="z-card-line">地支「{zr.branch}」· 五行 {zr.element}</span>
                    <span class="z-card-year">本轮 {zr.featured} · {zr.ganzhi}</span>
                  </span>
                </a>
              ))}
            </div>
            <p class="cal-fest-lead">年份是该生肖在本轮（{ov.cycle.from}–{ov.cycle.to}）次序中对应的那一年，从春节当天起算、不按 1 月 1 日；查自己出生那年属什么，见下方按出生年份的对照表。</p>
          </section>

          <section class="cal-block">
            <div class="col-head">
              <h2 class="col-title">按出生年份查生肖</h2>
            </div>
            <p class="cal-fest-lead">找到出生年份对应的生肖即可。出生在 1 月或 2 月初的人，属相可能属于上一年——生肖年按春节更替，不按 1 月 1 日，请以出生当年的春节日期为准。</p>
            <div class="cal-table-wrap">
              <table class="cal-table z-birth">
                <thead>
                  <tr>
                    <th scope="col">生肖</th>
                    <th scope="col">出生年份（每 12 年一轮）</th>
                  </tr>
                </thead>
                <tbody>
                  {ov.rows.map((br: any) => (
                    <tr>
                      <th scope="row"><a class="z-animal-link" href={urlFor('/zodiac/' + br.key + '/')}><span class="cal-name">{br.animal}</span></a></th>
                      <td>{br.birthYears.join(' · ')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <div class="cal-top">
            <section class="cal-block">
              <div class="col-head">
                <h2 class="col-title">五行与传统方位、颜色</h2>
              </div>
              <div class="cal-table-wrap">
                <table class="cal-table z-elements">
                  <thead>
                    <tr>
                      <th scope="col">五行</th>
                      <th scope="col">天干</th>
                      <th scope="col">方位</th>
                      <th scope="col">传统色</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ov.elements.map((el: any) => (
                      <tr>
                        <th scope="row"><span class="cal-name">{el.element}</span></th>
                        <td>{el.stems}</td>
                        <td>{el.direction}</td>
                        <td>{el.color}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="z-note">五行与方位、颜色的对应是传统说法（《黄帝内经》一系），不是命理吉凶；生肖的五行由天干决定，每十年一轮。</p>
            </section>

            <section class="cal-block cal-year">
              <div class="col-head">
                <h2 class="col-title">三合与相冲</h2>
              </div>
              <div class="cal-table-wrap">
                <table class="cal-table z-sanhe">
                  <thead>
                    <tr>
                      <th scope="col">组合</th>
                      <th scope="col">传统解释</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ov.sanhe.map((sh: any) => (
                      <tr>
                        <th scope="row"><span class="cal-name">{sh.animals.join('')}</span></th>
                        <td>三合，三者合成{sh.ju}，互相增强</td>
                      </tr>
                    ))}
                    {ov.chong.map((ch: any) => (
                      <tr>
                        <th scope="row"><span class="cal-name">{ch.join('')}</span></th>
                        <td>六冲，正对相对，传统上是最强的对立</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          </div>

          <div class="cal-notes">
            <article class="about-body cal-prose">
              <div class="markdown-body">
                <Fragment set:html={ov.prose} />
              </div>
            </article>

            {ov.faq.length > 0 && (
              <aside class="cal-faq">
                <h2 class="col-title">关于生肖的常见问题</h2>
                {ov.faq.map((item: any) => (
                  <details class="cal-faq-item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))}
              </aside>
            )}
          </div>

          <div class="cal-after">
            <p class="cal-note">生肖与干支依据公开历法资料整理，生肖年以农历正月初一为界（GB/T 33661-2017《农历的编算和颁行》）；各生肖年的起止日期与本站节假日页一致。性格与幸运物是民间流传的说法，只作参考。</p>
          </div>
        </>
      )}
    </div>
  </div>

  <script is:inline>
    (function () {
      var sel = document.querySelector('[data-z-year]');
      var res = document.getElementById('z-finder-res');
      var out = document.querySelector('[data-z-out]');
      var go = document.querySelector('[data-z-go]');
      var grid = document.querySelector('[data-z-grid]');
      if (!sel || !res || !out || !go || !grid) return;

      var STEMS = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
      var BRANCHES = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
      var ANIMALS = [
        { k: 'rat', n: '鼠' }, { k: 'ox', n: '牛' }, { k: 'tiger', n: '虎' }, { k: 'rabbit', n: '兔' },
        { k: 'dragon', n: '龙' }, { k: 'snake', n: '蛇' }, { k: 'horse', n: '马' }, { k: 'goat', n: '羊' },
        { k: 'monkey', n: '猴' }, { k: 'rooster', n: '鸡' }, { k: 'dog', n: '狗' }, { k: 'pig', n: '猪' },
      ];
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-z-key]'));

      function showYear(yrStr) {
        var y = parseInt(yrStr, 10);
        if (!y || isNaN(y)) {
          res.hidden = true;
          grid.classList.remove('has-picked');
          cards.forEach(function (c) { c.classList.remove('is-picked'); });
          return;
        }
        var sIdx = ((y - 4) % 10 + 10) % 10;
        var bIdx = ((y - 4) % 12 + 12) % 12;
        var a = ANIMALS[bIdx];
        out.textContent = y + ' 年 · ' + STEMS[sIdx] + BRANCHES[bIdx] + a.n + '年（地支「' + BRANCHES[bIdx] + '」，以春节为界）';
        go.href = '/zodiac/' + a.k + '/';
        go.textContent = '查看「' + a.n + '」属相档案 →';
        res.hidden = false;
        grid.classList.add('has-picked');
        cards.forEach(function (c) {
          c.classList.toggle('is-picked', c.getAttribute('data-z-key') === a.k);
        });
      }

      sel.addEventListener('change', function () { showYear(sel.value); });
      Array.prototype.slice.call(document.querySelectorAll('[data-z-pick]')).forEach(function (btn) {
        btn.addEventListener('click', function () {
          var v = btn.getAttribute('data-z-pick') || '';
          sel.value = v;
          showYear(v);
        });
      });
    })();
  </script>

  <style is:global>
    .z-v2 .z-v2-head{position:relative;padding:clamp(1rem,2.6vw,2.2rem) 0 1.8rem;margin-bottom:1.8rem;border-bottom:1px solid var(--line-color);overflow:clip}
    .z-v2 .z-v2-head>*:not(.ab-watermark){position:relative;z-index:1}
    .z-v2 .pg-hd-title{font-family:var(--font-serif-title);font-size:clamp(2.2rem,4.6vw,3.4rem);line-height:1.08;letter-spacing:-0.02em}
    .z-finder{margin:0 0 2.2rem;padding:1rem 0 1.2rem;border-bottom:1px solid var(--line-color);display:flex;flex-direction:column;gap:.85rem}
    .z-finder-ctrl{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem 1rem}
    .z-finder-label{font-family:var(--font-mono);font-size:.78rem;letter-spacing:.08em;color:var(--accent);font-weight:700}
    .z-finder-select{padding:.34rem .75rem;border:1px solid var(--line-color);border-radius:999px;background:var(--body-bg-color);color:var(--text-color);font-family:var(--font-mono);font-size:.8rem;cursor:pointer}
    .z-finder-select:focus{outline:2px solid var(--accent);outline-offset:2px}
    .z-finder-quick{display:flex;flex-wrap:wrap;gap:.4rem}
    .z-finder-pill{padding:.22rem .62rem;border:1px solid var(--line-color);border-radius:999px;background:transparent;color:var(--sec-text-color);font-family:var(--font-mono);font-size:.76rem;cursor:pointer;transition:border-color 160ms ease,color 160ms ease}
    .z-finder-pill:hover{border-color:var(--accent);color:var(--accent)}
    .z-finder-res{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem 1.2rem;padding:.75rem 1rem;border-left:2px solid var(--accent);background:var(--surface-tint);border-radius:0 var(--r-sm) var(--r-sm) 0}
    .z-finder-out{font-family:var(--font-serif-title);font-size:.98rem;font-weight:600;color:var(--text-color)}
    .z-finder-go{font-family:var(--font-mono);font-size:.8rem;font-weight:700;color:var(--accent);text-decoration:none}
    .z-finder-go:hover{text-decoration:underline;text-underline-offset:3px}
    .z-v2 .z-card{border-radius:var(--r-sm);border:1px solid var(--line-color);background:transparent;box-shadow:none;transition:border-color 200ms ease,transform 240ms cubic-bezier(.22,1,.36,1),opacity 220ms ease}
    .z-v2 .z-cards:hover .z-card:not(:hover),.z-v2 .z-cards.has-picked .z-card:not(.is-picked){opacity:.48}
    .z-v2 .z-card:hover,.z-v2 .z-card.is-picked{opacity:1;border-color:var(--accent);transform:translateY(-3px)}
    .z-v2 .z-card.is-picked .z-card-name{color:var(--accent)}
    .z-v2 .z-card-thumb img{transition:transform 420ms cubic-bezier(.22,1,.36,1)}
    .z-v2 .z-card:hover .z-card-thumb img{transform:scale(1.04)}
    @media (prefers-reduced-motion:reduce){.z-v2 .z-card,.z-v2 .z-card-thumb img{transition:none}}
  </style>
</BaseLayout>
