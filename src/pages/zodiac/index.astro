---
// 生肖总览页（/zodiac/）：复刻 themes/fluid/layout/zodiac.ejs 的索引（overview）分支
// （z 为空、ov 非空）。动物页分支未在本阶段移植。
// 数据：source/_data/zodiac.yml；计算：src/lib/zodiac-data.ts（干支、起止、三合六冲）

import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getData } from '../../lib/data';
import { buildOverview } from '../../lib/zodiac-data';
import { fmtItemDate } from '../../lib/dates';
import { urlFor } from '../../lib/url';
import { pageDates } from '../../lib/page-meta';

const ov = buildOverview(getData().zodiac);
const { published, modified } = pageDates('zodiac/index.md');
---

<BaseLayout title="十二生肖" currentPath="/zodiac/" ogDate={published} ogUpdated={modified}>
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>
  <div class="paper-page cal-page z-page">
    <div class="home-wrap ab-page-shell z-v2">
      {!ov ? (
        <>
          <header class="pg-hd">
            <h1 class="pg-hd-title">十二生肖</h1>
          </header>
          <EmptyState>生肖内容还在整理中，页面会随数据录入自动生成，欢迎稍后再来看看。</EmptyState>
        </>
      ) : (
        <>
          <header class="pg-hd z-v2-head">
            <p class="ab-watermark" data-ab-parallax="0.16" aria-hidden="true">ZODIAC</p>
            <div class="z-v2-head-main">
              <nav class="cal-crumb" aria-label="面包屑">
                <a href={urlFor('/library/')}>资料库</a><span aria-hidden="true">/</span><span class="cal-crumb-now">十二生肖</span>
              </nav>
              <p class="z-v2-kicker">TWELVE EARTHLY BRANCHES · 干支历法</p>
              <h1 class="pg-hd-title">十二生肖</h1>
              <p class="cal-lede"><Fragment set:html={ov.lede} /></p>
              <p class="pg-hd-meta">
                更新于 {fmtItemDate(ov.updated)} · {ov.rows.length} 个生肖 · 本轮 {ov.cycle.from}–{ov.cycle.to}
              </p>
            </div>

            <aside class="z-finder" aria-label="按出生年份速查生肖">
              <p class="z-finder-label">按出生年份速查</p>
              <div class="z-finder-ctrl">
                <select id="z-year-select" class="z-finder-select" data-z-year aria-label="选择出生年份">
                  <option value="">选择年份（1940–2035）…</option>
                  {Array.from({ length: 96 }, (_, i) => 2035 - i).map((yr) => (
                    <option value={yr}>{yr} 年</option>
                  ))}
                </select>
                <div class="z-finder-quick" aria-label="常用年份快捷选择">
                  {[1995, 2000, 2002, 2004, 2026].map((yr) => (
                    <button type="button" class="z-finder-pill" data-z-pick={yr}>{yr}</button>
                  ))}
                </div>
              </div>
              <div class="z-finder-res" id="z-finder-res" hidden>
                <span class="z-finder-out" data-z-out />
                <a class="z-finder-go" data-z-go href="#">查看属相档案 →</a>
              </div>
              <p class="z-finder-hint">以当年春节为界；1 月或 2 月初出生可能属上一年。</p>
            </aside>
          </header>

          <section class="cal-block">
            <div class="col-head">
              <h2 class="col-title">十二生肖</h2>
              <span class="col-count">/ {ov.rows.length}</span>
            </div>
            <div class="z-cards" data-z-grid>
              {ov.rows.map((zr: any) => (
                <a class="z-card" data-z-key={zr.key} href={urlFor('/zodiac/' + zr.key + '/')}>
                  <span class="z-card-thumb">
                    <img
                      src={zr.thumb}
                      alt={zr.image ? zr.image.alt : zr.animal + '生肖配图'}
                      width="320"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="z-card-body">
                    <span class="z-card-head">
                      <span class="z-card-name">{zr.animal}</span>
                      <span class="z-card-pos">第 {zr.position} 位</span>
                    </span>
                    <span class="z-card-line">地支「{zr.branch}」· 五行 {zr.element}</span>
                    <span class="z-card-year">本轮 {zr.featured} · {zr.ganzhi}</span>
                  </span>
                </a>
              ))}
            </div>
            <p class="z-v2-caption">年份为该生肖在本轮（{ov.cycle.from}–{ov.cycle.to}）对应的年份，自春节起算。</p>

            <details class="z-birth-fold">
              <summary>展开完整出生年份对照表（每 12 年一轮）</summary>
              <div class="cal-table-wrap">
                <table class="cal-table z-birth">
                  <thead>
                    <tr>
                      <th scope="col">生肖</th>
                      <th scope="col">出生年份（每 12 年一轮）</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ov.rows.map((br: any) => (
                      <tr>
                        <th scope="row"><a class="z-animal-link" href={urlFor('/zodiac/' + br.key + '/')}><span class="cal-name">{br.animal}</span></a></th>
                        <td>{br.birthYears.join(' · ')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>

          <section class="z-cosmos" aria-label="十二地支关系罗盘与五行三合相冲">
            <div class="col-head z-cosmos-hd">
              <h2 class="col-title">地支罗盘 · 五行与三合相冲</h2>
              <span class="col-count">/ 悬停或点击任意生肖与组合，实时绘制关系连线</span>
            </div>

            <div class="z-cosmos-grid">
              {/* 左：交互式十二地支关系罗盘 SVG */}
              <div class="z-compass-wrap">
                <svg class="z-compass" viewBox="0 0 420 420" role="img" aria-label="十二地支三合六冲交互罗盘" data-z-compass>
                  <circle class="zc-ring-outer" cx="210" cy="210" r="176" />
                  <circle class="zc-ring-mid" cx="210" cy="210" r="134" />
                  <g class="zc-lines" data-z-lines />
                  <circle class="zc-ring-inner" cx="210" cy="210" r="64" />
                  <g class="zc-nodes">
                    {ov.rows.map((zr: any, idx: number) => {
                      const deg = -90 + idx * 30;
                      const rad = (deg * Math.PI) / 180;
                      const cx = Math.round((210 + 154 * Math.cos(rad)) * 10) / 10;
                      const cy = Math.round((210 + 154 * Math.sin(rad)) * 10) / 10;
                      return (
                        <g
                          class={`zc-node${idx === 6 ? ' is-focus' : ''}`}
                          data-zc-idx={idx}
                          data-zc-key={zr.key}
                          data-zc-animal={zr.animal}
                          data-zc-branch={zr.branch}
                          data-zc-element={zr.element}
                          tabindex="0"
                          role="button"
                          aria-label={`${zr.branch}${zr.animal}（五行${zr.element}）`}
                        >
                          <circle class="zc-node-bg" cx={cx} cy={cy} r="22" />
                          <text class="zc-node-animal" x={cx} y={cy - 2} text-anchor="middle">{zr.animal}</text>
                          <text class="zc-node-branch" x={cx} y={cy + 12} text-anchor="middle">{zr.branch}</text>
                        </g>
                      );
                    })}
                  </g>
                  <g class="zc-center">
                    <text class="zc-center-k" x="210" y="198" text-anchor="middle" data-zc-ck>地支关系</text>
                    <text class="zc-center-t" x="210" y="218" text-anchor="middle" data-zc-ct>午马</text>
                    <text class="zc-center-s" x="210" y="236" text-anchor="middle" data-zc-cs>寅午戌 · 冲鼠</text>
                  </g>
                </svg>
                <div class="z-compass-legend">
                  <span><i class="zc-lg zc-lg--tri" aria-hidden="true" />三合（等边三角）</span>
                  <span><i class="zc-lg zc-lg--opp" aria-hidden="true" />六冲（正对直径）</span>
                  <a class="z-compass-link" data-zc-link href={urlFor('/zodiac/horse/')}>进入「马」档案 →</a>
                </div>
              </div>

              {/* 右：选项卡切换「三合与相冲」/「五行与传统色」，每行可联动罗盘 */}
              <div class="z-inspector">
                <div class="z-insp-tabs" role="tablist" aria-label="切换关系视图">
                  <button type="button" class="z-insp-tab is-active" role="tab" aria-selected="true" data-z-tab="rel">
                    三合与相冲 <span>{ov.sanhe.length + ov.chong.length}</span>
                  </button>
                  <button type="button" class="z-insp-tab" role="tab" aria-selected="false" data-z-tab="elem">
                    五行与传统方位 <span>{ov.elements.length}</span>
                  </button>
                </div>

                <div class="z-insp-pane is-active" data-z-pane="rel">
                  <div class="cal-table-wrap">
                    <table class="cal-table z-sanhe">
                      <thead>
                        <tr>
                          <th scope="col">组合</th>
                          <th scope="col">传统解释</th>
                          <th scope="col" class="z-col-badge">图示</th>
                        </tr>
                      </thead>
                      <tbody>
                        {ov.sanhe.map((sh: any) => (
                          <tr class="z-rel-row" data-rel-kind="sanhe" data-rel-animals={sh.animals.join(',')} data-rel-label={`三合${sh.ju}`} tabindex="0">
                            <th scope="row"><span class="cal-name">{sh.animals.join('')}</span></th>
                            <td>三合，三者合成{sh.ju}，互相增强</td>
                            <td class="z-col-badge"><span class="z-badge z-badge--tri">△ 三合</span></td>
                          </tr>
                        ))}
                        {ov.chong.map((ch: any) => (
                          <tr class="z-rel-row" data-rel-kind="chong" data-rel-animals={ch.join(',')} data-rel-label="六冲正对" tabindex="0">
                            <th scope="row"><span class="cal-name">{ch.join('')}</span></th>
                            <td>六冲，正对相对，传统上是最强的对立</td>
                            <td class="z-col-badge"><span class="z-badge z-badge--opp">↔ 六冲</span></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="z-insp-pane" data-z-pane="elem">
                  <div class="cal-table-wrap">
                    <table class="cal-table z-elements">
                      <thead>
                        <tr>
                          <th scope="col">五行</th>
                          <th scope="col">天干</th>
                          <th scope="col">方位</th>
                          <th scope="col">传统色</th>
                        </tr>
                      </thead>
                      <tbody>
                        {ov.elements.map((el: any) => (
                          <tr class="z-rel-row" data-rel-kind="elem" data-rel-elem={el.element} data-rel-label={`${el.element} · ${el.direction}`} tabindex="0">
                            <th scope="row"><span class="cal-name">{el.element}</span></th>
                            <td>{el.stems}</td>
                            <td>{el.direction}</td>
                            <td><span class={`z-swatch z-swatch--${el.element}`} aria-hidden="true" />{el.color}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <p class="z-note z-v2-note">五行与方位、颜色的对应是传统说法（《黄帝内经》一系），不是命理吉凶；生肖的五行由天干决定，每十年一轮。</p>
                </div>
              </div>
            </div>
          </section>

          <div class="cal-notes">
            <article class="about-body cal-prose">
              <div class="markdown-body">
                <Fragment set:html={ov.prose} />
              </div>
            </article>

            {ov.faq.length > 0 && (
              <aside class="cal-faq">
                <h2 class="col-title">关于生肖的常见问题</h2>
                {ov.faq.map((item: any) => (
                  <details class="cal-faq-item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))}
              </aside>
            )}
          </div>

          <div class="cal-after">
            <p class="cal-note">生肖与干支依据公开历法资料整理，生肖年以农历正月初一为界（GB/T 33661-2017《农历的编算和颁行》）；各生肖年的起止日期与本站节假日页一致。性格与幸运物是民间流传的说法，只作参考。</p>
          </div>
        </>
      )}
    </div>
  </div>

  <script is:inline>
    (function () {
      var sel = document.querySelector('[data-z-year]');
      var res = document.getElementById('z-finder-res');
      var out = document.querySelector('[data-z-out]');
      var go = document.querySelector('[data-z-go]');
      var grid = document.querySelector('[data-z-grid]');
      if (!sel || !res || !out || !go || !grid) return;

      var STEMS = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
      var BRANCHES = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
      var ANIMALS = [
        { k: 'rat', n: '鼠' }, { k: 'ox', n: '牛' }, { k: 'tiger', n: '虎' }, { k: 'rabbit', n: '兔' },
        { k: 'dragon', n: '龙' }, { k: 'snake', n: '蛇' }, { k: 'horse', n: '马' }, { k: 'goat', n: '羊' },
        { k: 'monkey', n: '猴' }, { k: 'rooster', n: '鸡' }, { k: 'dog', n: '狗' }, { k: 'pig', n: '猪' },
      ];
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-z-key]'));

      function showYear(yrStr) {
        var y = parseInt(yrStr, 10);
        if (!y || isNaN(y)) {
          res.hidden = true;
          grid.classList.remove('has-picked');
          cards.forEach(function (c) { c.classList.remove('is-picked'); });
          return;
        }
        var sIdx = ((y - 4) % 10 + 10) % 10;
        var bIdx = ((y - 4) % 12 + 12) % 12;
        var a = ANIMALS[bIdx];
        out.textContent = y + ' 年 · ' + STEMS[sIdx] + BRANCHES[bIdx] + a.n + '年（地支「' + BRANCHES[bIdx] + '」，以春节为界）';
        go.href = '/zodiac/' + a.k + '/';
        go.textContent = '查看「' + a.n + '」属相档案 →';
        res.hidden = false;
        grid.classList.add('has-picked');
        cards.forEach(function (c) {
          c.classList.toggle('is-picked', c.getAttribute('data-z-key') === a.k);
        });
      }

      sel.addEventListener('change', function () { showYear(sel.value); });
      Array.prototype.slice.call(document.querySelectorAll('[data-z-pick]')).forEach(function (btn) {
        btn.addEventListener('click', function () {
          var v = btn.getAttribute('data-z-pick') || '';
          sel.value = v;
          showYear(v);
        });
      });

      // 十二地支交互罗盘 + 五行/三合六冲联动
      var compass = document.querySelector('[data-z-compass]');
      var linesG = document.querySelector('[data-z-lines]');
      if (!compass || !linesG) return;

      var nodes = Array.prototype.slice.call(compass.querySelectorAll('[data-zc-idx]'));
      var ck = compass.querySelector('[data-zc-ck]');
      var ct = compass.querySelector('[data-zc-ct]');
      var cs = compass.querySelector('[data-zc-cs]');
      var linkEl = document.querySelector('[data-zc-link]');
      var rows = Array.prototype.slice.call(document.querySelectorAll('.z-rel-row'));
      var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-z-tab]'));
      var panes = Array.prototype.slice.call(document.querySelectorAll('[data-z-pane]'));

      var pts = nodes.map(function (_, i) {
        var rad = ((-90 + i * 30) * Math.PI) / 180;
        return { x: +(210 + 134 * Math.cos(rad)).toFixed(1), y: +(210 + 134 * Math.sin(rad)).toFixed(1) };
      });
      var byAnimal = {};
      nodes.forEach(function (n, i) { byAnimal[n.getAttribute('data-zc-animal')] = i; });

      function drawPoly(indices, cls, close) {
        if (indices.length < 2) return;
        var d = indices.map(function (idx, k) {
          return (k === 0 ? 'M' : 'L') + pts[idx].x + ' ' + pts[idx].y;
        }).join(' ') + (close ? ' Z' : '');
        var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', d);
        path.setAttribute('class', cls);
        linesG.appendChild(path);
      }

      function clearHighlight() {
        linesG.innerHTML = '';
        nodes.forEach(function (n) { n.classList.remove('is-focus', 'is-tri', 'is-opp', 'is-dim'); });
        rows.forEach(function (r) { r.classList.remove('is-active'); });
      }

      function focusAnimal(idx) {
        clearHighlight();
        var tri = [idx, (idx + 4) % 12, (idx + 8) % 12];
        var opp = (idx + 6) % 12;
        drawPoly(tri, 'zc-path zc-path--tri', true);
        drawPoly([idx, opp], 'zc-path zc-path--opp', false);
        nodes.forEach(function (n, i) {
          if (i === idx) n.classList.add('is-focus');
          else if (tri.indexOf(i) !== -1) n.classList.add('is-tri');
          else if (i === opp) n.classList.add('is-opp');
          else n.classList.add('is-dim');
        });
        var cur = nodes[idx];
        var an = cur.getAttribute('data-zc-animal');
        var br = cur.getAttribute('data-zc-branch');
        var key = cur.getAttribute('data-zc-key');
        var triNames = tri.map(function (i) { return nodes[i].getAttribute('data-zc-animal'); }).join('');
        var oppName = nodes[opp].getAttribute('data-zc-animal');
        if (ck) ck.textContent = '五行' + cur.getAttribute('data-zc-element');
        if (ct) ct.textContent = br + an;
        if (cs) cs.textContent = '三合' + triNames + ' · 冲' + oppName;
        if (linkEl) {
          linkEl.href = '/zodiac/' + key + '/';
          linkEl.textContent = '进入「' + an + '」档案 →';
        }
      }

      function focusRow(row) {
        clearHighlight();
        row.classList.add('is-active');
        var kind = row.getAttribute('data-rel-kind');
        var label = row.getAttribute('data-rel-label') || '';
        if (kind === 'sanhe' || kind === 'chong') {
          var names = (row.getAttribute('data-rel-animals') || '').split(',').filter(Boolean);
          var idxs = names.map(function (a) { return byAnimal[a]; }).filter(function (i) { return i !== undefined; });
          drawPoly(idxs, kind === 'sanhe' ? 'zc-path zc-path--tri' : 'zc-path zc-path--opp', kind === 'sanhe');
          nodes.forEach(function (n, i) {
            if (idxs.indexOf(i) !== -1) n.classList.add(kind === 'sanhe' ? 'is-tri' : 'is-opp');
            else n.classList.add('is-dim');
          });
          if (ck) ck.textContent = kind === 'sanhe' ? '三合局' : '六冲';
          if (ct) ct.textContent = names.join(' · ');
          if (cs) cs.textContent = label;
        } else if (kind === 'elem') {
          var el = row.getAttribute('data-rel-elem') || '';
          var matched = [];
          nodes.forEach(function (n, i) {
            if (n.getAttribute('data-zc-element') === el) {
              n.classList.add('is-focus');
              matched.push(i);
            } else {
              n.classList.add('is-dim');
            }
          });
          if (matched.length >= 2) drawPoly(matched, 'zc-path zc-path--tri', matched.length >= 3);
          if (ck) ck.textContent = '五行对应';
          if (ct) ct.textContent = el;
          if (cs) cs.textContent = label;
        }
      }

      nodes.forEach(function (n, i) {
        n.addEventListener('mouseenter', function () { focusAnimal(i); });
        n.addEventListener('click', function () { focusAnimal(i); });
        n.addEventListener('keydown', function (ev) {
          if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); focusAnimal(i); }
        });
      });

      rows.forEach(function (row) {
        row.addEventListener('mouseenter', function () { focusRow(row); });
        row.addEventListener('click', function () { focusRow(row); });
        row.addEventListener('keydown', function (ev) {
          if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); focusRow(row); }
        });
      });

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var id = tab.getAttribute('data-z-tab');
          tabs.forEach(function (t) {
            var on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panes.forEach(function (p) {
            p.classList.toggle('is-active', p.getAttribute('data-z-pane') === id);
          });
        });
      });

      // 与顶部出生年份速查器联动
      var origShow = showYear;
      showYear = function (yrStr) {
        origShow(yrStr);
        var y = parseInt(yrStr, 10);
        if (y && !isNaN(y)) focusAnimal(((y - 4) % 12 + 12) % 12);
      };

      // 默认高亮 2026 马年（索引 6）
      focusAnimal(6);
    })();
  </script>

  <style is:global>
    .z-v2 .z-v2-head{position:relative;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,0.9fr);align-items:end;gap:clamp(1.6rem,4vw,3.5rem);padding:clamp(1rem,2.6vw,2.2rem) 0 2rem;margin-bottom:2.2rem;border-bottom:1px solid var(--line-color);overflow:clip}
    .z-v2 .z-v2-head>*:not(.ab-watermark){position:relative;z-index:1}
    .z-v2-kicker{margin:0 0 .55rem;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.14em;color:var(--accent)}
    .z-v2 .pg-hd-title{font-family:var(--font-serif-title);font-size:clamp(2.2rem,4.6vw,3.4rem);line-height:1.08;letter-spacing:-0.02em}
    .z-finder{padding:1.05rem 1.2rem;border:1px solid var(--line-color);border-radius:var(--r-sm);background:var(--surface-tint);display:flex;flex-direction:column;gap:.75rem}
    .z-finder-label{margin:0;font-family:var(--font-mono);font-size:.76rem;letter-spacing:.1em;color:var(--accent);font-weight:700}
    .z-finder-ctrl{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem .7rem}
