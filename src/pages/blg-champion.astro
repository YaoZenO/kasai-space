---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'BLG 夺冠：3-1 战胜 Gen.G，队史首冠';
const description = 'BLG 3-1 战胜 Gen.G，赢下 2026 英雄联盟全球总决赛，队史首座召唤师奖杯。LPL自2021年EDG之后，时隔五年再夺世界冠军。Barclays Center, Brooklyn, New York。';
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImages={['/img/games/blg-s16/01-trophy-vcg.jpg']}
  ogKeywords={['BLG', 'Gen.G', '英雄联盟', 'S16', '全球总决赛', 'Knight', '召唤师奖杯']}
  currentPath="/blg-champion/"
>
<style>
  .blg-wrap{
    --blg-bg:#f4f0e6; --blg-bg2:#e9e2cf; --blg-ink:#25212b; --blg-muted:#6f6a5c;
    --blg-card:#fffdf6; --blg-line:#ddd3b8; --blg-gold:#96760f; --blg-gold2:#c9a227;
    --blg-pink:#d6336c; --blg-blue:#2563eb; --blg-red:#dc2626;
    --blg-shadow:0 12px 32px rgba(60,50,20,.10);
    --blg-panel:#141826; --blg-panel2:#0d0f16; --blg-panel-ink:#ece7da; --blg-panel-muted:#9aa0ae;
    background:
      radial-gradient(1100px 420px at 50% -80px, rgba(201,162,39,.16), transparent 70%),
      linear-gradient(180deg, var(--blg-bg), var(--blg-bg2));
    color:var(--blg-ink);
    margin:0 calc(50% - 50vw); width:100vw; max-width:100vw; overflow:hidden;
    font-size:17px; line-height:1.75;
  }
  :global(html[data-user-color-scheme="dark"]) .blg-wrap,
  :global(html[data-sun-scheme="dark"]) .blg-wrap{
    --blg-bg:#131624; --blg-bg2:#0b0d14; --blg-ink:#ece7da; --blg-muted:#9aa0ae;
    --blg-card:#1a1e2b; --blg-line:#2c3247; --blg-gold:#e8c469; --blg-gold2:#f5d98a;
    --blg-pink:#fb7299; --blg-blue:#5b9bff; --blg-red:#ff6b6b;
    --blg-shadow:0 12px 32px rgba(0,0,0,.45);
  }
  @media (prefers-color-scheme: dark){
    :global(html:not([data-user-color-scheme]):not([data-sun-scheme])) .blg-wrap{
      --blg-bg:#131624; --blg-bg2:#0b0d14; --blg-ink:#ece7da; --blg-muted:#9aa0ae;
      --blg-card:#1a1e2b; --blg-line:#2c3247; --blg-gold:#e8c469; --blg-gold2:#f5d98a;
      --blg-pink:#fb7299; --blg-blue:#5b9bff; --blg-red:#ff6b6b;
      --blg-shadow:0 12px 32px rgba(0,0,0,.45);
    }
  }
  .blg-wrap::before{
    content:""; display:block; height:4px;
    background:linear-gradient(90deg, var(--blg-gold2), var(--blg-pink), var(--blg-gold2));
  }
  .blg-wrap img{user-select:none}
  .blg-wrap ::selection{background:var(--blg-gold2); color:#1a1a1a}

  /* ---------- hero ---------- */
  .blg-hero{position:relative; min-height:94vh; display:flex; align-items:flex-end; overflow:hidden; background:#0b0d14}
  .blg-hero-media{position:absolute; inset:0; animation:blgZoom 22s ease-in-out infinite alternate}
  .blg-hero-media img{width:100%; height:100%; object-fit:cover; object-position:center 30%; display:block}
  .blg-hero::after{content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(5,6,10,.42) 0%, rgba(5,6,10,.08) 42%, rgba(5,6,10,.30) 66%, rgba(5,6,10,.88) 100%)}
  .blg-hero-inner{position:relative; z-index:2; width:100%; max-width:1020px; margin:0 auto; padding:0 24px 84px; color:#fff}
  .blg-kicker{font-size:13px; letter-spacing:.34em; text-transform:uppercase; color:#f5d98a; font-weight:700; animation:blgRise .8s .1s ease both}
  .blg-kicker-cn{margin-top:8px; font-size:15px; letter-spacing:.42em; color:rgba(255,255,255,.82); animation:blgRise .8s .22s ease both}
  .blg-title{margin:18px 0 0; font-size:clamp(72px, 13vw, 148px); line-height:1.02; font-weight:900; letter-spacing:-.01em; animation:blgRise .8s .34s ease both}
  .blg-title .gold{
    background:linear-gradient(100deg,#a8842a,#e8c469 28%,#fff3c4 50%,#e8c469 72%,#a8842a);
    background-size:200% 100%; -webkit-background-clip:text; background-clip:text; color:transparent;
    animation:blgShine 7s linear infinite;
  }
  .blg-score{display:inline-flex; align-items:baseline; gap:14px; margin-top:26px; padding:10px 22px;
    border:1px solid rgba(232,196,105,.75); border-radius:999px; background:rgba(8,9,14,.42); backdrop-filter:blur(6px);
    font-size:clamp(20px,3.4vw,30px); font-weight:800; letter-spacing:.06em; animation:blgRise .8s .48s ease both}
  .blg-score .n{color:#f5d98a}
  .blg-score .vs{font-size:.62em; letter-spacing:.3em; color:rgba(255,255,255,.7)}
  .blg-hero-sub{margin:20px 0 0; max-width:640px; font-size:clamp(16px,2.4vw,20px); line-height:1.7; color:rgba(255,255,255,.92); animation:blgRise .8s .6s ease both}
  .blg-hero-meta{margin-top:16px; font-size:14px; letter-spacing:.08em; color:rgba(255,255,255,.72); animation:blgRise .8s .72s ease both}
  .blg-hero-meta b{color:#fff; font-weight:700}
  @keyframes blgZoom{from{transform:scale(1)}to{transform:scale(1.07)}}
  @keyframes blgRise{from{opacity:0; transform:translateY(26px)}to{opacity:1; transform:none}}
  @keyframes blgShine{to{background-position:-200% 0}}

  /* ---------- sections ---------- */
  .blg-section{max-width:960px; margin:0 auto; padding:76px 20px 8px}
  .blg-eyebrow{display:flex; align-items:center; gap:14px; font-size:13px; font-weight:700; letter-spacing:.32em; text-transform:uppercase; color:var(--blg-gold)}
  .blg-eyebrow::after{content:""; height:1px; width:64px; background:var(--blg-gold2)}
  .blg-section h2{margin:14px 0 0; font-size:clamp(30px,5vw,44px); line-height:1.2; font-weight:900; letter-spacing:-.01em}
  .blg-lead{margin:16px 0 0; font-size:18px; color:var(--blg-muted)}
  .blg-lead b{color:var(--blg-ink)}

  .reveal{opacity:0; transform:translateY(20px); transition:opacity .7s ease, transform .7s ease}
  .reveal.in{opacity:1; transform:none}
  .reveal[data-d="1"]{transition-delay:.08s}
  .reveal[data-d="2"]{transition-delay:.16s}
  .reveal[data-d="3"]{transition-delay:.24s}

  /* ---------- lineups ---------- */
  .blg-vs{display:grid; grid-template-columns:1fr auto 1fr; gap:20px; align-items:stretch; margin-top:34px}
  .blg-team{background:var(--blg-card); border:1px solid var(--blg-line); border-radius:16px; padding:24px 22px; box-shadow:var(--blg-shadow); transition:transform .35s ease, box-shadow .35s ease}
  .blg-team:hover{transform:translateY(-4px)}
  .blg-team.blg{border-top:4px solid var(--blg-gold2)}
  .blg-team.gen{border-top:4px solid var(--blg-blue)}
  .blg-team h3{margin:0; font-size:30px; font-weight:900; letter-spacing:.02em; line-height:1.1}
  .blg-team .tag{display:inline-block; margin-top:8px; font-size:12px; letter-spacing:.22em; font-weight:700; color:var(--blg-muted)}
  .blg-roster{margin:18px 0 0; padding:0; list-style:none}
  .blg-roster li{display:flex; align-items:baseline; gap:12px; padding:9px 0; border-top:1px dashed var(--blg-line)}
  .blg-roster li:first-child{border-top:0}
  .blg-role{flex:0 0 44px; font-size:11px; font-weight:700; letter-spacing:.14em; color:var(--blg-muted)}
  .blg-player{font-size:19px; font-weight:800}
  .blg-player small{margin-left:8px; font-size:13px; font-weight:400; color:var(--blg-muted)}
  .blg-vs-badge{align-self:center; width:64px; height:64px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:var(--blg-ink); color:var(--blg-bg); font-weight:900; font-size:20px; letter-spacing:.05em; box-shadow:var(--blg-shadow)}
  .blg-figure{margin:28px 0 0; overflow:hidden; border-radius:16px; box-shadow:var(--blg-shadow)}
  .blg-figure img{display:block; width:100%; transition:transform .6s ease}
  .blg-figure:hover img{transform:scale(1.03)}
  .blg-figure figcaption{padding:12px 16px; font-size:13.5px; color:var(--blg-muted); background:var(--blg-card); border-top:1px solid var(--blg-line)}

  /* ---------- game cards ---------- */
  .blg-cards{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:34px}
  .blg-card{background:var(--blg-card); border:1px solid var(--blg-line); border-radius:14px; padding:20px 18px; box-shadow:var(--blg-shadow); transition:transform .35s ease, border-color .35s ease; position:relative; overflow:hidden}
  .blg-card:hover{transform:translateY(-5px)}
  .blg-card.win{border-top:4px solid var(--blg-gold2)}
  .blg-card.lose{border-top:4px solid var(--blg-muted); opacity:.88}
  .blg-card .g{font-size:12px; font-weight:700; letter-spacing:.26em; color:var(--blg-muted)}
  .blg-card .w{margin-top:10px; font-size:24px; font-weight:900}
  .blg-card .w .l{color:var(--blg-gold)}
  .blg-card .meta{margin-top:6px; font-size:13.5px; color:var(--blg-muted)}
  .blg-card .note{margin-top:12px; font-size:14px; line-height:1.6}

  /* ---------- story ---------- */
  .blg-games{margin-top:34px; display:grid; gap:30px}
  .blg-game h3{margin:0; font-size:22px; font-weight:900}
  .blg-game h3 .tag{margin-left:10px; font-size:12px; font-weight:700; letter-spacing:.2em; color:var(--blg-gold)}
  .blg-game p{margin:10px 0 0; color:var(--blg-ink)}
  .blg-game p b{color:var(--blg-ink)}
  .blg-game .num{font-variant-numeric:tabular-nums; font-weight:700; color:var(--blg-gold)}

  /* ---------- scoreboards ---------- */
  .blg-tabs{display:flex; flex-wrap:wrap; gap:10px; margin-top:30px}
  .blg-tab{appearance:none; border:1px solid var(--blg-line); background:var(--blg-card); color:var(--blg-ink);
    padding:11px 20px; border-radius:999px; font-size:15px; font-weight:700; letter-spacing:.04em; cursor:pointer;
    transition:all .25s ease; box-shadow:var(--blg-shadow)}
  .blg-tab small{margin-left:6px; font-size:12px; font-weight:400; color:var(--blg-muted)}
  .blg-tab:hover{transform:translateY(-2px); border-color:var(--blg-gold2)}
  .blg-tab.active{background:var(--blg-gold2); border-color:var(--blg-gold2); color:#1c1a12}
  .blg-tab.active small{color:rgba(28,26,18,.66)}
  .blg-panel{margin-top:22px; animation:blgFade .45s ease both}
  .blg-panel[hidden]{display:none}
  @keyframes blgFade{from{opacity:0; transform:translateY(10px)}to{opacity:1; transform:none}}
  .blg-sb{background:var(--blg-card); border:1px solid var(--blg-line); border-radius:16px; overflow:hidden; box-shadow:var(--blg-shadow)}
  .blg-sb + .blg-sb{margin-top:16px}
  .blg-sb-head{display:flex; flex-wrap:wrap; align-items:center; gap:12px; padding:16px 20px; border-bottom:1px solid var(--blg-line)}
  .blg-sb-head .side{font-size:11px; font-weight:800; letter-spacing:.18em; padding:4px 10px; border-radius:999px; color:#fff}
  .blg-sb-head .side.blue{background:#2563eb}
  .blg-sb-head .side.red{background:#dc2626}
  .blg-sb-head h3{margin:0; font-size:21px; font-weight:900; letter-spacing:.02em}
  .blg-sb-head .totals{margin-left:auto; font-size:14px; color:var(--blg-muted); font-variant-numeric:tabular-nums}
  .blg-sb-head .totals b{color:var(--blg-ink)}
  .blg-win-badge{font-size:11px; font-weight:800; letter-spacing:.2em; color:#1c1a12; background:var(--blg-gold2); padding:4px 10px; border-radius:999px}
  .blg-sb-rows{padding:6px 20px 10px}
  .blg-sb-row{display:grid; grid-template-columns:44px 1fr auto; gap:14px; align-items:center; padding:10px 0; border-top:1px dashed var(--blg-line)}
  .blg-sb-row:first-child{border-top:0}
  .blg-sb-row img{width:44px; height:44px; border-radius:10px; display:block; box-shadow:0 2px 8px rgba(0,0,0,.25)}
  .blg-sb-who{min-width:0}
  .blg-sb-who .p{font-size:16.5px; font-weight:800; line-height:1.25}
  .blg-sb-who .c{font-size:13px; color:var(--blg-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .blg-sb-stat{text-align:right; font-variant-numeric:tabular-nums}
  .blg-sb-stat .kda{font-size:16.5px; font-weight:800; white-space:nowrap}
  .blg-sb-stat .kda .d{color:var(--blg-muted); font-weight:400}
  .blg-sb-stat .cs{font-size:12.5px; color:var(--blg-muted); white-space:nowrap}
  .blg-bans{display:flex; flex-wrap:wrap; gap:8px; align-items:center; padding:12px 20px 16px; border-top:1px solid var(--blg-line); font-size:13px}
  .blg-bans .lbl{font-size:11px; font-weight:800; letter-spacing:.22em; color:var(--blg-muted); margin-right:2px}
  .blg-ban{display:inline-flex; line-height:0}.blg-ban img{width:32px; height:32px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,.25)}
  .blg-data-note{margin-top:18px; font-size:13.5px; color:var(--blg-muted)}
  .blg-data-note a{color:var(--blg-gold); text-decoration:underline}

  /* ---------- fmvp ---------- */
  .blg-fmvp{margin-top:76px; background:linear-gradient(160deg, var(--blg-panel), var(--blg-panel2)); color:var(--blg-panel-ink); position:relative; overflow:hidden}
  .blg-fmvp::before{content:""; position:absolute; inset:0; background:radial-gradient(640px 300px at 88% 0%, rgba(232,196,105,.20), transparent 70%); pointer-events:none}
  .blg-fmvp-inner{position:relative; max-width:960px; margin:0 auto; padding:72px 20px}
  .blg-fmvp .blg-eyebrow{color:#f5d98a}
  .blg-fmvp-name{margin:12px 0 0; font-size:clamp(56px,10vw,104px); line-height:1; font-weight:900; letter-spacing:.01em;
    background:linear-gradient(100deg,#a8842a,#e8c469 30%,#fff3c4 50%,#e8c469 70%,#a8842a); background-size:200% 100%;
    -webkit-background-clip:text; background-clip:text; color:transparent; animation:blgShine 8s linear infinite}
  .blg-fmvp-role{margin-top:10px; font-size:15px; letter-spacing:.3em; text-transform:uppercase; color:rgba(236,231,218,.75)}
  .blg-stats{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:34px}
  .blg-stat{border:1px solid rgba(232,196,105,.28); border-radius:14px; padding:20px 16px; background:rgba(255,255,255,.03); transition:transform .35s ease, border-color .35s ease}
  .blg-stat:hover{transform:translateY(-4px); border-color:rgba(232,196,105,.6)}
  .blg-stat .v{font-size:clamp(26px,4.4vw,38px); font-weight:900; color:#f5d98a; font-variant-numeric:tabular-nums; line-height:1.1}
  .blg-stat .l{margin-top:8px; font-size:13px; line-height:1.5; color:rgba(236,231,218,.72)}
  .blg-fmvp-facts{margin:28px 0 0; padding:0; list-style:none; display:grid; gap:10px; font-size:16px; color:rgba(236,231,218,.88)}
  .blg-fmvp-facts li{padding-left:22px; position:relative}
  .blg-fmvp-facts li::before{content:""; position:absolute; left:0; top:.62em; width:8px; height:8px; border-radius:50%; background:#e8c469}
  .blg-quote{margin:30px 0 0; padding:22px 26px; border-left:3px solid #e8c469; background:rgba(232,196,105,.07); border-radius:0 14px 14px 0; font-size:clamp(18px,2.8vw,23px); line-height:1.6; font-weight:700}
  .blg-quote small{display:block; margin-top:10px; font-size:13px; font-weight:400; color:rgba(236,231,218,.6)}
  .blg-fmvp .blg-figure figcaption{background:#1a1e2b; color:#9aa0ae; border-top:1px solid #2c3247}

  /* ---------- road ---------- */
  .blg-road{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:34px}
  .blg-step{background:var(--blg-card); border:1px solid var(--blg-line); border-radius:14px; padding:22px 18px; box-shadow:var(--blg-shadow); transition:transform .35s ease; position:relative}
  .blg-step:hover{transform:translateY(-5px)}
  .blg-step .round{font-size:12px; font-weight:700; letter-spacing:.24em; color:var(--blg-muted); text-transform:uppercase}
  .blg-step .opp{margin-top:10px; font-size:21px; font-weight:900; line-height:1.25}
  .blg-step .sc{margin-top:6px; font-size:15px; font-weight:700; color:var(--blg-gold)}
  .blg-step.final{border-color:var(--blg-gold2); background:linear-gradient(160deg, var(--blg-card), var(--blg-card))}
  .blg-road-note{margin-top:22px; font-size:16px; color:var(--blg-muted)}
  .blg-road-note .en{display:block; margin-top:6px; font-style:italic; color:var(--blg-ink); font-size:17px}

  /* ---------- atmosphere ---------- */
  .blg-duo{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:34px}
  .blg-duo .blg-figure{margin:0}

  /* ---------- finale ---------- */
  .blg-finale{position:relative; margin-top:76px; min-height:88vh; display:flex; align-items:center; justify-content:center; text-align:center; overflow:hidden; background:#0b0d14}
  .blg-finale-media{position:absolute; inset:0; animation:blgZoom 24s ease-in-out infinite alternate}
  .blg-finale-media img{width:100%; height:100%; object-fit:cover; object-position:center 42%; display:block}
  .blg-finale::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(5,6,10,.55), rgba(5,6,10,.28) 45%, rgba(5,6,10,.82))}
  .blg-finale-inner{position:relative; z-index:2; padding:40px 24px; color:#fff; max-width:820px}
  .blg-finale-inner .rule{width:72px; height:3px; background:#e8c469; margin:0 auto 26px}
  .blg-finale-inner h2{margin:0; font-size:clamp(34px,6.4vw,58px); line-height:1.25; font-weight:900; text-shadow:0 2px 24px rgba(0,0,0,.45)}
  .blg-finale-inner p{margin:20px 0 0; font-size:clamp(16px,2.6vw,20px); color:rgba(255,255,255,.88)}
  .blg-finale-inner .en{margin-top:14px; font-size:13px; letter-spacing:.34em; text-transform:uppercase; color:#f5d98a}

  .blg-credits{max-width:960px; margin:0 auto; padding:36px 20px 64px; font-size:13.5px; line-height:1.8; color:var(--blg-muted)}
  .blg-credits a{color:var(--blg-gold); text-decoration:underline}

  @media (max-width: 860px){
    .blg-cards{grid-template-columns:repeat(2,1fr)}
    .blg-stats{grid-template-columns:repeat(2,1fr)}
    .blg-road{grid-template-columns:repeat(2,1fr)}
    .blg-vs{grid-template-columns:1fr}
    .blg-vs-badge{justify-self:center; width:54px; height:54px; font-size:17px}
  }
  @media (max-width: 560px){
    .blg-section{padding-top:60px}
    .blg-cards{grid-template-columns:1fr}
    .blg-duo{grid-template-columns:1fr}
    .blg-hero{min-height:92vh}
    .blg-hero-media img{object-position:center 28%}
    .blg-sb-row{grid-template-columns:38px 1fr auto; gap:10px}
    .blg-sb-row img{width:38px; height:38px}
    .blg-sb-head .totals{margin-left:0; width:100%}
  }
  @media (prefers-reduced-motion: reduce){
    .blg-hero-media, .blg-finale-media, .blg-title .gold, .blg-fmvp-name,
    .blg-kicker, .blg-kicker-cn, .blg-title, .blg-score, .blg-hero-sub, .blg-hero-meta{animation:none !important}
    .reveal{opacity:1; transform:none; transition:none}
    .blg-panel{animation:none}
    .blg-figure img, .blg-team, .blg-card, .blg-step, .blg-stat, .blg-tab{transition:none}
  }
  .blg-wrap p.blg-kicker, .blg-wrap p.blg-kicker-cn, .blg-wrap p.blg-eyebrow, .blg-wrap p.blg-hero-meta{margin:0}
  .blg-wrap p.blg-kicker-cn{margin-top:8px}
  .blg-wrap p.blg-hero-meta{margin-top:16px}
  .blg-wrap .blg-card p, .blg-wrap .blg-step p{margin:0}
  .blg-wrap .blg-card p.w{margin-top:10px}
  .blg-wrap .blg-card p.meta{margin-top:6px}
  .blg-wrap .blg-card p.note{margin-top:12px}
  .blg-wrap .blg-step p.opp{margin-top:10px}
  .blg-wrap .blg-step p.sc{margin-top:6px}
  .blg-credits p{margin:0 0 6px}
  .blg-credits .blg-back{margin-top:18px}
</style>
<noscript><style>.blg-wrap .reveal{opacity:1 !important; transform:none !important}</style></noscript>

<div class="blg-wrap">

  <!-- HERO -->
  <header class="blg-hero">
    <picture class="blg-hero-media">
      <source media="(max-width: 720px)" srcset="/img/games/blg-s16/hero-mobile.jpg" />
