---
// 车牌字母编号探索页（/plates/）：Issue #12 的落地，2026-11-26 第三轮重做。
//
// 这一轮的改动由主人 2026-11-26 的反馈直接驱动：
//   1. 「只趣味不解释」——冷知识必须交代原因，于是故事区每条都带时间、原因、出处；
//   2. 「数据不及时更新」——2018 年标准之后的代号增减（郑州豫 V、苏州苏 U、西安陕 U、
//      成都川 G、武汉鄂 W、莱芜并入济南）单列「字母还在变」，并同步进字母带与对照表；
//   3. 「设计和排版烂」——去掉卡片网格与一堆边框，改成零边框编辑式长文：
//      大标题、发丝线分节、大号等宽字母，让内容自己说话。
//
// 数据：source/_data/plates.yml；派生：src/lib/plates-data.ts。
// 交互（signature）：省份选择 → A–Z 字母带切换；关闭 JS 时首屏为直辖市面板，内容不丢。

import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getData } from '../../lib/data';
import { buildPlates } from '../../lib/plates-data';
import { fmtItemDate } from '../../lib/dates';
import { pageDates } from '../../lib/page-meta';

const ov = buildPlates(getData().plates);
const { published, modified } = pageDates('plates/index.md');

const kindCn: Record<string, string> = {
  municipality: '直辖市',
  province: '省',
  'autonomous-region': '自治区'
};

const multiml = ov ? ov.anomalies.doubleLetterPlaces.length + ov.anomalies.tripleLetterPlaces.length : 0;
const cityAllocCount = ov ? ov.stats.allocationCount - ov.stats.municipalityCount * 26 : 0;
---

<BaseLayout
  title="车牌字母编号探索"
  description={ov ? ov.meta.lede : ''}
  currentPath="/plates/"
  ogDate={published}
  ogUpdated={modified}
>
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>
  <div class="paper-page cal-page plt-page">
    <div class="home-wrap ab-page-shell plt-v3">
      {!ov ? (
        <>
          <header class="page-head">
            <p class="page-head-kicker">PLATES</p>
            <h1 class="page-head-title">车牌字母编号探索</h1>
          </header>
          <EmptyState>车牌编号内容还在整理中，页面会随数据录入自动生成，欢迎稍后再来看看。</EmptyState>
        </>
      ) : (
        <>
          <!-- ============ 页头 ============ -->
          <header class="page-head plt-head">
            <p class="ab-watermark" data-ab-parallax="0.16" aria-hidden="true">PLATES</p>
            <nav class="cal-crumb" aria-label="面包屑">
              <a href="/library/">资料库</a><span aria-hidden="true">/</span><span class="cal-crumb-now">车牌字母编号</span>
            </nav>
            <p class="page-head-kicker">PLATES · 车牌字母</p>
            <h1 class="page-head-title">车牌字母编号探索</h1>
            <p class="plt-lede">{ov.meta.lede}</p>
            <p class="plt-meta-line">
              <span>{ov.stats.regionCount} 个省级行政区</span>
              <span>{cityAllocCount} 条地市代号</span>
              <span>{ov.stats.post2018Count} 条 2018 年后新增</span>
              <span>{multiml} 座一城多牌城市</span>
            </p>
          </header>

          <!-- ============ 01 · 怎么读 ============ -->
          <section class="plt-sec plt-read" aria-labelledby="plt-h-read">
            <h2 class="plt-h2" id="plt-h-read"><span class="plt-h2-no">01</span>先弄清那个字母是什么</h2>
            <div class="plt-plate-box">
              <div class="plt-plate" aria-hidden="true">
                <span class="plt-plate-char">豫</span>
                <span class="plt-plate-char plt-plate-key">A</span>
                <span class="plt-plate-sep">·</span>
                <span class="plt-plate-num">12345</span>
              </div>
              <dl class="plt-legend">
                <div><dt>豫</dt><dd>省级行政区简称</dd></div>
                <div><dt>A</dt><dd>发牌机关代号，决定在哪座城市登记</dd></div>
                <div><dt>12345</dt><dd>序号，不使用字母 I、O</dd></div>
              </dl>
            </div>
            <p class="plt-p">
              路上看到的每一块车牌，第二位那个英文字母都叫「发牌机关代号」。它不是随机的：同一个省的字母先分给谁、后分给谁，有固定的规则，也有不少中途变动留下的痕迹。这一页说的就是这些痕迹。
            </p>
          </section>

          <!-- ============ 02 · 排序规则 ============ -->
          <section class="plt-sec plt-rule" aria-labelledby="plt-h-rule">
            <h2 class="plt-h2" id="plt-h-rule"><span class="plt-h2-no">02</span>字母不是按城市大小排的</h2>
            <p class="plt-p">
              规则只有两条：省会（首府）固定占 A；其余设区的市，报经公安部交通管理局批准后，按报批启用的先后依次分配 B、C、D……所以字母的先后跟城市大小、经济、人口都没有直接关系，跟行政区划变动的先后倒常常对得上。
            </p>
            <div class="plt-cases">
              <div class="plt-case">
                <span class="plt-case-code">豫 B</span>
                <p class="plt-case-text"><b>开封</b>排到 B，是因为它曾经是河南省会。1954 年省会由开封迁往郑州，郑州拿到豫 A，开封保留豫 B。</p>
              </div>
              <div class="plt-case">
                <span class="plt-case-code">川 B</span>
                <p class="plt-case-text"><b>绵阳</b>排到 B，是因为 1997 年重庆直辖、带走了川 B。原属绵阳的川 G 由此闲置，绵阳接替使用川 B。</p>
              </div>
            </div>
            <p class="plt-p plt-p-note">
              换句话说，那些看起来「不合理」的字母顺序，多数不是国家排错了，而是城市本身变过——撤市、设区、直辖、省会搬迁，都会在车牌上留下痕迹。
            </p>
          </section>

          <!-- ============ 03 · 故事 ============ -->
          <section class="plt-sec plt-stories" aria-labelledby="plt-h-stories">
            <h2 class="plt-h2" id="plt-h-stories"><span class="plt-h2-no">03</span>几个字母背后的故事</h2>
            <div class="plt-story-list">
              {ov.stories.map((s, i) => (
                <article class="plt-story">
                  <span class="plt-story-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <div class="plt-story-main">
                    <div class="plt-story-head">
                      <span class="plt-story-badge">{s.badge}</span>
                      <h3 class="plt-story-title">{s.title}</h3>
                    </div>
                    <p class="plt-story-body">{s.body}</p>
                    <p class="plt-story-src">{s.source}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- ============ 04 · 字母还在变 ============ -->
          <section class="plt-sec plt-updates" aria-labelledby="plt-h-updates">
            <h2 class="plt-h2" id="plt-h-updates"><span class="plt-h2-no">04</span>字母还在变：2018 年以后</h2>
            <p class="plt-p">
              GA 36-2018 是 2018 年 5 月实施的标准，之后又发生了这些变化。所以只看 2018 年的表，会以为郑州只有豫 A、苏州只有苏 E——实际上它们早就不止一块牌了。
            </p>
            <div class="cal-table-wrap">
              <table class="cal-table plt-upd-table">
                <thead>
                  <tr>
                    <th scope="col">时间</th>
                    <th scope="col">地点</th>
                    <th scope="col">变化</th>
                    <th scope="col">为什么</th>
                  </tr>
                </thead>
                <tbody>
                  {ov.updates.map((u) => (
                    <tr>
                      <td class="plt-upd-date">{u.date}</td>
                      <td class="plt-upd-place">{u.place}</td>
                      <td class="plt-upd-change">{u.change}</td>
                      <td class="plt-upd-reason">{u.reason}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <!-- ============ 05 · 按省查字母 ============ -->
          <section class="plt-sec plt-index" id="plt-stage" aria-labelledby="plt-h-index">
            <h2 class="plt-h2" id="plt-h-index"><span class="plt-h2-no">05</span>按省查字母</h2>
            <p class="plt-p">
              选一个省级行政区，看它的 A–Z 字母带。实心格是已分配的城市，虚线格是标准里的空缺，标「通用」的是 I、O 这类不发给普通地市的位置。
            </p>
            <div class="plt-selector" role="tablist" aria-label="选择省级行政区">
              {ov.regions.map((r, i) => (
                <button
                  type="button"
                  class={`plt-tab${i === 0 ? ' is-active' : ''}`}
                  role="tab"
                  id={`plt-tab-${r.key}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`plt-band-${r.key}`}
                  data-region={r.key}
                >{r.name}</button>
              ))}
            </div>

            {ov.regions.map((r, i) => {
              const isFull = r.codesFull;
              return (
                <div
                  class={`plt-band-panel${i === 0 ? ' is-active' : ''}`}
                  id={`plt-band-${r.key}`}
                  role="tabpanel"
                  aria-labelledby={`plt-tab-${r.key}`}
                  data-region-panel={r.key}
                  hidden={i !== 0}
                >
                  <div class="plt-band-meta">
                    <span class="plt-band-name">{r.name}</span>
                    <span class="plt-band-kind">{kindCn[r.kind]}</span>
                    {isFull && <span class="plt-band-tag">标准允许 A 至 Z</span>}
                    {!isFull && r.gaps.length > 0 && (
                      <span class="plt-band-tag">空缺 {r.gaps.join(' ')}</span>
                    )}
                  </div>
                  <ol class="plt-band" aria-label={`${r.name} 的 A 至 Z 发牌机关代号`}>
                    {r.band.map((cell) => {
                      const cls = `plt-cell plt-cell--${cell.state}`;
                      const label = isFull
                        ? cell.letter
                        : cell.state === 'used'
                          ? `${cell.letter} ${cell.places.join('、')}`
                          : cell.state === 'empty'
                            ? `${cell.letter}（空缺）`
                            : `${cell.letter}（通用特殊位）`;
                      return (
                        <li class={cls} title={label}>
                          <span class="plt-cell-letter">{cell.letter}</span>
                          {cell.state === 'used' && !isFull && cell.places.length > 0 && (
                            <span class="plt-cell-place">{cell.places.join('、')}</span>
                          )}
                          {cell.state === 'empty' && <span class="plt-cell-empty">空缺</span>}
                          {cell.state === 'special' && <span class="plt-cell-empty">通用</span>}
                        </li>
                      );
                    })}
                  </ol>
                </div>
              );
            })}
          </section>

          <!-- ============ 完整对照表（折叠） ============ -->
          <details class="plt-appendix">
            <summary>各省发牌机关代号完整对照表（{ov.stats.regionCount - ov.stats.municipalityCount} 个省、自治区）</summary>
            <p class="plt-appendix-lead">
              以 GA 36-2018 附录 A 表 A.1 为底，2018 年后新增的代号排在对应省份末尾并标注年份。同一城市多个代号、同一代号多地的情形按数据原样保留。
            </p>
            {ov.regions.filter((r) => !r.codesFull).map((r) => (
              <div class="plt-region-block" id={`plt-region-${r.key}`}>
                <h3 class="plt-region-title"><span class="plt-region-abbr">{r.abbr}</span>{r.name}</h3>
                <div class="cal-table-wrap">
                  <table class="cal-table plt-table">
                    <thead>
                      <tr>
                        <th scope="col">代号</th>
                        <th scope="col">登记机关</th>
                      </tr>
                    </thead>
                    <tbody>
                      {r.allocations.map((a) => (
                        <tr>
                          <th scope="row" class="plt-code">{a.code}</th>
                          <td>
                            {a.place}
                            {a.since && <span class="plt-since">{a.since.slice(0, 4)} 年新增</span>}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </details>

          <div class="cal-after">
            <p class="cal-note">
              本页以 {ov.meta.standard} 附录 A 表 A.1 为基准（{ov.meta.standardScope}），并补充 2018 年后已公开的代号变化。港澳台实行不同的号牌制度，不在本表范围内。更新于 {fmtItemDate(ov.meta.updated)}。
            </p>
          </div>
        </>
      )}
    </div>
  </div>
</BaseLayout>

<script src="/js/plates.js" defer></script>
