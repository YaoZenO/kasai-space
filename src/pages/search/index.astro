---
// 搜索页（/search/）：零边框全站检索台（2026-11-26 重构）。
// 复用底层动态经纬画布 #ab-bg-canvas，去掉方框输入框与灰色胶囊，
// 改用巨号底线检索行 + 一键快捷热词 + 细线类型索引 + 键盘 ↑/↓/Enter 直选。
import BaseLayout from '../../layouts/BaseLayout.astro';

const QUICK_TERMS = ['深圳', '龙', '中秋', '2026', 'Ties', 'BLG'];
---
<BaseLayout title="搜索" currentPath="/search/">
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>

  <div class="paper-page ab-page-shell sr-page">
    <div class="home-wrap sr-wrap">
      <header class="pg-hd sr-hero">
        <p class="ab-watermark" data-ab-parallax="0.16" aria-hidden="true">INDEX</p>
        <p class="ab-kicker ab-reveal" style="--ab-d: 0ms;">
          <span>SITE INDEX</span>
          <span class="ab-kicker-sep" aria-hidden="true">/</span>
          <span>PINYIN SUPPORTED</span>
        </p>
        <h1 class="pg-hd-title sr-title">搜索</h1>
        <p class="sr-lede">文章、项目、游戏、收藏，以及 350 城、榜单、生肖与历法资料。</p>
      </header>

      <div class="sr-box">
        <label class="sr-label" for="sr-input">输入关键词或拼音</label>
        <div class="sr-input-wrap">
          <input
            id="sr-input"
            class="sr-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            aria-describedby="sr-hint"
            placeholder="城市名、生肖、节日、年份，或文章标题…"
          />
          <span class="sr-input-line" aria-hidden="true" />
        </div>

        <div class="sr-quick-bar" id="sr-hint">
          <span class="sr-quick-label">试试：</span>
          {QUICK_TERMS.map((term) => (
            <button type="button" class="sr-quick-btn" data-sr-quick={term}>{term}</button>
          ))}
          <span class="sr-quick-tip">支持拼音（如 <code>shenzhen</code>）· <code>↑↓</code> 选择</span>
        </div>
      </div>

      <div class="sr-chips" id="sr-chips" role="group" aria-label="按类型筛选">
        <button class="sr-chip is-active" type="button" data-cat="all" aria-pressed="true">全部</button>
        <button class="sr-chip" type="button" data-cat="post" aria-pressed="false">文章</button>
        <button class="sr-chip" type="button" data-cat="project" aria-pressed="false">项目</button>
        <button class="sr-chip" type="button" data-cat="game" aria-pressed="false">游戏</button>
        <button class="sr-chip" type="button" data-cat="collection" aria-pressed="false">收藏</button>
        <button class="sr-chip" type="button" data-cat="city" aria-pressed="false">城市</button>
        <button class="sr-chip" type="button" data-cat="rank" aria-pressed="false">榜单</button>
        <button class="sr-chip" type="button" data-cat="zodiac" aria-pressed="false">生肖</button>
        <button class="sr-chip" type="button" data-cat="festival" aria-pressed="false">节日</button>
        <button class="sr-chip" type="button" data-cat="holiday" aria-pressed="false">节假日</button>
        <button class="sr-chip" type="button" data-cat="topic" aria-pressed="false">资料库</button>
      </div>

      <p class="sr-meta" id="sr-meta" hidden></p>

      <div class="sr-list" id="sr-list" aria-live="polite"></div>

      <div class="sr-empty" id="sr-empty" hidden>
        <p class="sr-empty-title">没有找到匹配的内容</p>
        <p class="sr-empty-note">可以试试点上面的快捷词，或换城市名、生肖、节日、年份与文章标题关键词。</p>
      </div>
    </div>
  </div>

  <script src="/js/site-search.js" defer></script>
</BaseLayout>
