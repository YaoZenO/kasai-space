---
// 资料库页（/library/）：专题书架。
//
// 2026-11-04 改为「专题卡片墙」（PLAN-V3 §5）：旧版把五个专题的全部条目平铺成
// 28 行目录，读者要找一个城市得先知道它属于哪个榜。现在这里只回答一个问题
// ——「站上有哪几类资料」，每一类点进去有自己的列表页。
//
// 2026-11-14 按 PAGE-FORM-PLAN §4.4 改为「封面书架」：首屏先给结论与数字带，
// 其下每张专题卡以封面为主导。
//
// 2026-11-14 封面改「图形化」（主人在 A/B/C 三版效果图里选 A）：
// 照片封面总会用单个对象代表一类内容——一张马俑代表十二生肖、一张中秋餐桌代表
// 十二个节日、一张北京天际线代表 431 座城市，都不成立。现在封面改用专题自身的
// 信息图形，全部由数据现算，不再引用图片、不需要授权署名：
//   生肖 = 12 格生肖名＋地支；节假日 = 16 个数据年份；节日 = 12 个节日名；
//   榜单 = 主榜前 8 名条形（与 /cityrank/ 同一口径）；城市 = 字段覆盖表。
//
// 2026-11-14（主人反馈）：城市封面原来铺 431 个点，「看不出来是啥」，改为字段覆盖表——
// 每行一个字段名，右侧是 431 座城市里已收录该字段的座数，一眼看出档案里有什么。

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getData } from '../../lib/data';
import { buildCityRanks } from '../../lib/cityrank-data';
import { buildOverview } from '../../lib/zodiac-data';
import { fmtItemDate } from '../../lib/dates';
import { urlFor } from '../../lib/url';
import { pageDates } from '../../lib/page-meta';

const data = getData();
const { published, modified } = pageDates('library/index.md');
const lb = data.library || {};
const topics: any[] = Array.isArray(lb.topics) ? lb.topics : [];
const meta = lb.meta || {};

/* 每个专题的「真实内容量」。数字一律从数据现算，不写死——城市从 431 涨到 500、
   榜单从 145 变 150 时，这里一个字都不用改。cityrank 走 helper 现算
   （榜数与名次都不落盘，CITY-RANK-PRD §5.1）。新增专题若不在这张表里，
   退回用它在 library.yml 的 entries 条数。 */
let crCache: any = null;
let zodiacCache: any = null;

function countOf(key: string, entries: any): number {
  if (key === 'zodiac') return (data.zodiac?.animals || []).length;
  if (key === 'holidays') return (data.holidays?.years || []).length;
  if (key === 'festivals') return (data.festivals?.festivals || []).length;
  if (key === 'city') return (data.cities?.cities || []).length;
  if (key === 'cityrank') {
    if (!crCache) crCache = buildCityRanks(data);
    return crCache && !crCache.error ? crCache.rankCount : 0;
  }
  return (entries || []).length;
}

const UNITS: Record<string, string> = { zodiac: '个生肖', holidays: '年', festivals: '个节日', cityrank: '个榜单', city: '座城市' };
function unitOf(key: string): string { return UNITS[key] || '条'; }

/* 卡片右下角的「覆盖范围」：只写数据里查得到的事实，不写「最近更新」——
   library.yml 的 meta.updated 是整页维护时间，各专题的数据文件另有自己的日期，
   混用会把「上次改页面」当成「上次改内容」。 */
function rangeOf(key: string): string {
  if (key === 'zodiac') {
    if (!zodiacCache) zodiacCache = buildOverview(data.zodiac);
    return zodiacCache ? `本轮 ${zodiacCache.cycle.from}–${zodiacCache.cycle.to}` : '';
  }
  if (key === 'holidays') {
    const years = (data.holidays?.years || []).map((y: any) => Number(y.year)).filter((y: number) => y > 0);
    return years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';
  }
  if (key === 'festivals') {
    const all: any[] = data.festivals?.festivals || [];
    const legal = all.filter((f: any) => f && f.kind === 'legal').length;
    return all.length ? `法定 ${legal} · 传统 ${all.length - legal}` : '';
  }
  if (key === 'cityrank' || key === 'city') {
    if (!crCache) crCache = buildCityRanks(data);
    const y = crCache && !crCache.error ? crCache.cityMeta?.dataYear : '';
    return y ? `数据年份 ${y}` : '';
  }
  return '';
}

// 首屏数字带：专题数与五个专题各自的内容量，全部现算
const stats = topics.length === 0 ? [] : [
  { label: '专题', value: topics.length },
  { label: '生肖', value: countOf('zodiac', []) },
  { label: '节假日', value: countOf('holidays', []) },
  { label: '节日', value: countOf('festivals', []) },
  { label: '榜单', value: countOf('cityrank', []) },
  { label: '城市档案', value: countOf('city', []) },
];

/* ---- 图形化封面的数据 ---- */

// 生肖：12 格生肖名＋地支，地支按生肖序固定对应
const BRANCHES = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
const zodiacCells = (data.zodiac?.animals || []).map((a: any, i: number) => ({
  name: a.animal, branch: BRANCHES[i] || ''
}));

// 节假日：16 个数据年份，当前年高亮
const nowYear = new Date().getFullYear();
const holidayYears = (data.holidays?.years || []).map((y: any) => Number(y.year));

// 节日：12 个节日名，法定节日加重
const festivalCells = (data.festivals?.festivals || []).map((f: any) => ({
  name: f.name, legal: f.kind === 'legal'
}));

// 榜单：主榜（经济强市）前 8 名，条长按该榜第一名等比，与 /cityrank/ 同一口径
function mainMetric(rk: any) {
  if (!Array.isArray(rk?.metrics) || !rk.metrics.length) return null;
  return rk.metrics.slice().sort((a: any, b: any) => (b.weight || 0) - (a.weight || 0))[0];
}
const allRanks: any[] = [];
if (!crCache) crCache = buildCityRanks(data);
if (crCache && !crCache.error) for (const g of crCache.groups || []) for (const r of g.ranks) allRanks.push(r);
const heroRank =
  allRanks.find((r) => r.slug === 'jingji-qiangshi' && r.kind === 'computed' && r.items.length) ||
  allRanks.find((r) => r.kind === 'computed' && r.items.length) || null;
const heroMetric = heroRank ? mainMetric(heroRank) : null;
const rankBars = (() => {
  if (!heroRank || !heroMetric) return [];
  const items = heroRank.items.slice(0, 8);
  const max = items[0]?.values?.[heroMetric.field] || 0;
  return items.map((it: any) => {
    const v = it.values ? it.values[heroMetric.field] : null;
    return {
      rank: it.rank,
      name: it.name,
      width: typeof v === 'number' && max > 0 ? Math.max(2, Math.round((v / max) * 1000) / 10) : 0
    };
  });
})();

// 城市：字段覆盖。名目与 /city/<slug>/ 档案页同一批字段，只数「有值」的城市
// （指标必须是 { v, unit, asOf, source } 四元组且 v 为数值，缺一即视为待补），
// 与档案页「查不到就写待补、不填估算值」的口径一致。
const CITY_FIELDS = [
  { field: 'gdp', label: '地区生产总值' },
  { field: 'area_km2', label: '行政面积' },
  { field: 'express_handle', label: '快递处理量' },
  { field: 'metro_km', label: '轨道交通' },
  { field: 'pop', label: '常住人口' },
  { field: 'temp_jan', label: '气候数据' },
];
const cityList: any[] = data.cities?.cities || [];
const cityFieldRows = CITY_FIELDS.map((f) => ({
  label: f.label,
  count: cityList.filter((c: any) => {
    const m = c?.metrics?.[f.field];
    return m && typeof m === 'object' && typeof m.v === 'number' && isFinite(m.v);
  }).length
})).filter((f) => f.count > 0);
---

<BaseLayout title="资料库" currentPath="/library/" ogDate={published} ogUpdated={modified}>
  {topics.length === 0 ? (
    <div class="paper-page cal-page lb-page">
      <div class="home-wrap">
        <header class="page-head">
          <p class="page-head-kicker">LIBRARY</p>
          <h1 class="page-head-title">资料库</h1>
        </header>
        <p class="post-desc">资料库的专题还在整理中，上线后即可阅读，欢迎稍后再来看看。</p>
      </div>
    </div>
  ) : (
    <div class="paper-page cal-page lb-page">
      <div class="home-wrap">
        <section class="lb-hero">
          <h1 class="lb-title">资料库</h1>
          <p class="lb-lede"><Fragment set:html={meta.intro || ''} /></p>
          <dl class="lb-stats">
            {stats.map((st: any) => (
              <div class="lb-stat"><dt>{st.label}</dt><dd>{st.value}</dd></div>
            ))}
          </dl>
        </section>

        <section class="lb-shelf-block">
          <div class="col-head">
            <h2 class="col-title">全部专题</h2>
            <span class="col-count">/ {topics.length}</span>
          </div>
          <div class="lb-shelf">
            {topics.map((tp: any) => {
              const n = countOf(tp.key, tp.entries);
              const range = rangeOf(tp.key);
              return (
                <a class="lb-shelf-card" href={urlFor(tp.link || '/library/')}>
                  {/* 封面是装饰性信息图形，内容与标题、计数重复，读屏不必再念一遍 */}
                  <span class={`lb-shelf-cover lb-cover lb-cover-${tp.key}`} aria-hidden="true">
                    {tp.key === 'zodiac' && (
                      <span class="lb-cover-grid lb-cols-4">
                        {zodiacCells.map((c: any) => (
                          <span class="lb-cell"><b>{c.name}</b><i>{c.branch}</i></span>
                        ))}
                      </span>
                    )}
                    {tp.key === 'holidays' && (
                      <span class="lb-cover-grid lb-cols-4">
                        {holidayYears.map((y: number) => (
                          <span class={`lb-cell lb-cell-year${y === nowYear ? ' is-now' : ''}`}><b>{y}</b></span>
                        ))}
                      </span>
                    )}
                    {tp.key === 'festivals' && (
                      <span class="lb-cover-grid lb-cols-3">
                        {festivalCells.map((f: any) => (
                          <span class={`lb-cell lb-cell-fest${f.legal ? ' is-legal' : ''}`}><b>{f.name}</b></span>
                        ))}
                      </span>
                    )}
                    {tp.key === 'cityrank' && (
                      <span class="lb-cover-bars">
                        {rankBars.map((b: any) => (
                          <span class="lb-bar-row">
                            <em>{String(b.rank).padStart(2, '0')}</em>
                            <u>{b.name}</u>
                            <span class="lb-bar" style={`width:${b.width}%`} />
                          </span>
                        ))}
                      </span>
                    )}
                    {tp.key === 'city' && (
                      <span class="lb-cover-fields">
                        {cityFieldRows.map((f: any) => (
                          <span class="lb-field-row">
                            <em>{f.label}</em>
                            <span class="lb-field-rule" />
                            <b>{f.count}</b>
                          </span>
                        ))}
                        <span class="lb-field-note">{cityList.length} 座城市中已收录的座数</span>
                      </span>
                    )}
                  </span>
                  <span class="lb-shelf-body">
                    <span class="lb-shelf-title">{tp.title}</span>
                    <span class="lb-shelf-desc">{tp.desc || ''}</span>
                    <span class="lb-shelf-foot">
                      <span class="lb-shelf-count">{n} <span class="lb-shelf-unit">{unitOf(tp.key)}</span></span>
                      {range && <span class="lb-shelf-range">{range}</span>}
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>

        <div class="cal-after">
          <p class="cal-note">资料库收录本站整理的专题系列；各专题页面内的日期与历法数据依据公开资料，民俗与说法部分已注明口径。更新于 {fmtItemDate(meta.updated)}。</p>
        </div>
      </div>
    </div>
  )}
</BaseLayout>
