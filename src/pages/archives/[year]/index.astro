---
// 年份页（/archives/<year>/）：名称 + N 篇 + 跨度，列表语言与索引页一致。
import ArchiveView from '../../../components/ArchiveView.astro';
import { getArchives } from '../../../lib/posts';

export function getStaticPaths() {
  return getArchives().map(bucket => ({
    params: { year: bucket.year },
    props: { year: bucket.year, posts: bucket.posts },
  }));
}

const { year, posts } = Astro.props;
---

<ArchiveView posts={posts} heading={`${year} 年`} pageTitle={`${year} 年 - 文字`} />
