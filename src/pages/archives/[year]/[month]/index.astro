---
import ArchiveView from '../../../../components/ArchiveView.astro';
import { getArchives, getPosts } from '../../../../lib/posts';

export function getStaticPaths() {
  return getArchives().flatMap(bucket =>
    bucket.months.map(month => ({
      params: { year: bucket.year, month: month.month },
      props: { posts: month.posts },
    }))
  );
}

const { posts } = Astro.props;
const total = getPosts().length;
---

<ArchiveView posts={posts} total={total} />
