---
// 主题总览（/categories/）：一句结论 + 索引条（名称 / 篇数 / 最近日期），
// 折叠展开文章。主题与文章目前 1:1，不画条形。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories } from '../../lib/posts';
import { formatWithPattern } from '../../lib/dates';
import { zhCN } from '../../lib/i18n';

const categories = getCategories();
const covered = new Set<string>();
for (const cat of categories) {
  for (const post of cat.posts) covered.add(post.path);
}
---

<BaseLayout title={zhCN.category.title} markdownPlugins={false}>
  <div class="paper-page">
    <div class="home-wrap">
      <header class="ar-head">
        <nav class="ar-tabs" aria-label="文字视图切换">
          <a class="ar-tab" href="/archives/">时间轴</a>
          <a class="ar-tab is-active" href="/categories/" aria-current="page">四大主题</a>
          <a class="ar-tab" href="/tags/">关键词</a>
        </nav>
        <h1 class="ar-title">主题</h1>
        <p class="ar-lead">{categories.length} 个主题 · 覆盖 {covered.size} 篇</p>
      </header>

      <div class="ar-catlist">
        {categories.map((cat, i) => (
          <div class="ar-cat-group">
            <div class="ar-cat-row">
              <a class="ar-cat-name" href={cat.href}>{cat.name}</a>
              <span class="ar-cat-count">{cat.posts.length} 篇</span>
              <time class="ar-cat-date" datetime={formatWithPattern(cat.posts[0].date, 'YYYY-MM-DD')}>
                {formatWithPattern(cat.posts[0].date, 'YYYY-MM-DD')}
              </time>
              <a
                class="ar-cat-toggle collapsed"
                role="button"
                data-toggle="collapse"
                href={`#ar-cat-${i}`}
                aria-expanded="false"
                aria-controls={`ar-cat-${i}`}
              >
                文章<i class="iconfont icon-arrowright" />
              </a>
            </div>
            <div class="collapse" id={`ar-cat-${i}`}>
              <div class="ar-cat-posts">
                {cat.posts.map(post => (
                  <div class="ar-cat-post">
                    <time class="ar-cat-post-date" datetime={formatWithPattern(post.date, 'YYYY-MM-DD')}>
                      {formatWithPattern(post.date, 'MM-DD')}
                    </time>
                    <a class="ar-cat-post-title" href={post.href}>{post.title}</a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
