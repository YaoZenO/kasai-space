---
// 分类总览页：复刻 categories.ejs + _partials/category-list.ejs（本站分类为扁平结构）

import crypto from 'node:crypto';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getCategories } from '../../lib/posts';
import { formatWithPattern } from '../../lib/dates';
import { themeConfig } from '../../lib/site-config';
import { t } from '../../lib/i18n';

const title = t('category').title;
const categories = getCategories();
const postLimit = Number(themeConfig.category?.post_limit || 10);
const md5 = (s: string) => crypto.createHash('md5').update(s).digest('hex');
---

<BaseLayout title={title} currentPath="/categories/" markdownPlugins={false}>
  <div class="paper-page">
    <div class="home-wrap">
      <PageHead kicker="CATEGORIES" title="分类" />

      {categories.length > 0 && (
        <div class="category-list">
          {categories.map(cat => (
            <div class="cat-group">
              <div class="cat-row">
                <a class="cat-name" href={cat.href} title={cat.name.trim()}>
                  {cat.name.trim()}
                </a>
                <span class="cat-count">{cat.posts.length}</span>
                <a
                  class="cat-toggle collapsed"
                  role="button"
                  data-toggle="collapse"
                  href={`#cat-collapse-${md5(cat.name)}`}
                  aria-expanded="false"
                  aria-controls={`cat-collapse-${md5(cat.name)}`}
                  aria-label={`展开 ${cat.name.trim()} 下的文章`}
                >
                  <span>文章</span>
                  <i class="iconfont icon-arrowright" />
                </a>
              </div>
              <div class="cat-collapse collapse" id={`cat-collapse-${md5(cat.name)}`} aria-expanded="false">
                <div class="cat-post-list">
                  {cat.posts.map((post, idx) =>
                    postLimit && idx >= postLimit ? (
                      <a href={cat.href} class="cat-post cat-post-more">
                        <span>More...</span>
                      </a>
                    ) : (
                      <a href={post.href} title={post.title} class="cat-post">
                        <time class="cat-post-date">{formatWithPattern(post.date, 'MM-DD')}</time>
                        <span class="cat-post-title">{post.title}</span>
                      </a>
                    )
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
