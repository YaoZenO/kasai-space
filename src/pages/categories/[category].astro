---
// 主题详情页（/categories/<category>/）：名称 + N 篇 + 跨度。
import ArchiveView from '../../components/ArchiveView.astro';
import { getCategories } from '../../lib/posts';
import { zhCN } from '../../lib/i18n';

export function getStaticPaths() {
  return getCategories().map(cat => ({
    params: { category: cat.slug },
    props: { name: cat.name, posts: cat.posts },
  }));
}

const { name, posts } = Astro.props;
---

<ArchiveView posts={posts} heading={name} pageTitle={`${zhCN.category.title} - ${name}`} activeTab="categories" />
