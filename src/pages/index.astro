---
// 首页：三屏滚动叙事（2026-11-18 扩展为六窗双泳道：补全游戏与收藏板块）
//
// 结构对齐参考站 0z5a.github.io 的机制，不复制其像素：
//   ① 底层 <canvas id="sd-canvas">  固定画布，程序化绘制（无图片请求）
//   ② 三屏 #hero → #desk → #outro  滚动推进，画布按进度联动
//   ③ 六窗 3×2 错落工作台           外壳 100% 统一，左 01/03/05、右 02/04/06
//
// 纪律：
//   · 窗口抬头只放标题，一个数字都不放（主人 2026-11-15 铁律 1）；
//   · 第三屏用 section 元素而不是 footer：body.is-home footer 会被全站规则隐藏（E-071）；
//   · 六窗内部结构与外壳同构，不做"一个墨底一个透明"的差异化；
//   · 文章在首页只出现一次；
//   · 商用文案（About 三句）由主人定稿，模板里只做展示。

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getData } from '../lib/data';
import { getPosts } from '../lib/posts';
import { themeConfig } from '../lib/site-config';
import { renderMarkdown } from '../lib/markdown';
import { urlFor } from '../lib/url';
import { fmtItemDate } from '../lib/dates';
import { detailPath, type ModuleKey } from '../lib/modules';

const data = getData();
const posts = getPosts();
const pages = await getCollection('pages');

const siteCfg: any = data.site || {};
const intro = siteCfg.intro || themeConfig.about?.intro || 'Be water, my friend.';
const avatar = siteCfg.avatar || themeConfig.about?.avatar || '';
const icons: any[] = themeConfig.about?.icons || [];
const hasCopy = icons.some((e: any) => e && !e.link && !e.qrcode && e.copy);

const TODAY = fmtItemDate(new Date());
const sinceYear = posts.length ? String(Math.min(...posts.map((p) => p.date.getFullYear()))) : '';

// About Me 的三句状态描述：与 /about/ 共用 source/about/index.md 的 pillars 单一数据源，
// 保证首页与关于页永远一致（2026-11-15 主人定稿文案逐字保留在 source/about/index.md）。
const aboutEntry = pages.find((p) => p.id === 'about');
const aboutPillars: any[] = Array.isArray((aboutEntry?.data as any)?.pillars)
  ? (aboutEntry!.data as any).pillars
  : [];
const ABOUT_LINES: string[] = aboutPillars.length
  ? aboutPillars.map((p: any) => String(p.line || '')).filter(Boolean)
  : [
      '构建本地优先的私有系统——用代码将「关系事实」与「资产周期」结构化。',
      '独立维护这座数字空间：Astro 驱动，手搓 Git-backed 管理面板与自动化校验流。',
      '数字策展与考据：清洗 350 城统计数据、16 年历法节气与馆藏文物档案。',
    ];

// ---------- Thinking：四篇思考长文 ----------
// StyleKit 图鉴已归入 Collections 窗口，避免同一文章在首页重复出现。
const FEATURED = ['70b-to-cluster', 'metro-vs-gdp-rank-mismatch', 'deepseek-pm-interview', 'empty-card-and-latest-post'];
// 首页行只有 416px 宽：完整标题（带副标题的最长到 31 字）放不下，
// 这里给每篇一个短标题别名，只做前缀或等价收缩，不改语义；完整标题在详情页。
const THINK_T: Record<string, string> = {
  '70b-to-cluster': '70B 到底有多大',
  'metro-vs-gdp-rank-mismatch': '地铁越长，经济越强吗',
  'deepseek-pm-interview': 'DeepSeek 产品面经',
  'empty-card-and-latest-post': '关于「先做出来，再做好」',
};
// 行内第二行：一句话核心论点，取自文章自己的结论，不新增观点
const THINK_S: Record<string, string> = {
  '70b-to-cluster': '140/70/35 GB 显存对单卡 80GB',
  'metro-vs-gdp-rank-mismatch': '43 城 ρ=0.870，排名大幅错位',
  'deepseek-pm-interview': '四轮面经与产品判断复盘',
  'empty-card-and-latest-post': '先把真实骨架搭起来再打磨',
};
// 右侧短标签：分类，不超过 5 个字（数量与结论已经写进第二行）
const THINK_K: Record<string, string> = {
  '70b-to-cluster': '显存 · 集群',
  'metro-vs-gdp-rank-mismatch': '数据考据',
  'deepseek-pm-interview': 'AI 产品',
  'empty-card-and-latest-post': '随笔',
};
const featured = FEATURED.map((slug) => posts.find((p) => p.slug === slug)).filter(Boolean) as any[];

// ---------- Creations：两个真实项目 + 本站 ----------

function plain(s: string): string {
  return s
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}
function cut(s: string, max: number): string {
  const head = plain(s).split(/——|；|：|，|。/)[0].trim();
  return head.length > max ? head.slice(0, max) + '…' : head;
}

const nowEntry = pages.find((p) => p.id === 'now');
const nowBody = String(nowEntry?.body || '');
function sectionOf(body: string, heading: string): string {
  const re = new RegExp(`(?:^|\\n)#{2,3}\\s*${heading}\\s*\\r?\\n([\\s\\S]*?)(?=\\r?\\n#{2,3}\\s|$)`);
  const m = re.exec(body);
  return m ? m[1].trim() : '';
}

const projectItems: any[] = data.projects?.items || [];
// 两行结构：第一行写「这是什么」（主标题就是项目名），第二行写定位，右侧是技术栈。
// 项目名本身太抽象，光写 Ties 访客不知道是什么；技术栈也不是给人看的第一信息。
const MAKE_META: Record<string, { sub: string; k: string }> = {
  Ties: { sub: '私有关系事实与时间线档案系统', k: 'Vue · Node' },
  '资产追踪系统': { sub: '全生命周期日均持有成本桌面端', k: 'Tauri 2 · TS' },
  '校园课程资源共享平台': { sub: '多角色课程资源流转与 AI 助教', k: 'Django · Vue 3' },
};

const makeFromData = ['Ties', '资产追踪系统', '校园课程资源共享平台']
  .map((t) => projectItems.find((it) => String(it.title) === t))
  .filter(Boolean)
  .map((it: any) => ({
    id: String(it.title) === 'Ties' ? 'ties' : String(it.title) === '资产追踪系统' ? 'assets' : 'campus',
    name: String(it.title),
    sub: MAKE_META[String(it.title)]?.sub || cut(String(it.summary || ''), 16),
    k: MAKE_META[String(it.title)]?.k || '',
    href: urlFor(detailPath('projects' as ModuleKey, it)),
    html: [it.background ? renderMarkdown(String(it.background)) : '', it.tech ? renderMarkdown(String(it.tech)) : ''].join(''),
    more: { label: '完整记录', href: urlFor(detailPath('projects' as ModuleKey, it)) },
  }));

const makeAll = [
  ...makeFromData,
  {
    id: 'site',
    name: 'kasai-space',
    sub: '本站 · 自研 Git-backed 管理后台',
    k: 'Astro · Vercel',
    href: urlFor('/now/'),
    html: renderMarkdown(sectionOf(nowBody, '这个站')),
    more: { label: '完整演进见 /now/', href: urlFor('/now/') },
  },
];

// ---------- Games：两场赛事夺冠专题 ----------

const gameRows = [
  {
    name: 'BLG 2026 全球总决赛首冠',
    sub: '3-1 战胜 Gen.G，LPL 时隔五年再夺世界冠军',
    k: 'S16 专题',
    href: urlFor('/blg-champion/'),
  },
  {
    name: 'Falcons 2026 科隆 Major 夺冠',
    sub: '3-0 横扫 FURIA，NiKo 3067 天圆梦',
    k: 'CS2 Major',
    href: urlFor('/cologne-major-2026/'),
  },
];

// ---------- Collections：策展与收藏 ----------

const collectionItems: any[] = (data.collections?.items || []).filter((it: any) => it && it.title);
const COLL_META: Record<string, { sub: string; k: string }> = {
  'Esports Manager 2026 mods': { sub: '62 个写实化赛事包与界面重制 Mod', k: 'Nexus Mods' },
  'StyleKit 设计风格库（149 种）': { sub: '149 种现代网页流派色彩与空间语法', k: '站内图鉴' },
};
const collectionRows = collectionItems.slice(0, 4).map((it: any) => {
  const link = it.link ? String(it.link) : '';
  const isExt = /^https?:\/\//i.test(link);
  const meta = COLL_META[String(it.title)];
  return {
    name: String(it.title),
    sub: meta?.sub || cut(String(it.desc || ''), 20) || '策展与工具收藏',
    k: meta?.k || (isExt ? '外链' : '站内'),
    href: link ? (isExt ? link : urlFor(link)) : urlFor('/collections/'),
    isExt,
  };
});

// ---------- Atlas：四个专题 + 馆藏缩略图 ----------

const cityCount = (data.cities?.cities || []).length;
let rankCount = 0;
for (const g of data.cityrank?.groups || []) rankCount += (g.ranks || []).length;

const holidayYears: any[] = data.holidays?.years || [];
const holidayFirst = String(holidayYears[0]?.year || '');
const holidayLast = String(holidayYears.slice(-1)[0]?.year || '');
const festivalCount = (data.festivals?.festivals || []).length;
const zodiacCount = (data.zodiac?.animals || []).length;

// 资料库四行各配一张自己的界面裁图（2026-11-16）：图取本站页面本身，
// 不引外部素材，也就不需要任何署名。四张的顺序与四行一一对应，
// 成品在 source/img/library-thumbs/，页面改版后按同样顺序重截替换即可。
const atlasRows = [
  { href: '/cityrank/', name: '城市排行榜', sub: '排名错位与体量', k: `${cityCount} 城 · ${rankCount} 榜`, thumb: 'cityrank' },
  { href: '/holidays/', name: '中国节假日', sub: '放假与调休', k: `${holidayFirst}–${holidayLast}`, thumb: 'holidays' },
  { href: '/festivals/', name: '节日文化', sub: '来源与地方习俗', k: `${festivalCount} 篇考据`, thumb: 'festivals' },
  { href: '/zodiac/', name: '十二生肖', sub: '馆藏陶俑与纪年', k: `${zodiacCount} 生肖`, thumb: 'zodiac' },
].filter((r) => r.k);

// 资料库这张不再放缩略图（2026-11-16 主人要求）：四个条目里只有生肖是 Public domain，
// 城市图没有授权字段、节日图是 CC BY 2.0 需署名，混着放等于给首页引入署名义务。
// 「要么别放，要么每个都放一张」——取前者，四窗回到同一种行结构。

// ---------- Outro：节气与假期状态 ----------

const DAY_MS = 86400000;
function dayNo(ymd: string): number {
  const [y, m, d] = ymd.split('-').map(Number);
  return Date.UTC(y, m - 1, d) / DAY_MS;
}
const todayNo = dayNo(TODAY);

type Ev = { kind: '假期' | '节气'; name: string; date: string };
const events: Ev[] = [];
for (const y of holidayYears) {
  for (const h of y.holidays || []) if (h && h.start) events.push({ kind: '假期', name: String(h.name), date: String(h.start) });
  for (const t of y.terms || []) if (t && t.date) events.push({ kind: '节气', name: String(t.name), date: String(t.date) });
}
events.sort((a, b) => a.date.localeCompare(b.date));

const nextTerm = events.find((e) => e.kind === '节气' && e.date >= TODAY);
const nextHoliday = events.find((e) => e.kind === '假期' && e.date >= TODAY);
const daysTo = (d?: string) => (d ? dayNo(d) - todayNo : 0);

// 构建日之后打开页面时由前端按同一份数据现算，天数不会停在旧值
const eventFeed = events.filter((e) => dayNo(e.date) >= todayNo - 1).slice(0, 12).map((e) => ({ k: e.kind, n: e.name, d: e.date }));
---

<BaseLayout isHome currentPath="/">
  <canvas id="sd-canvas" aria-hidden="true"></canvas>

  <div class="sd">
    <!-- 第一屏：纯序幕，不放任何卡片 -->
    <header class="sd-hero" id="hero">
      <p class="sd-mark"><span class="sd-slash" aria-hidden="true">/</span>KASAI</p>
      <p class="sd-tag">{intro}</p>
    </header>

    <!-- 第二屏：六窗 S 形错落工作台。外壳完全统一，左泳道 About / Collections / Library，
         右泳道（下错 84px）Thinking / Creations / Games，左右体量实测误差 ≤15px，逐卡水平错位并带景深视差。 -->
    <section class="sd-desk" id="desk" aria-label="工作台">
      <!-- 左泳道：01 About Me → 03 Collections → 05 Library -->
      <div class="sd-lane sd-lane--a">
      <!-- 01 · About Me -->
        <section class="sd-win" id="win-about" data-sd-depth="0.4" aria-labelledby="win-about-t">
          <header class="win-head" title="拖动微调位置 · 双击复位">
            <h2 class="win-title" id="win-about-t">About Me</h2>
          </header>

          <ul class="win-lines">
            {ABOUT_LINES.map((line) => <li>{line}</li>)}
          </ul>

          {
            icons.length > 0 && (
              <div class="win-social-row">
            <ul class="win-social">
                  {icons.map((each: any) => {
                    if (!each || !each.class) return null;
                    if (each.qrcode) {
                      return (
                        <li>
                          <button class="social-btn" type="button" data-sd-open="wechat" aria-label="微信二维码">
                            <i class={each.class} aria-hidden="true" />
                          </button>
                        </li>
                      );
                    }
                    const isCopy = !each.link && Boolean(each.copy);
                    return (
                      <li>
                        <a
                          class="social-btn"
                          href={isCopy ? 'javascript:;' : urlFor(each.link)}
                          target={isCopy ? undefined : '_blank'}
                          rel={isCopy ? undefined : 'noopener'}
                          data-copy={isCopy ? each.copy : undefined}
                          aria-label={each.tip || undefined}
                        >
                          <i class={each.class} aria-hidden="true" />
                        </a>
                      </li>
                    );
                  })}
                  {/* 友链：配置里 0 条，浮层会是空盒子，所以直接进 /links/ 的真实空态页 */}
                  <li>
                    <a class="social-btn" href={urlFor('/links/')} aria-label="友链">
                      {/* 内联图标：iconfont 里没有稳定的 link 字形，缺字时会渲染成空心圆 */}
                      <svg class="social-svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path d="M6.4 9.6 9.6 6.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                        <path d="M7.2 4.9 8.7 3.4a2.7 2.7 0 0 1 3.9 3.9l-1.5 1.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                        <path d="M8.8 11.1 7.3 12.6a2.7 2.7 0 0 1-3.9-3.9l1.5-1.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                      </svg>
                    </a>
                  </li>
                </ul>
            <a class="win-more" href={urlFor('/about/')}>more <span aria-hidden="true">→</span></a>
          </div>
            )
          }
        </section>

        <!-- 03 · Collections -->
        {
          collectionRows.length > 0 && (
            <section class="sd-win" id="win-collections" data-sd-depth="-0.9" aria-labelledby="win-collections-t">
              <header class="win-head" title="拖动微调位置 · 双击复位">
                <h2 class="win-title" id="win-collections-t">Collections</h2>
              </header>

              <ul class="win-rows">
                {collectionRows.map((c) => (
                  <li>
                    <a
                      class="win-row"
                      href={c.href}
                      target={c.isExt ? '_blank' : undefined}
                      rel={c.isExt ? 'noopener' : undefined}
                    >
                      <span class="row-b">
                        <span class="row-t">{c.name}</span>
                        <span class="row-s">{c.sub}</span>
                      </span>
                      <span class="row-k">{c.k}</span>
                    </a>
                  </li>
                ))}
              </ul>

              <div class="win-foot"><a class="win-more" href={urlFor('/collections/')}>more <span aria-hidden="true">→</span></a></div>
            </section>
          )
        }

        <!-- 05 · Library -->
        <section class="sd-win" id="win-atlas" data-sd-depth="1.1" aria-labelledby="win-atlas-t">
          <header class="win-head" title="拖动微调位置 · 双击复位">
            <h2 class="win-title" id="win-atlas-t">Library</h2>
          </header>

          <div class="win-split">
            {/* 左栏四张界面裁图，与右栏四行一一对应；图片是行的缩略预览，
                所以对读屏隐藏、也不进 Tab 序（行本身才是真入口）。 */}
            <ul class="win-scraps" aria-hidden="true">
              {atlasRows.map((r) => (
                <li>
                  <a href={urlFor(r.href)} tabindex="-1">
                    <img src={urlFor(`/img/library-thumbs/${r.thumb}.jpg`)} alt="" loading="lazy" decoding="async" />
                  </a>
                </li>
              ))}
            </ul>

            <div class="win-split-main">
              <ul class="win-rows">
                {
                  atlasRows.map((r) => (
                    <li>
                      <a class="win-row" href={urlFor(r.href)}>
                        <span class="row-b">
                          <span class="row-t">{r.name}</span>
                          <span class="row-s">{r.sub}</span>
                        </span>
                        <span class="row-k">{r.k}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>

              <div class="win-foot">
                <a class="win-more" href={urlFor('/library/')}>more <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </section>

      </div>

    <!-- 右泳道：整体下错 84px，02 Thinking → 04 Creations → 06 Games -->
      <div class="sd-lane sd-lane--b">
      <!-- 02 · Thinking -->
        <section class="sd-win" id="win-thinking" data-sd-depth="-0.8" aria-labelledby="win-thinking-t">
          <header class="win-head" title="拖动微调位置 · 双击复位">
            <h2 class="win-title" id="win-thinking-t">Thinking</h2>
          </header>

          <ul class="win-rows">
            {
              featured.map((p) => (
                <li>
                  <a class="win-row" href={urlFor(p.href)}>
                    <span class="row-b">
                      <span class="row-t">{THINK_T[p.slug] || p.title}</span>
                      <span class="row-s">{THINK_S[p.slug] || ''}</span>
                    </span>
                    <span class="row-k">{THINK_K[p.slug] || (p.categories || [])[0] || ''}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="win-foot"><a class="win-more" href={urlFor('/archives/')}>more <span aria-hidden="true">→</span></a></div>
        </section>

        <!-- 04 · Creations -->
        <section class="sd-win" id="win-creations" data-sd-depth="0.5" aria-labelledby="win-creations-t">
          <header class="win-head" title="拖动微调位置 · 双击复位">
            <h2 class="win-title" id="win-creations-t">Creations</h2>
          </header>

          <ul class="win-rows">
            {
              makeAll.map((it) => (
                <li>
                  <a class="win-row" href={it.href} data-sd-open={it.id}>
                    <span class="row-b">
                      <span class="row-t">{it.name}</span>
                      <span class="row-s">{it.sub}</span>
                    </span>
                    <span class="row-k">{it.k}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="win-foot"><a class="win-more" href={urlFor('/projects/')}>more <span aria-hidden="true">→</span></a></div>
        </section>

        <!-- 06 · Games -->
        {
          gameRows.length > 0 && (
            <section class="sd-win" id="win-games" data-sd-depth="1.2" aria-labelledby="win-games-t">
              <header class="win-head" title="拖动微调位置 · 双击复位">
                <h2 class="win-title" id="win-games-t">Games</h2>
              </header>

              <ul class="win-rows">
                {gameRows.map((g) => (
                  <li>
                    <a class="win-row" href={g.href}>
                      <span class="row-b">
                        <span class="row-t">{g.name}</span>
                        <span class="row-s">{g.sub}</span>
                      </span>
                      <span class="row-k">{g.k}</span>
                    </a>
                  </li>
                ))}
              </ul>

              <div class="win-foot"><a class="win-more" href={urlFor('/games/')}>more <span aria-hidden="true">→</span></a></div>
            </section>
          )
        }
      </div>
    </section>

    <!-- 第三屏：落幕。用 section 而非 footer（body.is-home footer 被全站隐藏，E-071） -->
    <section class="sd-outro" id="outro" aria-label="落幕与节气状态">
      <p class="sd-badge">
        {
          nextTerm && (
            <span>
              距 {nextTerm.name} <b data-sd-feed="term">{daysTo(nextTerm.date)}</b> 天
            </span>
          )
        }
        {
          nextHoliday && (
            <span>
              距 {nextHoliday.name} <b data-sd-feed="holiday">{daysTo(nextHoliday.date)}</b> 天
            </span>
          )
        }
      </p>
      <a class="sd-top" href="#hero" aria-label="回到顶部"><span aria-hidden="true">↑</span></a>
    </section>
  </div>

  <!-- 原地浮层：Creations 三条与微信码共用同一个 <dialog>（用 div 而非 header/footer，E-071） -->
  <dialog class="sd-modal" id="sd-modal" aria-labelledby="sd-modal-title">
    <div class="sd-modal-in">
      <div class="sd-modal-head">
        <p class="sd-modal-kicker" data-sd-kicker>造物</p>
        <h2 class="sd-modal-title" id="sd-modal-title" data-sd-title></h2>
      </div>
      <div class="sd-modal-body" data-sd-body></div>
      <div class="sd-modal-foot">
        <a class="sd-modal-more" data-sd-more href="/">完整记录</a>
        <button class="sd-modal-close" type="button" data-sd-close>关闭</button>
      </div>
    </div>
  </dialog>

  {
    makeAll.map((it) => (
      <template id={`sd-tpl-${it.id}`} data-sd-name={it.name} data-sd-more={it.more.label} data-sd-href={it.more.href} data-sd-kicker="造物">
        <div set:html={it.html} />
      </template>
    ))
  }

  <template id="sd-tpl-wechat" data-sd-name="微信二维码" data-sd-more="" data-sd-href="">
    <img class="sd-modal-qr" src={urlFor('/img/wechat-qr.jpg')} alt="微信二维码" loading="lazy" />
  </template>

  <script type="application/json" id="sd-feed" set:html={JSON.stringify(eventFeed)}></script>
  <script defer src="/js/home-study.js"></script>
  {hasCopy && <script defer src="/js/about.js" />}
</BaseLayout>
