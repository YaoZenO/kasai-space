---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Falcons 3-0 FURIA：科隆Major夺冠，NiKo圆梦';
const description = 'Team Falcons 3-0 横扫 FURIA，赢下 IEM Cologne Major 2026，三张地图全部 13-8。队史首座 Major 奖杯，NiKo 3067 天的等待终结，m0NESY 拿下 MVP。LANXESS Arena, Cologne。';
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImages={['/img/games/cologne-major-2026/01-trophy.jpg']}
  ogKeywords={['Falcons', 'FURIA', 'CS2', 'IEM Cologne Major', 'NiKo', 'm0NESY', 'Major']}
  currentPath="/cologne-major-2026/"
>
<style>
  .cg-wrap{
    --cg-bg:#f2f0e8; --cg-bg2:#e6e8df; --cg-ink:#1e2420; --cg-muted:#6d7268;
    --cg-card:#fffdf6; --cg-line:#d8dcc9; --cg-gold:#96760f; --cg-gold2:#c9a227;
    --cg-green:#0e6b3f; --cg-green2:#17a05e; --cg-furia:#3f4440;
    --cg-shadow:0 12px 32px rgba(30,50,35,.10);
    --cg-panel:#0d2b1d; --cg-panel2:#07150e; --cg-panel-ink:#ecefe4; --cg-panel-muted:#9db3a4;
    background:
      radial-gradient(1100px 420px at 50% -80px, rgba(23,160,94,.14), transparent 70%),
      linear-gradient(180deg, var(--cg-bg), var(--cg-bg2));
    color:var(--cg-ink);
    margin:0 calc(50% - 50vw); width:100vw; max-width:100vw; overflow:hidden;
    font-size:17px; line-height:1.75;
  }
  :global(html[data-user-color-scheme="dark"]) .cg-wrap,
  :global(html[data-sun-scheme="dark"]) .cg-wrap{
    --cg-bg:#0e1512; --cg-bg2:#090d0b; --cg-ink:#ecefe4; --cg-muted:#9db3a4;
    --cg-card:#161d19; --cg-line:#263129; --cg-gold:#e8c469; --cg-gold2:#f5d98a;
    --cg-green:#4cc38a; --cg-green2:#5fd79a; --cg-furia:#c9cdc5;
    --cg-shadow:0 12px 32px rgba(0,0,0,.45);
  }
  @media (prefers-color-scheme: dark){
    :global(html:not([data-user-color-scheme]):not([data-sun-scheme])) .cg-wrap{
      --cg-bg:#0e1512; --cg-bg2:#090d0b; --cg-ink:#ecefe4; --cg-muted:#9db3a4;
      --cg-card:#161d19; --cg-line:#263129; --cg-gold:#e8c469; --cg-gold2:#f5d98a;
      --cg-green:#4cc38a; --cg-green2:#5fd79a; --cg-furia:#c9cdc5;
      --cg-shadow:0 12px 32px rgba(0,0,0,.45);
    }
  }
  .cg-wrap::before{
    content:""; display:block; height:4px;
    background:linear-gradient(90deg, var(--cg-gold2), var(--cg-green2), var(--cg-gold2));
  }
  .cg-wrap img{user-select:none}
  .cg-wrap ::selection{background:var(--cg-gold2); color:#1a1a1a}

  /* ---------- hero ---------- */
  .cg-hero{position:relative; min-height:94vh; display:flex; align-items:flex-end; overflow:hidden; background:#0b0d14}
  .cg-hero-media{position:absolute; inset:0; animation:cgZoom 22s ease-in-out infinite alternate}
  .cg-hero-media img{width:100%; height:100%; object-fit:cover; object-position:center 30%; display:block}
  .cg-hero::after{content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(5,6,10,.42) 0%, rgba(5,6,10,.08) 42%, rgba(5,6,10,.30) 66%, rgba(5,6,10,.88) 100%)}
  .cg-hero-inner{position:relative; z-index:2; width:100%; max-width:1020px; margin:0 auto; padding:0 24px 84px; color:#fff}
  .cg-kicker{font-size:13px; letter-spacing:.34em; text-transform:uppercase; color:#f5d98a; font-weight:700; animation:cgRise .8s .1s ease both}
  .cg-kicker-cn{margin-top:8px; font-size:15px; letter-spacing:.42em; color:rgba(255,255,255,.82); animation:cgRise .8s .22s ease both}
  .cg-title{margin:18px 0 0; font-size:clamp(56px, 11vw, 128px); line-height:1.02; font-weight:900; letter-spacing:-.01em; animation:cgRise .8s .34s ease both}
  .cg-title .gold{
    background:linear-gradient(100deg,#a8842a,#e8c469 28%,#fff3c4 50%,#e8c469 72%,#a8842a);
    background-size:200% 100%; -webkit-background-clip:text; background-clip:text; color:transparent;
    animation:cgShine 7s linear infinite;
  }
  .cg-score{display:inline-flex; align-items:baseline; gap:14px; margin-top:26px; padding:10px 22px;
    border:1px solid rgba(232,196,105,.75); border-radius:999px; background:rgba(8,9,14,.42); backdrop-filter:blur(6px);
    font-size:clamp(20px,3.4vw,30px); font-weight:800; letter-spacing:.06em; animation:cgRise .8s .48s ease both}
  .cg-score .n{color:#f5d98a}
  .cg-score .vs{font-size:.62em; letter-spacing:.3em; color:rgba(255,255,255,.7)}
  .cg-hero-sub{margin:20px 0 0; max-width:640px; font-size:clamp(16px,2.4vw,20px); line-height:1.7; color:rgba(255,255,255,.92); animation:cgRise .8s .6s ease both}
  .cg-hero-meta{margin-top:16px; font-size:14px; letter-spacing:.08em; color:rgba(255,255,255,.72); animation:cgRise .8s .72s ease both}
  .cg-hero-meta b{color:#fff; font-weight:700}
  .cg-scroll{position:absolute; z-index:2; left:50%; bottom:26px; transform:translateX(-50%);
    display:flex; flex-direction:column; align-items:center; gap:6px; color:rgba(255,255,255,.75);
    font-size:11px; letter-spacing:.4em; text-transform:uppercase; animation:cgRise .8s 1s ease both}
  .cg-scroll i{width:18px; height:18px; border-right:2px solid #f5d98a; border-bottom:2px solid #f5d98a; transform:rotate(45deg); animation:cgBounce 1.8s ease-in-out infinite}
  @keyframes cgZoom{from{transform:scale(1)}to{transform:scale(1.07)}}
  @keyframes cgRise{from{opacity:0; transform:translateY(26px)}to{opacity:1; transform:none}}
  @keyframes cgShine{to{background-position:-200% 0}}
  @keyframes cgBounce{0%,100%{transform:rotate(45deg) translate(0,0)}50%{transform:rotate(45deg) translate(4px,4px)}}

  /* ---------- sections ---------- */
  .cg-section{max-width:960px; margin:0 auto; padding:76px 20px 8px}
  .cg-eyebrow{display:flex; align-items:center; gap:14px; font-size:13px; font-weight:700; letter-spacing:.32em; text-transform:uppercase; color:var(--cg-gold)}
  .cg-eyebrow::after{content:""; height:1px; width:64px; background:var(--cg-gold2)}
  .cg-section h2{margin:14px 0 0; font-size:clamp(30px,5vw,44px); line-height:1.2; font-weight:900; letter-spacing:-.01em}
  .cg-lead{margin:16px 0 0; font-size:18px; color:var(--cg-muted)}
  .cg-lead b{color:var(--cg-ink)}

  .reveal{opacity:0; transform:translateY(20px); transition:opacity .7s ease, transform .7s ease}
  .reveal.in{opacity:1; transform:none}
  .reveal[data-d="1"]{transition-delay:.08s}
  .reveal[data-d="2"]{transition-delay:.16s}
  .reveal[data-d="3"]{transition-delay:.24s}

  /* ---------- lineups ---------- */
  .cg-vs{display:grid; grid-template-columns:1fr auto 1fr; gap:20px; align-items:stretch; margin-top:34px}
  .cg-team{background:var(--cg-card); border:1px solid var(--cg-line); border-radius:16px; padding:24px 22px; box-shadow:var(--cg-shadow); transition:transform .35s ease, box-shadow .35s ease}
  .cg-team:hover{transform:translateY(-4px)}
  .cg-team.fal{border-top:4px solid var(--cg-green2)}
  .cg-team.fur{border-top:4px solid var(--cg-furia)}
  .cg-team h3{margin:0; font-size:30px; font-weight:900; letter-spacing:.02em; line-height:1.1}
  .cg-team .tag{display:inline-block; margin-top:8px; font-size:12px; letter-spacing:.22em; font-weight:700; color:var(--cg-muted)}
  .cg-roster{margin:18px 0 0; padding:0; list-style:none}
  .cg-roster li{display:flex; align-items:baseline; gap:12px; padding:9px 0; border-top:1px dashed var(--cg-line)}
  .cg-roster li:first-child{border-top:0}
  .cg-role{flex:0 0 44px; font-size:11px; font-weight:700; letter-spacing:.14em; color:var(--cg-muted)}
  .cg-player{font-size:19px; font-weight:800}
  .cg-player small{margin-left:8px; font-size:13px; font-weight:400; color:var(--cg-muted)}
  .cg-coach{margin-top:14px; padding-top:12px; border-top:1px solid var(--cg-line); font-size:13.5px; color:var(--cg-muted)}
  .cg-coach b{color:var(--cg-ink)}
  .cg-vs-badge{align-self:center; width:64px; height:64px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:var(--cg-ink); color:var(--cg-bg); font-weight:900; font-size:20px; letter-spacing:.05em; box-shadow:var(--cg-shadow)}
  .cg-figure{margin:28px 0 0; overflow:hidden; border-radius:16px; box-shadow:var(--cg-shadow)}
  .cg-figure img{display:block; width:100%; transition:transform .6s ease}
  .cg-figure:hover img{transform:scale(1.03)}
  .cg-figure figcaption{padding:12px 16px; font-size:13.5px; color:var(--cg-muted); background:var(--cg-card); border-top:1px solid var(--cg-line)}

  /* ---------- map cards ---------- */
  .cg-cards{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:34px}
  .cg-card{background:var(--cg-card); border:1px solid var(--cg-line); border-radius:14px; padding:20px 18px; box-shadow:var(--cg-shadow); transition:transform .35s ease, border-color .35s ease; position:relative; overflow:hidden}
  .cg-card:hover{transform:translateY(-5px)}
  .cg-card.win{border-top:4px solid var(--cg-gold2)}
  .cg-card .g{font-size:12px; font-weight:700; letter-spacing:.26em; color:var(--cg-muted)}
  .cg-card .w{margin-top:10px; font-size:26px; font-weight:900}
  .cg-card .w .l{color:var(--cg-gold)}
  .cg-card .meta{margin-top:6px; font-size:13.5px; color:var(--cg-muted)}
  .cg-card .note{margin-top:12px; font-size:14px; line-height:1.6}

  /* ---------- veto ---------- */
  .cg-veto{margin-top:26px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; font-size:13.5px}
  .cg-veto .lbl{font-size:11px; font-weight:800; letter-spacing:.22em; color:var(--cg-muted); margin-right:4px}
  .cg-veto .chip{padding:6px 13px; border-radius:999px; border:1px solid var(--cg-line); background:var(--cg-card); font-weight:700; box-shadow:var(--cg-shadow)}
  .cg-veto .chip small{margin-left:6px; font-weight:400; color:var(--cg-muted)}
  .cg-veto .chip.ban{opacity:.72; text-decoration:line-through}
  .cg-veto .chip.unplayed{opacity:.72; border-style:dashed}
  .cg-veto .arrow{color:var(--cg-muted)}

  /* ---------- story ---------- */
  .cg-games{margin-top:34px; display:grid; gap:30px}
  .cg-game h3{margin:0; font-size:22px; font-weight:900}
  .cg-game h3 .tag{margin-left:10px; font-size:12px; font-weight:700; letter-spacing:.2em; color:var(--cg-gold)}
  .cg-game p{margin:10px 0 0; color:var(--cg-ink)}
  .cg-game p b{color:var(--cg-ink)}
  .cg-game .num{font-variant-numeric:tabular-nums; font-weight:700; color:var(--cg-gold)}

  /* ---------- scoreboards ---------- */
  .cg-tabs{display:flex; flex-wrap:wrap; gap:10px; margin-top:30px}
  .cg-tab{appearance:none; border:1px solid var(--cg-line); background:var(--cg-card); color:var(--cg-ink);
    padding:11px 20px; border-radius:999px; font-size:15px; font-weight:700; letter-spacing:.04em; cursor:pointer;
    transition:all .25s ease; box-shadow:var(--cg-shadow)}
  .cg-tab small{margin-left:6px; font-size:12px; font-weight:400; color:var(--cg-muted)}
  .cg-tab:hover{transform:translateY(-2px); border-color:var(--cg-gold2)}
  .cg-tab.active{background:var(--cg-gold2); border-color:var(--cg-gold2); color:#1c1a12}
  .cg-tab.active small{color:rgba(28,26,18,.66)}
  .cg-panel{margin-top:22px; animation:cgFade .45s ease both}
  .cg-panel[hidden]{display:none}
  @keyframes cgFade{from{opacity:0; transform:translateY(10px)}to{opacity:1; transform:none}}
  .cg-sb{background:var(--cg-card); border:1px solid var(--cg-line); border-radius:16px; overflow:hidden; box-shadow:var(--cg-shadow)}
  .cg-sb + .cg-sb{margin-top:16px}
  .cg-sb-head{display:flex; flex-wrap:wrap; align-items:center; gap:12px; padding:16px 20px; border-bottom:1px solid var(--cg-line)}
  .cg-sb-head h3{margin:0; font-size:21px; font-weight:900; letter-spacing:.02em}
  .cg-sb-head .totals{margin-left:auto; font-size:14px; color:var(--cg-muted); font-variant-numeric:tabular-nums}
  .cg-sb-head .totals b{color:var(--cg-ink)}
  .cg-win-badge{font-size:11px; font-weight:800; letter-spacing:.2em; color:#1c1a12; background:var(--cg-gold2); padding:4px 10px; border-radius:999px}
  .cg-sb-rows{padding:6px 20px 10px}
  .cg-sb-row{display:grid; grid-template-columns:1fr auto auto; column-gap:20px; row-gap:2px; align-items:center; padding:10px 0; border-top:1px dashed var(--cg-line)}
  .cg-sb-row:first-child{border-top:0}
  .cg-sb-who{min-width:0}
  .cg-sb-who .p{font-size:16.5px; font-weight:800; line-height:1.25}
  .cg-sb-who .c{font-size:13px; color:var(--cg-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .cg-sb-stat{text-align:right; font-variant-numeric:tabular-nums; min-width:86px}
  .cg-sb-stat .kd{font-size:16.5px; font-weight:800; white-space:nowrap}
  .cg-sb-stat .kd .d{color:var(--cg-muted); font-weight:400}
  .cg-sb-stat .adr{font-size:12.5px; color:var(--cg-muted); white-space:nowrap}
  .cg-sb-rating{text-align:right; font-variant-numeric:tabular-nums; min-width:52px}
  .cg-sb-rating .rt{font-size:19px; font-weight:900}
  .cg-sb-rating .rt.hot{color:var(--cg-gold)}
  .cg-sb-rating .rl{font-size:11px; letter-spacing:.14em; color:var(--cg-muted)}
  .cg-sb-extra{grid-column:1 / -1; font-size:13px; color:var(--cg-muted); font-variant-numeric:tabular-nums; padding-bottom:2px}
  .cg-sb-extra b{color:var(--cg-ink); font-weight:700}
  .cg-data-note{margin-top:18px; font-size:13.5px; color:var(--cg-muted)}
  .cg-data-note a{color:var(--cg-gold); text-decoration:underline}

  /* ---------- mvp ---------- */
  .cg-mvp{margin-top:76px; background:linear-gradient(160deg, var(--cg-panel), var(--cg-panel2)); color:var(--cg-panel-ink); position:relative; overflow:hidden}
  .cg-mvp::before{content:""; position:absolute; inset:0; background:radial-gradient(640px 300px at 88% 0%, rgba(232,196,105,.20), transparent 70%); pointer-events:none}
  .cg-mvp-inner{position:relative; max-width:960px; margin:0 auto; padding:72px 20px}
  .cg-mvp .cg-eyebrow{color:#f5d98a}
  .cg-mvp-name{margin:12px 0 0; font-size:clamp(56px,10vw,104px); line-height:1; font-weight:900; letter-spacing:.01em;
    background:linear-gradient(100deg,#a8842a,#e8c469 30%,#fff3c4 50%,#e8c469 70%,#a8842a); background-size:200% 100%;
    -webkit-background-clip:text; background-clip:text; color:transparent; animation:cgShine 8s linear infinite}
  .cg-mvp-role{margin-top:10px; font-size:15px; letter-spacing:.3em; text-transform:uppercase; color:rgba(236,239,228,.75)}
  .cg-stats{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:34px}
  .cg-stat{border:1px solid rgba(232,196,105,.28); border-radius:14px; padding:20px 16px; background:rgba(255,255,255,.03); transition:transform .35s ease, border-color .35s ease}
  .cg-stat:hover{transform:translateY(-4px); border-color:rgba(232,196,105,.6)}
  .cg-stat .v{font-size:clamp(26px,4.4vw,38px); font-weight:900; color:#f5d98a; font-variant-numeric:tabular-nums; line-height:1.1}
  .cg-stat .l{margin-top:8px; font-size:13px; line-height:1.5; color:rgba(236,239,228,.72)}
  .cg-mvp-facts{margin:28px 0 0; padding:0; list-style:none; display:grid; gap:10px; font-size:16px; color:rgba(236,239,228,.88)}
  .cg-mvp-facts li{padding-left:22px; position:relative}
  .cg-mvp-facts li::before{content:""; position:absolute; left:0; top:.62em; width:8px; height:8px; border-radius:50%; background:#e8c469}
  .cg-mvp .cg-figure figcaption{background:#101a14; color:#9db3a4; border-top:1px solid #263129}

  /* ---------- wait / road ---------- */
  .cg-wait p{margin:14px 0 0}
  .cg-wait .num{font-variant-numeric:tabular-nums; font-weight:700; color:var(--cg-gold)}
  .cg-road{display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:34px}
  .cg-step{background:var(--cg-card); border:1px solid var(--cg-line); border-radius:14px; padding:22px 18px; box-shadow:var(--cg-shadow); transition:transform .35s ease; position:relative}
  .cg-step:hover{transform:translateY(-5px)}
  .cg-step .round{font-size:12px; font-weight:700; letter-spacing:.24em; color:var(--cg-muted); text-transform:uppercase}
  .cg-step .opp{margin-top:10px; font-size:21px; font-weight:900; line-height:1.25}
  .cg-step .sc{margin-top:6px; font-size:15px; font-weight:700; color:var(--cg-gold)}
  .cg-step .maps{margin-top:8px; font-size:13.5px; color:var(--cg-muted); line-height:1.6}
  .cg-step.final{border-color:var(--cg-gold2)}
  .cg-road-note{margin-top:22px; font-size:16px; color:var(--cg-muted)}
  .cg-road-note .en{display:block; margin-top:6px; font-style:italic; color:var(--cg-ink); font-size:17px}

  /* ---------- atmosphere ---------- */
  .cg-nums{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:34px}
  .cg-num{background:var(--cg-card); border:1px solid var(--cg-line); border-radius:14px; padding:20px 16px; box-shadow:var(--cg-shadow); text-align:center}
  .cg-num .v{font-size:clamp(24px,4vw,34px); font-weight:900; color:var(--cg-green); font-variant-numeric:tabular-nums; line-height:1.1}
  .cg-num .l{margin-top:8px; font-size:13px; line-height:1.5; color:var(--cg-muted)}

  /* ---------- finale ---------- */
  .cg-finale{position:relative; margin-top:76px; min-height:88vh; display:flex; align-items:center; justify-content:center; text-align:center; overflow:hidden; background:#0b0d14}
  .cg-finale-media{position:absolute; inset:0; animation:cgZoom 24s ease-in-out infinite alternate}
  .cg-finale-media img{width:100%; height:100%; object-fit:cover; object-position:center 42%; display:block}
  .cg-finale::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(5,6,10,.55), rgba(5,6,10,.28) 45%, rgba(5,6,10,.82))}
  .cg-finale-inner{position:relative; z-index:2; padding:40px 24px; color:#fff; max-width:820px}
  .cg-finale-inner .rule{width:72px; height:3px; background:#e8c469; margin:0 auto 26px}
  .cg-finale-inner h2{margin:0; font-size:clamp(34px,6.4vw,58px); line-height:1.25; font-weight:900; text-shadow:0 2px 24px rgba(0,0,0,.45)}
  .cg-finale-inner p{margin:20px 0 0; font-size:clamp(16px,2.6vw,20px); color:rgba(255,255,255,.88)}
  .cg-finale-inner .en{margin-top:14px; font-size:13px; letter-spacing:.34em; text-transform:uppercase; color:#f5d98a}

  .cg-credits{max-width:960px; margin:0 auto; padding:36px 20px 64px; font-size:13.5px; line-height:1.8; color:var(--cg-muted)}
  .cg-credits a{color:var(--cg-gold); text-decoration:underline}

  @media (max-width: 860px){
    .cg-cards{grid-template-columns:1fr}
    .cg-stats{grid-template-columns:repeat(2,1fr)}
    .cg-road{grid-template-columns:1fr}
    .cg-nums{grid-template-columns:repeat(2,1fr)}
    .cg-vs{grid-template-columns:1fr}
    .cg-vs-badge{justify-self:center; width:54px; height:54px; font-size:17px}
  }
  @media (max-width: 560px){
    .cg-section{padding-top:60px}
    .cg-hero{min-height:92vh}
    .cg-hero-media img{object-position:center 28%}
    .cg-sb-row{gap:12px}
    .cg-sb-stat{min-width:70px}
    .cg-sb-head .totals{margin-left:0; width:100%}
  }
  @media (prefers-reduced-motion: reduce){
    .cg-hero-media, .cg-finale-media, .cg-title .gold, .cg-mvp-name, .cg-scroll i,
    .cg-kicker, .cg-kicker-cn, .cg-title, .cg-score, .cg-hero-sub, .cg-hero-meta, .cg-scroll{animation:none !important}
    .reveal{opacity:1; transform:none; transition:none}
    .cg-panel{animation:none}
    .cg-figure img, .cg-team, .cg-card, .cg-step, .cg-stat, .cg-tab{transition:none}
  }
  .cg-wrap p.cg-kicker, .cg-wrap p.cg-kicker-cn, .cg-wrap p.cg-eyebrow, .cg-wrap p.cg-hero-meta{margin:0}
  .cg-wrap p.cg-kicker-cn{margin-top:8px}
  .cg-wrap p.cg-hero-meta{margin-top:16px}
  .cg-wrap .cg-card p, .cg-wrap .cg-step p, .cg-wrap .cg-num p{margin:0}
  .cg-wrap .cg-card p.w{margin-top:10px}
  .cg-wrap .cg-card p.meta{margin-top:6px}
  .cg-wrap .cg-card p.note{margin-top:12px}
  .cg-wrap .cg-step p.opp{margin-top:10px}
  .cg-wrap .cg-step p.sc{margin-top:6px}
  .cg-wrap .cg-step p.maps{margin-top:8px}
