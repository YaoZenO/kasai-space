---
// /collections/：零边框策展陈列（2026-11-26 重构）。
// 复用底层动态经纬画布 #ab-bg-canvas，去掉统一圆角卡片，
// 有图条目以无框宽幅图呈现，无图条目以排印标本板（超大数字 + 站点色带）自然平衡。
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getData } from '../../lib/data';
import { urlFor } from '../../lib/url';
import { fmtItemDate } from '../../lib/dates';

const items = (getData().collections?.items || []).filter((it: any) => it && it.title);

const latest = items.reduce((acc: any, it: any) => {
  if (!it.date) return acc;
  if (!acc) return it;
  return new Date(it.date).getTime() > new Date(acc.date).getTime() ? it : acc;
}, null);

const lead = [
  `${items.length} 个条目`,
  latest ? `最近更新 ${fmtItemDate(latest.date)}` : '',
].filter(Boolean).join(' · ');
---

<BaseLayout title="收藏" currentPath="/collections/">
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>

  <div class="paper-page ab-page-shell">
    <div class="home-wrap cl-page">
      <header class="cl-head">
        <p class="ab-watermark" data-ab-parallax="0.16" aria-hidden="true">CURATED</p>

        <div class="cl-head-main">
          <p class="ab-kicker ab-reveal" style="--ab-d: 0ms;">
            <span>CURATED</span>
            <span class="ab-kicker-sep" aria-hidden="true">/</span>
            <span>SHELF</span>
          </p>
          <h1 class="cl-title">收藏</h1>
          <p class="cl-lead">{lead}</p>
        </div>
      </header>

      {items.length === 0 ? (
        <EmptyState>还没有收藏条目，可以先去<a href={urlFor('/projects/')}>项目</a>看看。</EmptyState>
      ) : (
        <div class="cl-list">
          {items.map((it: any, idx: number) => {
            const link = it.link ? String(it.link) : '';
            const isExt = /^https?:\/\//i.test(link);
            const Card = link ? 'a' : 'div';
            const numMatch = /(\d+)/.exec(String(it.title || ''));
            const specimenNum = numMatch ? numMatch[1] : String(idx + 1).padStart(2, '0');
            return (
              <Card
                class="cl-card"
                id={`col-${idx}`}
                {...(link ? (isExt ? { href: link, target: '_blank', rel: 'noopener' } : { href: urlFor(link) }) : {})}
              >
                {it.cover ? (
                  <span class="cl-cover">
                    <img src={urlFor(it.cover)} alt={it.title} loading="lazy" />
                  </span>
                ) : (
                  <span class="cl-specimen" aria-hidden="true">
                    <span class="cl-specimen-num">{specimenNum}</span>
                    <span class="cl-specimen-swatches">
                      <i class="cl-sw cl-sw--1" />
                      <i class="cl-sw cl-sw--2" />
                      <i class="cl-sw cl-sw--3" />
                      <i class="cl-sw cl-sw--4" />
                    </span>
                    <span class="cl-specimen-cap">INTERACTIVE INDEX</span>
                  </span>
                )}

                <span class="cl-body">
                  <span class="cl-meta-row">
                    <span class="cl-code">{String(idx + 1).padStart(2, '0')}</span>
                    {link && <span class="cl-badge">{isExt ? '外链策展 ↗' : '站内图鉴 →'}</span>}
                    {it.date && (
                      <time class="cl-date" datetime={fmtItemDate(it.date, 'YYYY-MM-DD')}>{fmtItemDate(it.date)}</time>
                    )}
                  </span>
                  <span class="cl-name">{it.title}</span>
                  {it.desc && <span class="cl-desc">{it.desc}</span>}
                  {link && (
                    <span class="cl-go">
                      {isExt ? '前往外部策展 ↗' : '进入站内图鉴 →'}
                    </span>
                  )}
                </span>
              </Card>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <script defer src="/js/about.js"></script>
</BaseLayout>
