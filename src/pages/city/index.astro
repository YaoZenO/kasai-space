---
// 城市大类索引页（/city/）：复刻 themes/fluid/layout/cityindex.ejs 的 DOM。
//
// 2026-11-04 改版（PLAN-V3 §6）：原来把 431 座城市平铺成一列 431 行的名单，
// 读者滚到第 50 行就不知道自己在哪了，而且名单里城市之间没有任何可比的数字。
// 现在分两段：
//   ① 上榜最多的 30 座 → 榜单行（名次 / 城市·省·级别 / 上榜次数+横条 / GDP / 人口）
//   ② 其余按省份折叠 → 原生 <details>，不依赖 JS，无 JS 也能展开
//
// 2026-11-08 改版（PAGE-FORM-PLAN §4.0，主人从 A/B/C 三个样例里选 B「热力宫格」）：
// 这一页此前仍是「文章壳 + 34 行省名 + 29 个折叠目录」，可见文本 6509 字，比一篇博客还长。
// 现在改成：
//   ① 首屏 = 结论 + 四格数字带 + 城市名搜索（纯 GET 表单，落到 /search/?q=，不依赖 JS）
//      + 省份宫格（名称 / 在册城市数 / 相对最大省份的条形）
//   ② 30 座大图卡不变（2026-11-08 三次改版已验收）
//   ③ 其余城市由 <details> 折叠改三列索引，省名一行、城市名紧随其后
//
// 数据：source/_data/cities.yml + cityrank.yml；计算：src/lib/cityrank-data.ts

import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBand from '../../components/StatBand.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getData } from '../../lib/data';
import { buildCityRanks, cityMentionCount, cityProvinces } from '../../lib/cityrank-data';
import { urlFor } from '../../lib/url';

const data = getData();
const CR = buildCityRanks(data);

/* 榜单里的数值统一加千分位（DESIGN-LANGUAGE §5.19）：1152822.4 读不出来，
   1,152,822.4 才读得出来。等宽栈下千分位不改变字宽节奏，只让位数可数。
   小数收到 1 位：GDP 的 2 位小数（24,763.61）是假精度，各城来源本身就在亿元级浮动。 */
function fmtCardNum(v: any): string {
  if (v === null || v === undefined || v === '') return '';
  if (typeof v !== 'number') return String(v);
  const s = String(Math.round(v * 10) / 10);
  const parts = s.split('.');
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return parts.join('.');
}

/* 取城市某个指标的数值。缺字段 / 值不是有限数字一律当「待补」，不按 0 处理。 */
function cardVal(city: any, field: string): number | null {
  const m = city && city.metrics ? city.metrics[field] : null;
  if (!m || typeof m !== 'object') return null;
  const v = m.v;
  return typeof v === 'number' && isFinite(v) ? v : null;
}

// 按上榜次数降序，同次数按拼音 slug 升序（稳定次序）
const list: { c: any; n: number }[] = [];
if (!CR.error) {
  for (let i = 0; i < CR.cities.length; i += 1) {
    const c = CR.cities[i];
    list.push({ c: c, n: cityMentionCount(CR, c.slug) });
  }
  list.sort((a, b) => {
    if (b.n !== a.n) return b.n - a.n;
    return String(a.c.slug).localeCompare(String(b.c.slug));
  });
}
let withMentions = 0;
for (let j = 0; j < list.length; j += 1) { if (list[j].n > 0) withMentions += 1; }

// 前 30 座做成榜单行；其余按省索引。城市不足 30 座时全部进榜，不产生空段。
const TOP_N = 30;
const topRows = list.slice(0, TOP_N);
const restRows = list.slice(TOP_N);

// 横条按榜首的次数换算：读者不用读 30 个数字就能看出谁靠前。
const maxMentions = topRows.length ? topRows[0].n : 0;
function barPct(n: number): number {
  if (!maxMentions) return 0;
  return Math.max(0, Math.round((n / maxMentions) * 100));
}

// 其余城市按省级行政区归组；没采集到归属的单列一组放最后
const byProv: Record<string, { c: any; n: number }[]> = {};
const provOrder: string[] = [];
for (let r = 0; r < restRows.length; r += 1) {
  const pvName = restRows[r].c.province || '归属待补';
  if (!byProv[pvName]) {
    byProv[pvName] = [];
    provOrder.push(pvName);
  }
  byProv[pvName].push(restRows[r]);
}
// 省份次序沿用 GB/T 2260 的列表（与首屏省份宫格一致），未知归属排末尾
const provs = CR.error ? [] : cityProvinces(CR);
const provNames: string[] = [];
for (let pv = 0; pv < provs.length; pv += 1) { provNames.push(provs[pv].name); }
provOrder.sort((a, b) => {
  let ia = provNames.indexOf(a); if (ia < 0) ia = 999;
  let ib = provNames.indexOf(b); if (ib < 0) ib = 999;
  if (ia !== ib) return ia - ib;
  return String(a).localeCompare(String(b), 'zh');
});

/* 省份卡上的短名：北京市 → 北京、广西壮族自治区 → 广西、中国台湾地区 → 台湾。
   四个字的全称在 4 列宫格里会折行，而省名折行后和数字挤在一起。 */
function shortProvName(name: string): string {
  return String(name || '')
    .replace(/^中国/, '')
    .replace(/(维吾尔|壮族|回族)自治区$/, '')
    .replace(/自治区$/, '')
    .replace(/特别行政区$/, '')
    .replace(/地区$/, '')
    .replace(/[省市]$/, '');
}

// 省份宫格的条形按「最省」为满格，读者不用读数字就能看出分布
let maxProvTotal = 0;
for (let pv2 = 0; pv2 < provs.length; pv2 += 1) {
  if (provs[pv2].total > maxProvTotal) maxProvTotal = provs[pv2].total;
}
function provPct(n: number): number {
  if (!maxProvTotal) return 0;
  return Math.max(4, Math.round((n / maxProvTotal) * 100));
}

/* 宫格按「在册城市数」从多到少排（2026-11-08 主人：按区划码排「排序也莫名奇妙」）。
   照 GB/T 2260 排时相邻格是 11 / 11 / 12 / 14 / 4 / 13——数字忽高忽低，
   条形读不出任何趋势，热力宫格就只剩噪声。同数量的按区划码次序，保证稳定且地理相邻。
   底部三列城市索引仍走区划码次序：那里是查地名，不是看分布。 */
const provsByCount = provs.slice().sort((a: any, b: any) => (b.total - a.total) || (a.code - b.code));

/* 直辖市与特别行政区单列（2026-11-08 主人：北上重港「最多也就一」，不该和省混在一张图上）。
   它们在册城市只有 1~2 座，放进 21 / 18 / 16 的省里，条形全是最短的一截，
   占着四列却读不出任何量级。
   按名称前缀判断而不是按区划码：港澳在数据里用的是合规全称「中国香港 / 中国澳门」，
   provinceNameCode() 认不出这两个名字，会整组落到 999。 */
const MUNI_NAMES = ['北京', '天津', '上海', '重庆', '香港', '澳门'];
function isMunicipality(p: any): boolean {
  const base = String(p && p.name || '').replace(/^中国/, '');
  for (let m = 0; m < MUNI_NAMES.length; m += 1) {
    if (base.indexOf(MUNI_NAMES[m]) === 0) return true;
  }
  return false;
}
const provsMain = provsByCount.filter((p: any) => !isMunicipality(p));
const provsMuni = provsByCount.filter((p: any) => isMunicipality(p));

const dataYear = CR.cityMeta?.dataYear || '2025';
const photos = data.cityphotos || {};
---

<BaseLayout title="城市档案" currentPath="/city/">
  <div class="paper-page cal-page cr-page">
    <div class="home-wrap">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href={urlFor('/library/')}>资料库</a><span aria-hidden="true">/</span><span class="cal-crumb-now">城市档案</span>
      </nav>

      {CR.error ? (
        <>
          <EmptyState>城市档案的数据还在整理中，暂时无法展示，欢迎稍后再来看看。</EmptyState>
          <Fragment set:html={`<!-- dev: ${CR.error} -->`} />
        </>
      ) : (
        <>
          <section class="cr-index-hero">
            <div class="cr-index-lead">
              <h1 class="cr-index-title">城市档案</h1>
              <p class="cr-index-lede">
                收录在本站榜单中出现过的城市。有权威来源的字段直接列出并标注年份，尚未采集到的一律标 <b>[待补]</b>，不做估算填充。
              </p>
              <StatBand
                columns={4}
                items={[
                  { label: '城市档案', value: list.length },
                  { label: '省级行政区', value: provs.length },
                  { label: '有上榜记录', value: withMentions },
                  { label: '数据年份', value: dataYear },
                ]}
              />
              <form class="cr-search" action={urlFor('/search/')} method="get" role="search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                <input type="search" name="q" placeholder="输入城市名，例如 苏州、成都" aria-label="搜索城市" />
                <button type="submit">搜索</button>
              </form>
            </div>

            {provs.length > 0 && (
              <div class="cr-index-aside">
                <div class="cr-sec-head">
                  <h2 class="cr-sec-title">按省级行政区</h2>
                  <p class="cr-sec-note">条形相对最大省级行政区</p>
                </div>
                <div class="cr-provgrid">
                  {provsMain.map((pv3: any) => {
                    // 只有一座城市的省级单位：中间的省级页只会再让人多按一次，
                    // 直接链到那座城市的档案页（2026-11-06 主人指出「上海市还要再点一下上海」）。
                    const pvHref = (pv3.total === 1 && pv3.pageCount === 1 && pv3.cities && pv3.cities.length)
                      ? '/city/' + pv3.cities[0].slug + '/'
                      : '/city/province/' + pv3.slug + '/';
                    return (
                      <a class="cr-provcard" href={urlFor(pvHref)}>
                        <span class="cr-provcard-top">
                          <span class="cr-provcard-name">{shortProvName(pv3.name)}</span>
                          <span class="cr-provcard-n">{pv3.total}</span>
                        </span>
                        <span class="cr-provcard-bar" aria-hidden="true"><i style={`width: ${provPct(pv3.total)}%`}></i></span>
                      </a>
                    );
                  })}
                </div>
                {provsMuni.length > 0 && (
                  <>
                    <h3 class="cr-subhead">直辖市与特别行政区</h3>
                    <div class="cr-provgrid cr-provgrid--flat">
                      {provsMuni.map((pv4: any) => {
                        // 这一组全是 1~2 座城市，条形没有可比对象，只留名字与数字。
                        const pvHref = (pv4.total === 1 && pv4.pageCount === 1 && pv4.cities && pv4.cities.length)
                          ? '/city/' + pv4.cities[0].slug + '/'
                          : '/city/province/' + pv4.slug + '/';
                        return (
                          <a class="cr-provcard" href={urlFor(pvHref)}>
                            <span class="cr-provcard-top">
                              <span class="cr-provcard-name">{shortProvName(pv4.name)}</span>
                              <span class="cr-provcard-n">{pv4.total}</span>
                            </span>
                          </a>
                        );
                      })}
                    </div>
                  </>
                )}
                <p class="cr-profile-note">按在册城市数从多到少排列，数量相同按 GB/T 2260 行政区划代码次序。直辖市与特别行政区城市极少，单独列出，不与省、自治区同尺度比较。行政归属尚未采集的城市不进省级聚合，仍可在下方索引中查看。</p>
              </div>
            )}
          </section>

          <section class="cr-sec-block">
            <h2 class="cr-sec-title">上榜最多的 {topRows.length} 座</h2>
            <p class="cr-sec-note">按在本站榜单中出现的次数排序，次数相同按拼音次序。横条以榜首次数为满格；人口为常住人口。</p>
            {/* 2026-11-08 三次改版（主人选 C）：30 城配图到位，榜单行换成 16:9 大图卡。
                11-06「排序键不能压在灰字里」的约束保留：名次做封面角标、
                上榜次数做正文首行大字 + 横条；3 / 2 / 1 列都是 30 的约数，末行不空。 */}
            <ol class="cr-tiles">
              {topRows.map((tr: any, t: number) => {
                const tc = tr.c;
                const gdp = cardVal(tc, 'gdp');
                const pop = cardVal(tc, 'pop');
                // 只有 cityphotos.yml 登记过的城市才出图；没图不放假图、不放灰块。
                const photo = photos[tc.slug];
                const rankLabel = String(t + 1).padStart(2, '0');
                return (
                  <li class="cr-tile">
                    <a href={urlFor('/city/' + tc.slug + '/')}>
                      <span class={`cr-tile-cover${photo ? '' : ' cr-tile-cover--none'}`}>
                        {photo ? (
                          <img class="cr-tile-photo" src={urlFor('/img/cities/' + tc.slug + '.jpg')} alt={tc.name + '城市景观'} width="1200" height="675" loading="lazy" decoding="async" />
                        ) : (
                          <span class="cr-tile-cover-name" aria-hidden="true">{tc.name}</span>
                        )}
                        <span class="cr-tile-rank">{rankLabel}</span>
                      </span>
                      <span class="cr-tile-body">
                        <span class="cr-tile-head">
                          <span class="cr-tile-name">{tc.name}</span>
                          <span class="cr-tile-meta">{tc.province || ''}{tc.province && tc.level ? ' · ' : ''}{tc.level || ''}</span>
                        </span>
                        <span class="cr-tile-key">
                          <b>{tr.n > 0 ? tr.n : '—'}</b><i>次上榜</i>
                          <span class="cr-tile-bar" aria-hidden="true"><span style={`width: ${barPct(tr.n)}%`}></span></span>
                        </span>
                        <span class="cr-tile-nums">
                          <span class="cr-tile-num"><b>{gdp === null ? '—' : fmtCardNum(gdp)}</b>{gdp !== null && <i>亿元</i>}</span>
                          <span class="cr-tile-num"><b>{pop === null ? '—' : fmtCardNum(pop)}</b>{pop !== null && <i>万人</i>}</span>
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>

          {restRows.length > 0 && (
            <section class="cr-sec-block">
              <h2 class="cr-sec-title">其余 {restRows.length} 座</h2>
              <p class="cr-sec-note">按省级行政区排列，点城市名进档案。</p>
              <div class="cr-index-cols">
                {provOrder.map((pName: string) => {
                  const pRows = byProv[pName];
                  return (
                    <div class="cr-index-group">
                      <span class="cr-index-pname">{pName} · {pRows.length}</span>
                      {pRows.map((qr: any) => (
                        <a href={urlFor('/city/' + qr.c.slug + '/')}>{qr.c.name}</a>
                      ))}
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          <div class="cal-after">
            <p class="cal-note">城市档案持续扩充中：先收录榜单里出现过的城市，再逐步补齐面积、气候、环境、公共服务等字段，每一项都要有权威来源才写入。</p>
          </div>
        </>
      )}
    </div>
  </div>
</BaseLayout>
