// 城市大类索引页（/city/）：复刻 themes/fluid/layout/cityindex.ejs 的 DOM。
//
// 2026-11-04 改版（PLAN-V3 §6）：原来把 431 座城市平铺成一列 431 行的名单，
// 读者滚到第 50 行就不知道自己在哪了，而且名单里城市之间没有任何可比的数字。
// 现在分两段：
//   ① 上榜最多的 30 座 → 榜单行（名次 / 城市·省·级别 / 上榜次数+横条 / GDP / 人口）
//   ② 其余按省份折叠 → 原生 <details>，不依赖 JS，无 JS 也能展开
//
// 2026-11-08 改版（PAGE-FORM-PLAN §4.0，主人从 A/B/C 三个样例里选 B「热力宫格」）：
// 这一页此前仍是「文章壳 + 34 行省名 + 29 个折叠目录」，可见文本 6509 字，比一篇博客还长。
// 现在改成：
//   ① 首屏 = 结论 + 四格数字带 + 城市名搜索（纯 GET 表单，落到 /search/?q=，不依赖 JS）
//      + 省份宫格（名称 / 在册城市数 / 相对最大省份的条形）
//   ② 30 座大图卡不变（2026-11-08 三次改版已验收）
//   ③ 其余城市由 <details> 折叠改三列索引，省名一行、城市名紧随其后
//
// 数据：source/_data/cities.yml + cityrank.yml；计算：src/lib/cityrank-data.ts

import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBand from '../../components/StatBand.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getData } from '../../lib/data';
import { buildCityRanks, cityMentionCount, cityProvinces } from '../../lib/cityrank-data';
import { chinaMapData } from '../../lib/china-map';
import { urlFor } from '../../lib/url';

const data = getData();
const CR = buildCityRanks(data);

/* 榜单里的数值统一加千分位（DESIGN-LANGUAGE §5.19）：1152822.4 读不出来，
   1,152,822.4 才读得出来。等宽栈下千分位不改变字宽节奏，只让位数可数。
   小数收到 1 位：GDP 的 2 位小数（24,763.61）是假精度，各城来源本身就在亿元级浮动。 */
function fmtCardNum(v: any): string {
  if (v === null || v === undefined || v === '') return '';
  if (typeof v !== 'number') return String(v);
  const s = String(Math.round(v * 10) / 10);
  const parts = s.split('.');
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return parts.join('.');
}

/* 取城市某个指标的数值。缺字段 / 值不是有限数字一律当「待补」，不按 0 处理。 */
function cardVal(city: any, field: string): number | null {
  const m = city && city.metrics ? city.metrics[field] : null;
  if (!m || typeof m !== 'object') return null;
  const v = m.v;
  return typeof v === 'number' && isFinite(v) ? v : null;
}

// 按上榜次数降序，同次数按拼音 slug 升序（稳定次序）
const list: { c: any; n: number }[] = [];
if (!CR.error) {
  for (let i = 0; i < CR.cities.length; i += 1) {
    const c = CR.cities[i];
    list.push({ c: c, n: cityMentionCount(CR, c.slug) });
  }
  list.sort((a, b) => {
    if (b.n !== a.n) return b.n - a.n;
    return String(a.c.slug).localeCompare(String(b.c.slug));
  });
}
let withMentions = 0;
for (let j = 0; j < list.length; j += 1) { if (list[j].n > 0) withMentions += 1; }

// 前 30 座做成榜单行；其余按省索引。城市不足 30 座时全部进榜，不产生空段。
const TOP_N = 30;
const topRows = list.slice(0, TOP_N);
const restRows = list.slice(TOP_N);

// 横条按榜首的次数换算：读者不用读 30 个数字就能看出谁靠前。
const maxMentions = topRows.length ? topRows[0].n : 0;
function barPct(n: number): number {
  if (!maxMentions) return 0;
  return Math.max(0, Math.round((n / maxMentions) * 100));
}

// 其余城市按省级行政区归组；没采集到归属的单列一组放最后
const byProv: Record<string, { c: any; n: number }[]> = {};
const provOrder: string[] = [];
for (let r = 0; r < restRows.length; r += 1) {
  const pvName = restRows[r].c.province || '归属待补';
  if (!byProv[pvName]) {
    byProv[pvName] = [];
    provOrder.push(pvName);
  }
  byProv[pvName].push(restRows[r]);
}
// 省份次序沿用 GB/T 2260 的列表（与首屏省份宫格一致），未知归属排末尾
const provs = CR.error ? [] : cityProvinces(CR);
const provNames: string[] = [];
for (let pv = 0; pv < provs.length; pv += 1) { provNames.push(provs[pv].name); }
provOrder.sort((a, b) => {
  let ia = provNames.indexOf(a); if (ia < 0) ia = 999;
  let ib = provNames.indexOf(b); if (ib < 0) ib = 999;
  if (ia !== ib) return ia - ib;
  return String(a).localeCompare(String(b), 'zh');
});

/* 省份卡上的短名：北京市 → 北京、广西壮族自治区 → 广西、中国台湾地区 → 台湾。
   四个字的全称在 4 列宫格里会折行，而省名折行后和数字挤在一起。 */
function shortProvName(name: string): string {
  return String(name || '')
    .replace(/^中国/, '')
    .replace(/(维吾尔|壮族|回族)自治区$/, '')
    .replace(/自治区$/, '')
    .replace(/特别行政区$/, '')
    .replace(/地区$/, '')
    .replace(/[省市]$/, '');
}

// 省份宫格的条形按「最省」为满格，读者不用读数字就能看出分布
let maxProvTotal = 0;
for (let pv2 = 0; pv2 < provs.length; pv2 += 1) {
  if (provs[pv2].total > maxProvTotal) maxProvTotal = provs[pv2].total;
}
function provPct(n: number): number {
  if (!maxProvTotal) return 0;
  return Math.max(4, Math.round((n / maxProvTotal) * 100));
}

/* 宫格按「在册城市数」从多到少排（2026-11-08 主人：按区划码排「排序也莫名奇妙」）。
   照 GB/T 2260 排时相邻格是 11 / 11 / 12 / 14 / 4 / 13——数字忽高忽低，
   条形读不出任何趋势，热力宫格就只剩噪声。同数量的按区划码次序，保证稳定且地理相邻。
   底部三列城市索引仍走区划码次序：那里是查地名，不是看分布。 */
const provsByCount = provs.slice().sort((a: any, b: any) => (b.total - a.total) || (a.code - b.code));

/* 直辖市与特别行政区单列（2026-11-08 主人：北上重港「最多也就一」，不该和省混在一张图上）。
   它们在册城市只有 1~2 座，放进 21 / 18 / 16 的省里，条形全是最短的一截，
   占着四列却读不出任何量级。
   按名称前缀判断而不是按区划码：港澳在数据里用的是合规全称「中国香港 / 中国澳门」，
   provinceNameCode() 认不出这两个名字，会整组落到 999。 */
const MUNI_NAMES = ['北京', '天津', '上海', '重庆', '香港', '澳门'];
function isMunicipality(p: any): boolean {
  const base = String(p && p.name || '').replace(/^中国/, '');
  for (let m = 0; m < MUNI_NAMES.length; m += 1) {
    if (base.indexOf(MUNI_NAMES[m]) === 0) return true;
  }
  return false;
}
function isOverseasProv(p: any): boolean {
  return !!(p && (p.slug === 'haiwai' || p.name === '海外'));
}
const provsMain = provsByCount.filter((p: any) => !isMunicipality(p) && !isOverseasProv(p));
const provsMuni = provsByCount.filter((p: any) => isMunicipality(p));
const provsOverseas = provsByCount.filter((p: any) => isOverseasProv(p));

const dataYear = CR.cityMeta?.dataYear || '2025';
const photos = data.cityphotos || {};

// 全量城市数据池（供前端按 GDP / 人口 / 地铁 / 高校 / 面积在全量 350 城中真实重排，绝不把无数据城市塞进榜单）
const fullPoolJson = JSON.stringify(
  list.map((row) => {
    const tc = row.c;
    const isOv = tc.province === '海外' || tc.region === '海外';
    return {
      slug: tc.slug,
      name: tc.name,
      meta: isOv ? '海外城市' : `${tc.province || ''}${tc.province && tc.level ? ' · ' : ''}${tc.level || ''}`,
      href: urlFor('/city/' + tc.slug + '/'),
      hasImg: Boolean(photos[tc.slug]),
      region: isOv ? '海外' : (tc.region || ''),
      mentions: row.n,
      gdp: cardVal(tc, 'gdp'),
      pop: cardVal(tc, 'pop'),
      metro: cardVal(tc, 'metro_km'),
      uni: cardVal(tc, 'universities'),
      area: cardVal(tc, 'area_km2'),
      scenic: isOv ? null : cardVal(tc, 'scenic_5a'),
    };
  })
);

// 构建交互式中国热力地图数据（复用 china-provinces.json 合规矢量路径）
const mapData = chinaMapData();
const provByShort: Record<string, any> = {};
for (const pv of provs) {
  provByShort[shortProvName(pv.name)] = pv;
}
function provHrefOf(pv: any): string {
  if (!pv) return '';
  return (pv.total === 1 && pv.pageCount === 1 && pv.cities && pv.cities.length)
    ? urlFor('/city/' + pv.cities[0].slug + '/')
    : urlFor('/city/province/' + pv.slug + '/');
}
const mapProvinces = mapData.provinces
  .filter((mp) => mp && mp.d)
  .map((mp) => {
    const short = shortProvName(mp.name);
    const pv = provByShort[short] || null;
    const total = pv ? pv.total : 0;
    const ratio = maxProvTotal > 0 ? total / maxProvTotal : 0;
    const heat = total === 0 ? 0 : ratio >= 0.72 ? 4 : ratio >= 0.42 ? 3 : ratio >= 0.16 ? 2 : 1;
    const sample = pv && Array.isArray(pv.cities)
      ? pv.cities.slice(0, 5).map((cc: any) => cc.name).join(' · ') + (pv.cities.length > 5 ? ' 等' : '')
      : '';
    return {
      adcode: mp.adcode,
      name: mp.name,
      short,
      d: mp.d,
      total,
      heat,
      href: provHrefOf(pv),
      sample,
      isDefault: pv && provsMain[0] && pv.slug === provsMain[0].slug,
    };
  });

// Top 30 城市实际覆盖的地理大区列表（按出现频次排序）
const regionCounts: Record<string, number> = {};
for (const tr of topRows) {
  const rg = tr.c.region ? String(tr.c.region) : '';
  if (rg) regionCounts[rg] = (regionCounts[rg] || 0) + 1;
}
const topRegions = Object.keys(regionCounts).sort((a, b) => regionCounts[b] - regionCounts[a]);
---

<BaseLayout title="城市档案" currentPath="/city/">
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>
  <div class="paper-page cal-page cr-page">
    <div class="home-wrap ab-page-shell city-v2 city-atlas">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href={urlFor('/library/')}>资料库</a><span aria-hidden="true">/</span><span class="cal-crumb-now">城市档案</span>
      </nav>

      {CR.error ? (
        <>
          <EmptyState>城市档案的数据还在整理中，暂时无法展示，欢迎稍后再来看看。</EmptyState>
          <Fragment set:html={`<!-- dev: ${CR.error} -->`} />
        </>
      ) : (
        <>
          <section class="cr-index-hero">
            <div class="cr-index-lead">
              <h1 class="cr-index-title">城市档案</h1>
              <p class="cr-index-lede">
                收录本站各城市榜单中出现过的城市档案，按地区生产总值、常住人口、轨交里程与高校数等实测指标整理。
              </p>
              <StatBand
                columns={4}
                items={[
                  { label: '城市档案', value: list.length },
                  { label: '省级行政区', value: provs.length },
                  { label: '有上榜记录', value: withMentions },
                  { label: '数据年份', value: dataYear },
                ]}
              />
              <form class="cr-search" action={urlFor('/search/')} method="get" role="search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                <input type="search" name="q" placeholder="输入城市名，例如 苏州、成都" aria-label="搜索城市" />
                <button type="submit">搜索</button>
              </form>
            </div>

            {provs.length > 0 && (
              <div class="cr-index-aside ca-aside">
                <div class="ca-aside-head">
                  <div class="cr-sec-head">
                    <h2 class="cr-sec-title">按省级行政区</h2>
                    <p class="cr-sec-note">悬停看省份档案，点击直达</p>
                  </div>
                  <div class="ca-view-tabs" role="tablist" aria-label="切换地图或宫格视图">
                    <button type="button" class="ca-view-tab is-active" role="tab" aria-selected="true" data-atlas-view="map">交互地图</button>
                    <button type="button" class="ca-view-tab" role="tab" aria-selected="false" data-atlas-view="grid">热力宫格</button>
                  </div>
                </div>

                {/* 视图 1：交互式中国热力地图（默认展示） */}
                <div class="ca-pane is-active" data-atlas-pane="map">
                  <div class="ca-map-stage">
                    <svg class="ca-map-svg" viewBox={mapData.viewBox} role="img" aria-label="中国省级行政区在册城市分布热力地图">
                      <g class="ca-map-provs">
                        {mapProvinces.map((mp) => (
                          <path
                            class={`ca-prov ca-heat-${mp.heat}`}
                            d={mp.d}
                            data-map-prov={mp.adcode}
                            data-map-name={mp.short}
                            data-map-count={mp.total}
                            data-map-sample={mp.sample}
                            data-map-href={mp.href}
                            data-map-default={mp.isDefault ? 'true' : undefined}
                            tabindex={mp.href ? '0' : undefined}
                            role={mp.href ? 'link' : undefined}
                            aria-label={`${mp.name}：${mp.total} 座城市`}
                          >
                            <title>{mp.short} · {mp.total} 座城市</title>
                          </path>
                        ))}
                      </g>
                      {mapData.nineDash && (
                        <path class="ca-nine-dash" d={mapData.nineDash} />
                      )}
                    </svg>
                    <div class="ca-map-legend" aria-hidden="true">
                      <span>少</span>
                      <i class="ca-lg-1" /><i class="ca-lg-2" /><i class="ca-lg-3" /><i class="ca-lg-4" />
                      <span>多</span>
                    </div>
                  </div>
                  <div class="ca-readout" aria-live="polite">
                    <div class="ca-readout-top">
                      <strong class="ca-readout-name" data-map-name>—</strong>
                      <span class="ca-readout-count" data-map-count>—</span>
                      <a class="ca-readout-go" data-map-go href={urlFor('/city/')} hidden>查看该省档案 →</a>
                    </div>
                    <p class="ca-readout-cities" data-map-cities>移动光标至地图任意省份查看代表城市</p>
                  </div>
                </div>

                {/* 视图 2：既有省份热力宫格（保留完整 DOM，无 JS 或切换即可浏览） */}
                <div class="ca-pane" data-atlas-pane="grid" hidden>
                  <div class="cr-provgrid">
                    {provsMain.map((pv3: any) => {
                      const pvHref = (pv3.total === 1 && pv3.pageCount === 1 && pv3.cities && pv3.cities.length)
                        ? '/city/' + pv3.cities[0].slug + '/'
                        : '/city/province/' + pv3.slug + '/';
                      return (
                        <a class="cr-provcard" href={urlFor(pvHref)}>
                          <span class="cr-provcard-top">
                            <span class="cr-provcard-name">{shortProvName(pv3.name)}</span>
                            <span class="cr-provcard-n">{pv3.total}</span>
                          </span>
                          <span class="cr-provcard-bar" aria-hidden="true"><i style={`width: ${provPct(pv3.total)}%`}></i></span>
                        </a>
                      );
                    })}
                  </div>
                  {provsMuni.length > 0 && (
                    <>
                      <h3 class="cr-subhead">直辖市与特别行政区</h3>
                      <div class="cr-provgrid cr-provgrid--flat">
                        {provsMuni.map((pv4: any) => {
                          const pvHref = (pv4.total === 1 && pv4.pageCount === 1 && pv4.cities && pv4.cities.length)
                            ? '/city/' + pv4.cities[0].slug + '/'
                            : '/city/province/' + pv4.slug + '/';
                          return (
                            <a class="cr-provcard" href={urlFor(pvHref)}>
                              <span class="cr-provcard-top">
                                <span class="cr-provcard-name">{shortProvName(pv4.name)}</span>
                                <span class="cr-provcard-n">{pv4.total}</span>
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    </>
                  )}
                  {provsOverseas.length > 0 && (
                    <>
                      <h3 class="cr-subhead">海外城市</h3>
                      <div class="cr-provgrid cr-provgrid--flat">
                        {provsOverseas.map((pv5: any) => (
                          <a class="cr-provcard ca-overseas-card" href={urlFor('/city/province/' + pv5.slug + '/')}>
                            <span class="cr-provcard-top">
                              <span class="ca-overseas-name">{shortProvName(pv5.name)}</span>
                              <span class="ca-overseas-n">{pv5.total}</span>
                            </span>
                          </a>
                        ))}
                      </div>
                    </>
                  )}
                </div>
              </div>
            )}
          </section>

          <section class="cr-sec-block ca-top-sec">
            <div class="ca-top-head">
              <div>
                <h2 class="cr-sec-title">上榜最多的 {topRows.length} 座</h2>
                <p class="cr-sec-note" data-filter-count>共 {topRows.length} 座 · 按「上榜次数」排序（可切换指标重排或勾选 2–3 城同屏 PK）</p>
              </div>
              <div class="ca-presets" aria-label="热门城市对比预设">
                <span class="ca-presets-label">快捷 PK</span>
                <button type="button" class="ca-preset-btn" data-pk-preset="beijing,shanghai,shenzhen">京 · 沪 · 深</button>
                <button type="button" class="ca-preset-btn" data-pk-preset="chengdu,hangzhou,wuhan">成 · 杭 · 汉</button>
              </div>
            </div>

            <div class="ca-toolbar" aria-label="排序与分区筛选">
              <div class="ca-sort-group" role="group" aria-label="按指标实时排序">
                <span class="ca-tb-label">排序</span>
                <button type="button" class="ca-pill is-active" data-sort-metric="mentions" aria-pressed="true">上榜次数</button>
                <button type="button" class="ca-pill" data-sort-metric="gdp" aria-pressed="false">GDP</button>
                <button type="button" class="ca-pill" data-sort-metric="pop" aria-pressed="false">常住人口</button>
                <button type="button" class="ca-pill" data-sort-metric="metro" aria-pressed="false">地铁里程</button>
                <button type="button" class="ca-pill" data-sort-metric="uni" aria-pressed="false">高校数</button>
                <button type="button" class="ca-pill" data-sort-metric="area" aria-pressed="false">行政面积</button>
              </div>
              {topRegions.length > 1 && (
                <div class="ca-region-group" role="group" aria-label="按地理大区筛选">
                  <span class="ca-tb-label">大区</span>
                  <button type="button" class="ca-pill is-active" data-filter-region="all" aria-pressed="true">全部</button>
                  {topRegions.map((rg) => (
                    <button type="button" class="ca-pill" data-filter-region={rg} aria-pressed="false">{rg}</button>
                  ))}
                </div>
              )}
            </div>

            <ol class="cr-tiles" data-city-tiles>
              {topRows.map((tr: any, t: number) => {
                const tc = tr.c;
                const gdp = cardVal(tc, 'gdp');
                const pop = cardVal(tc, 'pop');
                const metro = cardVal(tc, 'metro_km');
                const uni = cardVal(tc, 'universities');
                const area = cardVal(tc, 'area_km2');
                const scenic = cardVal(tc, 'scenic_5a');
                const photo = photos[tc.slug];
                const imgSrc = photo ? urlFor('/img/cities/' + tc.slug + '.jpg') : '';
                const rankLabel = String(t + 1).padStart(2, '0');
                const metaText = `${tc.province || ''}${tc.province && tc.level ? ' · ' : ''}${tc.level || ''}`;
                return (
                  <li
                    class="cr-tile"
                    data-slug={tc.slug}
                    data-name={tc.name}
                    data-meta={metaText}
                    data-href={urlFor('/city/' + tc.slug + '/')}
                    data-region={tc.region || ''}
                    data-mentions={tr.n}
                    data-gdp={gdp ?? ''}
                    data-pop={pop ?? ''}
                    data-metro={metro ?? ''}
                    data-uni={uni ?? ''}
                    data-area={area ?? ''}
                    data-scenic={scenic ?? ''}
                  >
                    <button type="button" class="ca-pk-btn" data-pk-toggle={tc.slug} aria-pressed="false">+ 对比</button>
                    <a href={urlFor('/city/' + tc.slug + '/')}>
                      <span class={`cr-tile-cover${photo ? '' : ' cr-tile-cover--none'}`}>
                        {photo ? (
                          <img class="cr-tile-photo" src={imgSrc} alt={tc.name + '城市景观'} width="1200" height="675" loading="lazy" decoding="async" />
                        ) : (
                          <span class="cr-tile-cover-name" aria-hidden="true">{tc.name}</span>
                        )}
                        <span class="cr-tile-rank">{rankLabel}</span>
                      </span>
                      <span class="cr-tile-body">
                        <span class="cr-tile-head">
                          <span class="cr-tile-name">{tc.name}</span>
                          <span class="cr-tile-meta">{metaText}</span>
                        </span>
                        <span class="cr-tile-key">
                          <b data-key-val>{tr.n > 0 ? tr.n : '—'}</b><i data-key-unit>次上榜</i>
                          <span class="cr-tile-bar" aria-hidden="true"><span data-key-bar style={`width: ${barPct(tr.n)}%`}></span></span>
                        </span>
                        <span class="cr-tile-nums">
                          <span class="cr-tile-num"><b>{gdp === null ? '—' : fmtCardNum(gdp)}</b>{gdp !== null && <i>亿元</i>}</span>
                          <span class="cr-tile-num"><b>{pop === null ? '—' : fmtCardNum(pop)}</b>{pop !== null && <i>万人</i>}</span>
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>

          {restRows.length > 0 && (
            <section class="cr-sec-block">
              <h2 class="cr-sec-title">其余 {restRows.length} 座</h2>
              <p class="cr-sec-note">按省级行政区排列，点城市名进档案。</p>
              <div class="cr-index-cols">
                {provOrder.map((pName: string) => {
                  const pRows = byProv[pName];
                  return (
                    <div class="cr-index-group">
                      <span class="cr-index-pname">{pName} · {pRows.length}</span>
                      {pRows.map((qr: any) => (
                        <a href={urlFor('/city/' + qr.c.slug + '/')}>{qr.c.name}</a>
                      ))}
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          <div class="cal-after">
            <p class="cal-note">城市档案持续扩充中：先收录榜单里出现过的城市，再逐步补齐面积、气候、环境、公共服务等字段，每一项都要有权威来源才写入。</p>
          </div>
        </>
      )}
    </div>
  </div>

  <!-- 底部多城对比托盘 -->
  <div class="cpk-dock" id="city-pk-dock" role="region" aria-label="城市对比栏" hidden>
    <div class="cpk-dock-in">
      <div class="cpk-dock-chips" data-pk-chips />
      <div class="cpk-dock-acts">
        <button type="button" class="cpk-clear" data-pk-clear>清空</button>
        <button type="button" class="cpk-run" data-pk-open disabled>同屏对比</button>
      </div>
    </div>
  </div>

  <!-- 多城 PK 对比原生 <dialog> -->
  <dialog class="cpk-dialog" id="city-pk-dialog" aria-labelledby="cpk-d-title">
    <div class="cpk-d-in">
      <div class="cpk-d-head">
        <div>
          <p class="cpk-d-kicker">CITY COMPARISON · 真实指标同屏对比</p>
          <h2 class="cpk-d-title" id="cpk-d-title">城市多维对比</h2>
        </div>
        <button type="button" class="cpk-d-close" data-pk-close aria-label="关闭对比">关闭</button>
      </div>
      <div data-pk-body />
    </div>
  </dialog>

  <script type="application/json" id="city-atlas-pool" set:html={fullPoolJson} />
  <script defer src="/js/city-atlas.js"></script>

  <style is:global>
    .city-v2 .cr-index-hero{position:relative;padding-top:.4rem;padding-bottom:2.2rem;border-bottom:1px solid var(--line-color);align-items:start}
    .city-v2 .cr-index-title{font-family:var(--font-serif-title);font-size:clamp(2.2rem,4.6vw,3.4rem);line-height:1.08;letter-spacing:-0.02em}
    .city-v2 .cr-search{border-radius:999px}
    .ca-aside{display:flex;flex-direction:column;gap:.85rem}
    .ca-aside-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem}
    .ca-aside-head .cr-sec-head{margin:0}
    .ca-view-tabs{display:inline-flex;gap:.2rem;padding:.2rem;border:1px solid var(--line-color);border-radius:999px;background:var(--surface-tint)}
    .ca-view-tab{padding:.26rem .72rem;border:0;border-radius:999px;background:transparent;color:var(--sec-text-color);font-family:var(--font-mono);font-size:.75rem;cursor:pointer;transition:background-color 160ms ease,color 160ms ease}
    .ca-view-tab.is-active{background:var(--accent);color:#fff;font-weight:700}
    .ca-map-stage{position:relative;padding:.85rem 1rem .7rem;border:1px solid var(--line-color);border-radius:var(--r-sm);background:var(--surface-tint)}
    .ca-map-svg{width:100%;height:auto;display:block;max-height:360px}
    .ca-prov{stroke:var(--body-bg-color);stroke-width:.16;stroke-linejoin:round;cursor:pointer;transition:fill 180ms ease,opacity 180ms ease,stroke-width 180ms ease}
    .ca-heat-0{fill:color-mix(in srgb,var(--text-color) 6%,var(--body-bg-color))}
    .ca-heat-1{fill:color-mix(in srgb,var(--accent) 20%,var(--body-bg-color))}
    .ca-heat-2{fill:color-mix(in srgb,var(--accent) 42%,var(--body-bg-color))}
    .ca-heat-3{fill:color-mix(in srgb,var(--accent) 68%,var(--body-bg-color))}
    .ca-heat-4{fill:var(--accent)}
    .ca-map-provs:hover .ca-prov:not(:hover):not(.is-active){opacity:.62}
    .ca-prov:hover,.ca-prov.is-active{fill:var(--accent-strong,var(--accent));stroke:var(--text-color);stroke-width:.28;opacity:1}
    .ca-nine-dash{fill:none;stroke:var(--info-mark);stroke-width:.14;stroke-dasharray:.55 .4;stroke-linecap:round;pointer-events:none}
    .ca-map-legend{position:absolute;left:.95rem;bottom:.7rem;display:inline-flex;align-items:center;gap:4px;font-family:var(--font-mono);font-size:.72rem;color:var(--info-mark)}
    .ca-map-legend i{display:inline-block;width:14px;height:6px;border-radius:2px}
    .ca-lg-1{background:color-mix(in srgb,var(--accent) 20%,var(--body-bg-color))}
    .ca-lg-2{background:color-mix(in srgb,var(--accent) 42%,var(--body-bg-color))}
    .ca-lg-3{background:color-mix(in srgb,var(--accent) 68%,var(--body-bg-color))}
    .ca-lg-4{background:var(--accent)}
    .ca-readout{margin-top:.7rem;padding:.75rem .95rem;border:1px solid var(--line-color);border-radius:var(--r-sm);background:transparent}
    .ca-readout-top{display:flex;flex-wrap:wrap;align-items:baseline;gap:.55rem .9rem}
    .ca-readout-name{font-family:var(--font-serif-title);font-size:1.05rem;color:var(--text-color)}
    .ca-readout-count{font-family:var(--font-mono);font-size:.78rem;font-weight:700;color:var(--accent)}
    .ca-readout-go{margin-left:auto;font-family:var(--font-mono);font-size:.78rem;font-weight:700;color:var(--accent);text-decoration:none}
    .ca-readout-go:hover{text-decoration:underline;text-underline-offset:3px}
    .ca-readout-cities{margin:.35rem 0 0;font-size:.82rem;color:var(--sec-text-color)}
    .city-v2 .cr-provcard{border-radius:var(--r-sm);border:1px solid var(--line-color);background:transparent;transition:border-color 180ms ease,transform 200ms cubic-bezier(.22,1,.36,1),opacity 200ms ease}
    .city-v2 .cr-provgrid:hover .cr-provcard:not(:hover){opacity:.58}
    .city-v2 .cr-provcard:hover{border-color:var(--accent);transform:translateY(-2px)}
    .city-v2 .cr-provcard:hover .cr-provcard-name,.city-v2 .ca-overseas-card:hover .ca-overseas-name{color:var(--accent)}
    .ca-overseas-name{font-size:.86rem;font-weight:600;color:var(--text-color)}
    .ca-overseas-n{font-family:var(--font-mono);font-size:.78rem;color:var(--info-mark)}
    /* Top 30 控制台与卡片对比钮 */
    .ca-top-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:.9rem 1.4rem;margin-bottom:1.1rem}
    .ca-top-head .cr-sec-title,.ca-top-head .cr-sec-note{margin-bottom:0}
    .ca-presets{display:inline-flex;flex-wrap:wrap;align-items:center;gap:.45rem}
    .ca-presets-label,.ca-tb-label{font-family:var(--font-mono);font-size:.75rem;color:var(--info-mark);margin-right:.15rem}
    .ca-preset-btn{padding:.26rem .72rem;border:1px dashed var(--accent);border-radius:999px;background:transparent;color:var(--accent);font-family:var(--font-mono);font-size:.75rem;font-weight:600;cursor:pointer;transition:background-color 160ms ease,color 160ms ease}
    .ca-preset-btn:hover{background:var(--accent);color:#fff}
    .ca-toolbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.7rem 1.4rem;margin-bottom:1.35rem;padding:.75rem 0;border-top:1px solid var(--line-color);border-bottom:1px solid var(--line-color)}
    .ca-sort-group,.ca-region-group{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem}
    .ca-pill{padding:.24rem .68rem;border:1px solid var(--line-color);border-radius:999px;background:transparent;color:var(--sec-text-color);font-family:var(--font-mono);font-size:.76rem;cursor:pointer;transition:border-color 160ms ease,color 160ms ease,background-color 160ms ease}
    .ca-pill:hover{border-color:var(--accent);color:var(--accent)}
    .ca-pill.is-active{border-color:var(--accent);background:var(--accent);color:#fff;font-weight:600}
    .city-atlas .cr-tile{position:relative;border-radius:var(--r-sm);overflow:hidden;transition:border-color 200ms ease,transform 240ms cubic-bezier(.22,1,.36,1)}
    .city-atlas .cr-tile:hover{transform:translateY(-3px)}
    .city-atlas .cr-tile.is-pk-picked{outline:2px solid var(--accent);outline-offset:2px}
    .city-atlas .cr-tile .cr-tile-bar span{transition:width 360ms cubic-bezier(.22,1,.36,1)}
    .ca-pk-btn{position:absolute;top:.6rem;right:.6rem;z-index:3;padding:.2rem .58rem;border:1px solid rgba(255,255,255,.35);border-radius:999px;background:rgba(18,16,14,.68);backdrop-filter:blur(6px);color:#fff;font-family:var(--font-mono);font-size:.75rem;cursor:pointer;transition:background-color 160ms ease,border-color 160ms ease}
    .ca-pk-btn:hover,.ca-pk-btn[aria-pressed="true"]{background:var(--accent);border-color:var(--accent)}
    /* 底部对比托盘 */
    .cpk-dock{position:fixed;left:50%;bottom:1.25rem;transform:translateX(-50%);z-index:60;width:min(94vw,680px);padding:.65rem 1rem;border:1px solid var(--line-color);border-radius:999px;background:var(--body-bg-color);box-shadow:var(--site-float-shadow)}
    .cpk-dock-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.65rem}
    .cpk-dock-chips{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem}
    .cpk-chip{display:inline-flex;align-items:center;gap:.35rem;padding:.22rem .65rem;border-radius:999px;background:var(--surface-tint);border:1px solid var(--line-color);font-family:var(--font-mono);font-size:.78rem;color:var(--text-color)}
    .cpk-chip button{border:0;background:transparent;color:var(--info-mark);font-size:.95rem;line-height:1;cursor:pointer;padding:0 2px}
    .cpk-chip button:hover{color:var(--accent)}
    .cpk-dock-acts{display:inline-flex;align-items:center;gap:.5rem;margin-left:auto}
    .cpk-clear{padding:.3rem .65rem;border:0;background:transparent;color:var(--info-mark);font-family:var(--font-mono);font-size:.78rem;cursor:pointer}
    .cpk-clear:hover{color:var(--accent)}
    .cpk-run{padding:.38rem .95rem;border:0;border-radius:999px;background:var(--accent);color:#fff;font-family:var(--font-mono);font-size:.78rem;font-weight:700;cursor:pointer}
    .cpk-run:disabled{opacity:.48;cursor:not-allowed}
    /* 对比原生 <dialog> */
    .cpk-dialog{width:min(94vw,760px);max-height:88vh;padding:0;border:1px solid var(--line-color);border-radius:var(--r-sm);background:var(--body-bg-color);color:var(--text-color);box-shadow:var(--site-float-shadow)}
    .cpk-dialog::backdrop{background:var(--surface-ink);opacity:.68}
    .cpk-d-in{padding:1.4rem 1.5rem 1.6rem}
    .cpk-d-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;padding-bottom:.9rem;border-bottom:1px solid var(--line-color)}
    .cpk-d-kicker{margin:0 0 .2rem;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.12em;color:var(--accent)}
    .cpk-d-title{margin:0;font-family:var(--font-serif-title);font-size:1.45rem;font-weight:600}
    .cpk-d-close{padding:.26rem .75rem;border:1px solid var(--line-color);border-radius:999px;background:transparent;color:var(--text-color);font-family:var(--font-mono);font-size:.78rem;cursor:pointer}
    .cpk-d-close:hover{border-color:var(--accent);color:var(--accent)}
    .cpk-cards{display:grid;gap:.85rem;margin-bottom:1.35rem}
    .cpk-head-card{display:flex;flex-direction:column;gap:.45rem;text-decoration:none;color:inherit;border:1px solid var(--line-color);border-radius:var(--r-sm);overflow:hidden;padding-bottom:.55rem;transition:border-color 180ms ease}
    .cpk-head-card:hover{border-color:var(--accent)}
    .cpk-head-card img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
    .cpk-head-info{padding:0 .65rem;display:flex;flex-direction:column;gap:.12rem}
    .cpk-head-info b{font-family:var(--font-serif-title);font-size:1rem;color:var(--text-color)}
    .cpk-head-info span{font-family:var(--font-mono);font-size:.75rem;color:var(--info-mark)}
    .cpk-metrics{display:flex;flex-direction:column;gap:1rem}
    .cpk-metric-label{margin-bottom:.42rem;font-family:var(--font-mono);font-size:.76rem;font-weight:700;color:var(--info-mark)}
    .cpk-bars{display:flex;flex-direction:column;gap:.38rem}
    .cpk-bar-row{display:grid;grid-template-columns:4.2rem minmax(0,1fr) 6.5rem;align-items:center;gap:.65rem;font-size:.82rem}
    .cpk-bar-city{font-weight:600;color:var(--sec-text-color);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .cpk-bar-track{display:block;height:8px;border-radius:999px;background:var(--surface-tint);overflow:hidden}
    .cpk-bar-track i{display:block;height:100%;border-radius:999px;background:color-mix(in srgb,var(--text-color) 28%,transparent);transition:width 360ms cubic-bezier(.22,1,.36,1)}
    .cpk-bar-val{font-family:var(--font-mono);font-size:.78rem;text-align:right;color:var(--sec-text-color);white-space:nowrap}
    .cpk-bar-row.is-lead .cpk-bar-city,.cpk-bar-row.is-lead .cpk-bar-val{color:var(--accent);font-weight:700}
    .cpk-bar-row.is-lead .cpk-bar-track i{background:var(--accent)}
    @media (max-width:767.98px){.cpk-dock{border-radius:var(--r-sm)}.cpk-bar-row{grid-template-columns:3.5rem minmax(0,1fr) 5.5rem}}
    @media (prefers-reduced-motion:reduce){.ca-prov,.ca-tile,.ca-tile .cr-tile-bar span,.cpk-bar-track i{transition:none}}
  </style>
</BaseLayout>
