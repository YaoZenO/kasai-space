---
// 标签总览页：复刻 tags.ejs（真实标签与真实计数）

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getTags } from '../../lib/posts';
import { t } from '../../lib/i18n';

const title = t('tag').title;
const tags = getTags();
---

<BaseLayout title={title} currentPath="/tags/" markdownPlugins={false}>
  <div class="paper-page">
    <div class="home-wrap">
      <PageHead kicker="TAGS" title="标签" />

      {tags.length > 0 && (
        <ul class="tag-cloud">
          {tags.map(tag => (
            <li class="tag-chip">
              <a class="tag-chip-name" href={tag.href}>
                # {tag.name}
              </a>
              <span class="tag-chip-count">{tag.posts.length}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
