---
// 关键词详情页（/tags/<tag>/）：名称 + N 篇 + 跨度，列表语言与文字索引页一致。
import ArchiveView from '../../components/ArchiveView.astro';
import { getTags } from '../../lib/posts';
import { zhCN } from '../../lib/i18n';

export function getStaticPaths() {
  return getTags().map(tag => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: tag.posts },
  }));
}

const { name, posts } = Astro.props;
---

<ArchiveView posts={posts} heading={`# ${name}`} pageTitle={`${zhCN.tag.title} - ${name}`} activeTab="tags" />
