---
// 文章详情页：复刻 themes/fluid/layout/post.ejs（纸面档案版式）。
// 正文 HTML 由 src/lib/markdown.ts 用 Hexo 同款渲染器产出，直接 set:html 注入。

import BaseLayout from './BaseLayout.astro';
import MarkdownPlugins from '../components/MarkdownPlugins.astro';
import { siteConfig, themeConfig } from '../lib/site-config';
import { formatWithPattern } from '../lib/dates';
import { getPrevNext, taxonomyHref, type Post } from '../lib/posts';
import { zhCN } from '../lib/i18n';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const cfg = themeConfig.post || {};
const metaCfg = cfg.meta || {};
const copyrightCfg = cfg.copyright || {};
const tocCfg = cfg.toc || {};
const { prev, next } = getPrevNext(post);

/** moment 的 'LL' 在 zh-CN 下是「2026年4月18日」（月/日不补零） */
function longDate(d: Date): string {
  return `${formatWithPattern(d, 'YYYY')}年${Number(formatWithPattern(d, 'MM'))}月${Number(
    formatWithPattern(d, 'DD')
  )}日`;
}

const postUrl = `${siteConfig.url}${post.href}`;
const license = String(copyrightCfg.license || 'BY').toUpperCase();
const licenseItems = license.split('-');
// Hexo 主题的 symbolsCount：>9999 → 11k，>999 → 1.1k
function symbolsCount(count: number): string {
  if (count > 9999) return Math.round(count / 1000) + 'k';
  if (count > 999) return Math.round(count / 100) / 10 + 'k';
  return String(count);
}
// 修复 E-028 同类静默问题：pageWordCount 超过 999 时是 '2.6k'，Number('2.6k') 为 NaN 导致字数消失。
// 改为直接判断原始数值 post.wordcount >= 50。
const pageWordCount = symbolsCount(post.wordcount);
const showWordCount = metaCfg.wordcount?.enable !== false && post.wordcount >= 50;
const showMin2Read = metaCfg.min2read?.enable !== false && post.wordcount >= 50;
const showToc = tocCfg.enable !== false && tocCfg.placement !== 'left';
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  descriptionPreformatted={true}
  ogType="article"
  ogDate={post.date}
  ogUpdated={post.updated}
  ogKeywords={post.tags}
  markdownPlugins={true}
>
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>

  <div class="paper-page ab-page-shell rr-page">
    <div class="post-wrap">
      <nav class="rr-crumb" aria-label="面包屑">
        <a href="/archives/">文字</a>
        {post.categories[0] && (
          <>
            <span aria-hidden="true">/</span>
            <a href={taxonomyHref('categories', post.categories[0])}>{post.categories[0]}</a>
          </>
        )}
        <button type="button" class="rr-focus-btn rr-focus-btn--top" data-rr-focus aria-pressed="false">
          <span class="rr-focus-dot" aria-hidden="true" />
          <span data-rr-focus-label>专注阅读</span>
        </button>
      </nav>

      <div class="post-grid">
        <div class="post-main-col" id="board-ctn">
          <article class="post-content">
            <header class="post-head rr-post-head">
              <p class="post-head-kicker">MANUSCRIPT · {post.categories[0] || 'POST'}</p>
              <h1 class="post-head-title">{post.title}</h1>
              {/* blurb 是 Post 的顶层字段（src/lib/posts.ts），没有 post.data 这一层。
                  写成 post.data?.blurb 时条件恒假，导语静默不显示——见 E-191。 */}
              {post.blurb && <p class="post-head-blurb">{post.blurb}</p>}
              <div class="post-head-meta rr-meta-bar">
                {metaCfg.date?.enable !== false && (
                  <span class="rr-meta-item">
                    <time datetime={formatWithPattern(post.date, 'YYYY-MM-DD HH:mm')} pubdate>
                      {formatWithPattern(post.date, String(metaCfg.date?.format || 'YYYY-MM-DD'))}
                    </time>
                  </span>
                )}
                {showWordCount && (
                  <span class="rr-meta-item">
                    {zhCN.post.meta.wordcount.replace('%s', pageWordCount)}
                  </span>
                )}
                {showMin2Read && (
                  <span class="rr-meta-item">
                    {zhCN.post.meta.min2read.replace('%s', String(post.min2read))}
                  </span>
                )}
                {post.categories.length > 0 && (
                  <span class="post-head-cats rr-meta-cats">
                    <span class="category-chains">
                      {post.categories
                        .slice()
                        .sort((a, b) => a.localeCompare(b, 'zh-Hans-CN'))
                        .map(name => (
                          <span class="category-chain">
                            <a href={taxonomyHref('categories', name)} class="category-chain-item">
                              {name.trim()}
                            </a>
                          </span>
                        ))}
                    </span>
                  </span>
                )}
                {post.tags.length > 0 && (
                  <span class="post-head-tags rr-meta-tags">
                    {post.tags.map(tag => (
                      <a href={taxonomyHref('tags', tag)}>#{tag}</a>
                    ))}
                  </span>
                )}
              </div>
            </header>

            <div class="markdown-body" set:html={post.content} />

            <div class="post-foot rr-post-foot">
              {copyrightCfg.enable && (
                <div class="license-box rr-colophon">
                  <div class="rr-colophon-row">
                    <span class="rr-colophon-title">{post.title}</span>
                    <button type="button" class="rr-copy-link" data-copy={postUrl}>复制本文链接</button>
                  </div>
                  <dl class="rr-colophon-meta">
                    {copyrightCfg.author?.enable !== false && siteConfig.author && (
                      <div><dt>{zhCN.post.copyright.author}</dt><dd>{siteConfig.author}</dd></div>
                    )}
                    {copyrightCfg.post_date?.enable !== false && (
                      <div><dt>{zhCN.post.copyright.posted}</dt><dd>{longDate(post.date)}</dd></div>
                    )}
                    {license && (
                      <div>
                        <dt>{zhCN.post.copyright.licensed}</dt>
                        <dd>
                          {['BY', 'BY-SA', 'BY-ND', 'BY-NC', 'BY-NC-SA', 'BY-NC-ND'].includes(license) ? (
                            <a
                              class="print-no-link"
                              target="_blank"
                              href={`https://creativecommons.org/licenses/${license.toLowerCase()}/4.0/`}
                              rel="noopener"
                            >
                              CC {license} 4.0 ↗
                            </a>
                          ) : license === 'ZERO' ? (
                            <a
                              class="print-no-link"
                              target="_blank"
                              href="https://creativecommons.org/publicdomain/zero/1.0/"
                              rel="noopener"
                            >
                              CC0 1.0 ↗
                            </a>
                          ) : (
                            license
                          )}
                        </dd>
                      </div>
                    )}
                  </dl>
                </div>
              )}

              <nav class="post-prevnext rr-prevnext" aria-label="前后篇文章">
                <div class="rr-pn-slot">
                  {prev && (
                    <a class="rr-pn-link" href={prev.href} title={prev.title}>
                      <span class="rr-pn-kicker">← 上一篇</span>
                      <span class="rr-pn-title">{prev.title}</span>
                    </a>
                  )}
                </div>
                <div class="rr-pn-slot rr-pn-slot--next">
                  {next && (
                    <a class="rr-pn-link" href={next.href} title={next.title}>
                      <span class="rr-pn-kicker">下一篇 →</span>
                      <span class="rr-pn-title">{next.title}</span>
                    </a>
                  )}
                </div>
              </nav>

              <p class="post-home-link rr-back-row">
                <a href="/archives/">← 返回全部文字</a>
                <a href="/">回到首页</a>
              </p>
            </div>
          </article>
        </div>

        {showToc && (
          <aside class="post-side post-side-right d-none d-lg-block">
            <aside class="sidebar rr-sidebar">
              <div class="rr-progress-card">
                <div class="rr-progress-head">
                  <span class="rr-progress-label">阅读进度</span>
                  <span class="rr-progress-pct" data-rr-pct>0%</span>
                </div>
                <div class="rr-progress-track"><i data-rr-bar /></div>
                <button type="button" class="rr-focus-btn rr-focus-btn--side" data-rr-focus aria-pressed="false">
                  <span class="rr-focus-dot" aria-hidden="true" />
                  <span data-rr-focus-label>专注阅读</span>
                </button>
              </div>
              <div id="toc">
                <p class="toc-header">
                  <span>{zhCN.post.toc}</span>
                </p>
                <div class="toc-body" id="toc-body" />
              </div>
            </aside>
          </aside>
        )}
      </div>
    </div>
  </div>

  <script defer src="/js/reading-room.js"></script>

  <style is:global>
    .rr-page .post-wrap{max-width:1180px;margin:0 auto;padding:0 clamp(1rem,3vw,2rem) 3.2rem;transition:max-width 320ms cubic-bezier(.22,1,.36,1)}
    .rr-crumb{display:flex;align-items:center;gap:.55rem;margin:0 0 1.6rem;padding-top:.4rem;font-family:var(--font-mono);font-size:.78rem;color:var(--info-mark)}
    .rr-crumb a{color:var(--info-mark);text-decoration:none}
    .rr-crumb a:hover{color:var(--accent)}
    .rr-focus-btn{display:inline-flex;align-items:center;gap:.42rem;padding:.26rem .72rem;border:1px solid var(--line-color);border-radius:999px;background:transparent;color:var(--sec-text-color);font-family:var(--font-mono);font-size:.75rem;cursor:pointer;transition:border-color 180ms ease,color 180ms ease,background-color 180ms ease}
    .rr-focus-btn:hover,.rr-focus-btn[aria-pressed="true"]{border-color:var(--accent);color:var(--accent)}
    .rr-focus-dot{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.75}
    .rr-focus-btn--top{margin-left:auto;display:none}
    .post-wrap.is-focus-mode .rr-focus-btn--top{display:inline-flex}
    .post-wrap.is-focus-mode{max-width:820px}
    .post-wrap.is-focus-mode .post-grid{grid-template-columns:minmax(0,1fr)}
    .post-wrap.is-focus-mode .post-side{display:none!important}
    .rr-post-head{padding:0 0 1.8rem;margin:0 0 2.2rem;border-bottom:1px solid var(--line-color)}
    .rr-post-head .post-head-kicker{margin:0 0 .75rem;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.14em;color:var(--accent)}
    .rr-post-head .post-head-title{margin:0;font-family:var(--font-serif-title);font-size:clamp(1.85rem,3.6vw,2.75rem);line-height:1.22;letter-spacing:-0.015em;color:var(--text-color)}
    .rr-post-head .post-head-blurb{margin:1rem 0 0;font-size:1.02rem;line-height:1.75;color:var(--sec-text-color);max-width:44rem}
    .rr-meta-bar{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem 1.15rem;margin:1.35rem 0 0;padding-top:1rem;border-top:1px solid var(--line-color);font-family:var(--font-mono);font-size:.78rem;color:var(--info-mark)}
    .rr-meta-cats a{color:var(--accent);text-decoration:none;font-weight:600}
    .rr-meta-tags{display:inline-flex;flex-wrap:wrap;gap:.35rem .65rem}
    .rr-meta-tags a{color:var(--info-mark);text-decoration:none}
    .rr-meta-tags a:hover,.rr-meta-cats a:hover{text-decoration:underline;text-underline-offset:3px}
    .rr-page .markdown-body img{border-radius:var(--r-sm)}
    .rr-page .markdown-body img.rr-zoomable{cursor:zoom-in;transition:transform 260ms cubic-bezier(.22,1,.36,1)}
    .rr-page .markdown-body img.rr-zoomable:hover{transform:scale(1.01)}
    .rr-sidebar{position:sticky;top:5.4rem;display:flex;flex-direction:column;gap:1.35rem}
    .rr-progress-card{padding-bottom:1.1rem;border-bottom:1px solid var(--line-color)}
    .rr-progress-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.5rem;font-family:var(--font-mono);font-size:.75rem;color:var(--info-mark)}
    .rr-progress-pct{color:var(--accent);font-weight:700}
    .rr-progress-track{height:2px;background:var(--line-color);overflow:hidden;border-radius:2px;margin-bottom:.85rem}
    .rr-progress-track i{display:block;width:100%;height:100%;background:var(--accent);transform:scaleX(0);transform-origin:left center;transition:transform 120ms linear}
    .rr-focus-btn--side{width:100%;justify-content:center}
    .rr-sidebar #toc{padding:0;background:transparent;border:0;box-shadow:none}
    .rr-sidebar .toc-header{margin:0 0 .65rem;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.12em;color:var(--info-mark);text-transform:uppercase}
    .rr-sidebar .tocbot-link{font-size:.82rem;line-height:1.55;color:var(--sec-text-color);transition:color 160ms ease}
    .rr-sidebar .tocbot-active-link{color:var(--accent)!important;font-weight:600}
    .rr-post-foot{margin-top:3rem;padding-top:1.8rem;border-top:1px solid var(--line-color)}
    .rr-colophon{margin:0 0 2rem!important;padding:1rem 0 1.25rem!important;background:transparent!important;border:0!important;border-bottom:1px solid var(--line-color)!important;border-radius:0!important;box-shadow:none!important}
    .rr-colophon::before,.rr-colophon::after{display:none!important}
    .rr-colophon-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem;margin-bottom:.85rem}
    .rr-colophon-title{font-family:var(--font-serif-title);font-size:.98rem;font-weight:600;color:var(--text-color)}
    .rr-copy-link{padding:.24rem .68rem;border:1px solid var(--line-color);border-radius:999px;background:transparent;color:var(--sec-text-color);font-family:var(--font-mono);font-size:.75rem;cursor:pointer;transition:border-color 180ms ease,color 180ms ease}
    .rr-copy-link:hover{border-color:var(--accent);color:var(--accent)}
    .rr-colophon-meta{display:flex;flex-wrap:wrap;gap:.75rem 2rem;margin:0}
    .rr-colophon-meta dt{margin:0 0 .15rem;font-family:var(--font-mono);font-size:.75rem;color:var(--info-mark)}
    .rr-colophon-meta dd{margin:0;font-size:.84rem;color:var(--sec-text-color)}
    .rr-colophon-meta a{color:var(--accent);text-decoration:none}
    .rr-colophon-meta a:hover{text-decoration:underline;text-underline-offset:3px}
    .rr-prevnext{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin:0 0 1.6rem!important;padding-bottom:1.6rem;border-bottom:1px solid var(--line-color)}
    .rr-pn-slot--next{text-align:right}
    .rr-pn-link{display:flex;flex-direction:column;gap:.25rem;text-decoration:none;color:inherit}
    .rr-pn-kicker{font-family:var(--font-mono);font-size:.75rem;color:var(--info-mark)}
    .rr-pn-title{font-family:var(--font-serif-title);font-size:1rem;font-weight:600;color:var(--text-color);transition:color 180ms ease}
    .rr-pn-link:hover .rr-pn-title{color:var(--accent)}
    .rr-back-row{display:flex;justify-content:space-between;align-items:center;margin:0;font-family:var(--font-mono);font-size:.8rem}
    .rr-back-row a{color:var(--info-mark);text-decoration:none}
    .rr-back-row a:hover{color:var(--accent)}
    /* 原生图片灯箱 <dialog> */
    .rr-lightbox{max-width:min(94vw,1160px);max-height:92vh;padding:0;border:1px solid var(--line-color);border-radius:var(--r-sm);background-color:var(--body-bg-color);color:var(--text-color);box-shadow:var(--site-float-shadow)}
    .rr-lightbox::backdrop{background-color:var(--surface-ink);opacity:.78}
    .rr-lb-in{position:relative;padding:1rem;display:flex;flex-direction:column;align-items:center;gap:.65rem}
    .rr-lb-close{align-self:flex-end;padding:.24rem .72rem;border:1px solid var(--line-color);border-radius:999px;background:transparent;color:var(--text-color);font-family:var(--font-mono);font-size:.75rem;cursor:pointer}
    .rr-lb-close:hover{border-color:var(--accent);color:var(--accent)}
    .rr-lb-img{display:block;max-width:100%;max-height:76vh;width:auto;height:auto;border-radius:6px}
    .rr-lb-cap{margin:0;font-size:.82rem;color:var(--sec-text-color);text-align:center}
    @media (max-width:767.98px){.rr-prevnext{grid-template-columns:minmax(0,1fr)}.rr-pn-slot--next{text-align:left}}
    @media (prefers-reduced-motion:reduce){.rr-page .post-wrap,.rr-page .markdown-body img.rr-zoomable,.rr-progress-track i{transition:none}}
  </style>

  <MarkdownPlugins />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      Fluid.utils.createScript('/lib/tocbot/4.20.1/tocbot.min.js', function () {
        var toc = jQuery('#toc');
        if (toc.length === 0 || !window.tocbot) { return; }
        var boardCtn = jQuery('#board-ctn');
        var boardTop = boardCtn.offset().top;

        function isExpandAllEnabled() {
          return CONFIG.toc && CONFIG.toc.expand_all === true;
        }
        function expandAllToc() {
          if (!isExpandAllEnabled()) { return; }
          jQuery('#toc-body .tocbot-is-collapsed').removeClass('tocbot-is-collapsed');
        }
        function updateTocToggle($li, $childList) {
          var $toggle = $li.children('.toc-toggle');
          if ($toggle.length === 0) { return; }
          var collapsed = $childList.hasClass('tocbot-is-collapsed');
          $toggle
            .toggleClass('toc-toggle-collapsed', collapsed)
            .toggleClass('toc-toggle-expanded', !collapsed);
        }
        function bindTocToggle() {
          if (!isExpandAllEnabled()) { return; }
          jQuery('#toc-body .toc-list-item').each(function () {
            var $li = jQuery(this);
            var $childList = $li.children('ol');
            if ($childList.length === 0) {
              if ($li.children('.toc-toggle').length === 0) {
                $li.prepend('<span class="toc-toggle toc-toggle-placeholder" aria-hidden="true">›</span>');
              }
              return;
            }
            if ($li.children('.toc-toggle').length === 0) {
              $li.prepend('<span class="toc-toggle toc-toggle-expanded" aria-hidden="true">›</span>');
            }
            updateTocToggle($li, $childList);
          });
          jQuery('#toc-body').off('click.tocToggle').on('click.tocToggle', '.toc-toggle', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $li = jQuery(this).parent('.toc-list-item');
            var $childList = $li.children('ol');
            if ($childList.length === 0) { return; }
            $childList.toggleClass('tocbot-is-collapsed');
            updateTocToggle($li, $childList);
          });
          if (!window.__tocToggleObserver) {
            window.__tocToggleObserver = new MutationObserver(function (mutations) {
              mutations.forEach(function (mutation) {
                if (mutation.type !== 'attributes' || mutation.attributeName !== 'class') { return; }
                var $list = jQuery(mutation.target);
                var $li = $list.parent('.toc-list-item');
                if ($li.length === 0) { return; }
                updateTocToggle($li, $list);
              });
            });
            jQuery('#toc-body ol').each(function () {
              window.__tocToggleObserver.observe(this, { attributes: true });
            });
          }
        }
        var cfg = Object.assign({
          tocSelector     : '#toc-body',
          contentSelector : '.markdown-body',
          linkClass       : 'tocbot-link',
          activeLinkClass : 'tocbot-active-link',
          listClass       : 'tocbot-list',
          isCollapsedClass: 'tocbot-is-collapsed',
          collapsibleClass: 'tocbot-is-collapsible',
          scrollSmooth    : true,
          includeTitleTags: true,
          headingsOffset  : -boardTop,
        }, CONFIG.toc);
        if (isExpandAllEnabled()) {
          cfg.collapseDepth = 6;
        }
        window.tocbot.init(cfg);
        if (toc.find('.toc-list-item').length > 0) {
          toc.css('visibility', 'visible');
        }
        expandAllToc();
        bindTocToggle();

        Fluid.events.registerRefreshCallback(function () {
          if ('tocbot' in window) {
            tocbot.refresh();
            var toc = jQuery('#toc');
            if (toc.length === 0 || !tocbot) { return; }
            if (toc.find('.toc-list-item').length > 0) {
              toc.css('visibility', 'visible');
            }
            expandAllToc();
            bindTocToggle();
          }
        });
      });
    });
  </script>
</BaseLayout>
