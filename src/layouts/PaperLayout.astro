---
// 纸面页布局：复刻 paper.ejs（.paper-page > .home-wrap > .page-head + .about-body > .markdown-body）
// 正文由页面提供（Markdown 渲染结果放进默认插槽）。

import BaseLayout from './BaseLayout.astro';
import MarkdownPlugins from '../components/MarkdownPlugins.astro';
import PageHead from '../components/PageHead.astro';

interface Props {
  title: string;
  kicker?: string;
  subtitle?: string;
  updated?: unknown;
  description?: string;
  /** description 已由 excerptFromMarkdown 预转义，切勿二次转义 */
  descriptionPreformatted?: boolean;
  ogDate?: Date | null;
  ogUpdated?: Date | null;
  markdownPlugins?: boolean;
}

const { title, kicker, subtitle, updated, description, descriptionPreformatted, ogDate, ogUpdated, markdownPlugins = true } = Astro.props;
---

<BaseLayout title={title} description={description} descriptionPreformatted={descriptionPreformatted} ogDate={ogDate} ogUpdated={ogUpdated} markdownPlugins={markdownPlugins}>
  <div class="paper-page">
    <div class="home-wrap">
      <PageHead title={title} kicker={kicker} subtitle={subtitle} updated={updated} />
      <article class="about-body">
        <div class="markdown-body">
          <slot />
        </div>
      </article>
    </div>
  </div>

  <slot name="after" />

  <MarkdownPlugins />
</BaseLayout>
