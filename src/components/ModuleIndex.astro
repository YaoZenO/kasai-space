---
// 模块列表页主体：复刻 module-index.ejs（项目 / 游戏 / 收藏）。
// 铁律：无数据不渲染；collections 无 link 的条目渲染为非链接卡，不制造失效链接。
import PageHead from './PageHead.astro';
import { urlFor } from '../lib/url';
import { fmtItemDate } from '../lib/dates';

interface Props {
  moduleKey: 'projects' | 'games' | 'collections';
  moduleTitle: string;
  items: any[];
}

const { moduleKey, moduleTitle, items } = Astro.props;
const isCollections = moduleKey === 'collections';
const isGames = moduleKey === 'games';
const kicker = isCollections ? 'COLLECTIONS' : isGames ? 'GAMES' : 'PROJECTS';
const detailPath = (it: any) => '/' + moduleKey + '/' + (it.slug || encodeURIComponent(String(it.title))) + '/';
---

<div class="paper-page">
  <div class="home-wrap module-index">
    <PageHead variant="plain" kicker={`${kicker} · ${moduleTitle}`} title={`全部${moduleTitle}`} count={`共 ${items.length} 个`} />

    {isGames ? (
      <div class="games-wall">
        {items.map((it: any) => (
          <a class={`games-tile${it.cover ? '' : ' no-cover'}`} href={urlFor(detailPath(it))}>
            {it.cover && <img class="games-tile-img" src={urlFor(it.cover)} alt={it.title} loading="lazy" />}
            <span class="games-tile-cap">
              <span class="games-tile-title">{it.title}</span>
              {(it.summary || it.desc) && <span class="games-tile-sum">{it.summary || it.desc}</span>}
              {(it.genre || it.status) && (
                <span class="games-tile-meta">{[it.genre, it.status].filter(Boolean).join(' · ')}</span>
              )}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="module-grid">
        {items.map((it: any) => {
          const collHref = isCollections ? (it.link || '') : '';
          const Card = isCollections && !collHref ? 'div' : 'a';
          return (
            <Card
              class={`module-card${it.cover ? ' has-cover' : ''}`}
              {...(isCollections ? (collHref ? { href: collHref, target: '_blank', rel: 'noopener' } : {}) : { href: urlFor(detailPath(it)) })}
            >
              {it.cover && (
                <span class="module-card-img"><img src={urlFor(it.cover)} alt={it.title} loading="lazy" /></span>
              )}
              <span class="module-card-body">
                <span class="module-card-title">{it.title}</span>
                {(it.summary || it.desc) && <span class="module-card-sum">{it.summary || it.desc}</span>}
                <span class="module-card-meta">
                  {it.date && <time class="mono" datetime={fmtItemDate(it.date, 'YYYY-MM-DD')}>{fmtItemDate(it.date)}</time>}
                  {isGames && it.genre && <span class="detail-tag detail-tag-solid">{it.genre}</span>}
                  {isGames && it.status && <span class="detail-tag">{it.status}</span>}
                  {isCollections && collHref && <span class="detail-tag">外链</span>}
                </span>
              </span>
            </Card>
          );
        })}
      </div>
    )}
  </div>
</div>
