---
// /holidays/ 与 /holidays/<year>/ 共用的页面主体。
// 结构以 2026-11-09 主人确认的整页示意（dist/_mock/holidays-2026.html）为准：
//   首屏 → 年份下拉 → 统计三格 → 筛选 chips → 12 月宫格 → 图例 → 月份明细
//   → 七个法定节假日图文卡 → 其他节日与纪念日 → 二十四节气 → 常见问题
// 取数与派生全部在 src/lib/holiday-calendar.ts 里算完，模板只负责摆。
// 无 JS 时：宫格、默认月份明细、七张卡、其他节日、节气、FAQ 都是服务端渲染好的；
// 内联脚本只做「chip 筛选高亮 + 点月切换明细」。

import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from './EmptyState.astro';
import { fmtItemDate } from '../lib/dates';
import { urlFor } from '../lib/url';
import { calendarView } from '../lib/holiday-calendar';
interface Props {
  cal: any;
  title: string;
  description?: string;
  currentPath: string;
  published?: any;
  modified?: any;
  tipsJson?: string;
}

const { cal, title, description, currentPath, published, modified } = Astro.props;
const view = cal ? calendarView(cal) : null;
const WEEK = ['日', '一', '二', '三', '四', '五', '六'];

const yearItems = cal ? cal.years : [];
const zodiac = cal && cal.zodiac && cal.zodiac.ganzhi
  ? `${cal.zodiac.ganzhi}${cal.zodiac.animal}年`
  : '';

// 无脚本时的兜底文案：节假日区间 + 调休清单 + 节日节气清单，全部由数据拼。
const noscriptSegs = cal
  ? cal.holidays.map((h: any) => `${h.name} ${h.startLabel} 至 ${h.endLabel}，连休 ${h.days} 天（法定 ${h.statutory} 天）`)
  : [];
const noscriptMakeup = view ? view.makeupLabels : [];
const noscriptFests = cal
  ? view.otherFestivals.concat(cal.terms)
      .sort((a: any, b: any) => (a.date < b.date ? -1 : 1))
      .map((f: any) => `${f.name} ${f.dateLabel}`)
  : [];

const pads = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<BaseLayout title={title} description={description} currentPath={currentPath} ogDate={published} ogUpdated={modified}>
  <canvas class="ab-bg-canvas" id="ab-bg-canvas" aria-hidden="true"></canvas>

  <div class="paper-page ab-page-shell cal-page pg-holidays hy-page hy-v2" data-filter="all">
    <div class="home-wrap">
      {!cal ? (
        <EmptyState>这一年的节假日数据还在整理中，页面会随数据录入自动生成，欢迎稍后再来看看。</EmptyState>
      ) : (
        <>
          <header class="hy-head hy-v2-head">
            <p class="ab-watermark" data-ab-parallax="0.16" aria-hidden="true">{cal.year}</p>
            <div class="hy-v2-head-main">
              <nav class="hy-crumb" aria-label="面包屑">
                <a href={urlFor('/library/')}>资料库</a>
                <span aria-hidden="true">/</span>
                <a href={urlFor('/holidays/')}>中国节假日</a>
                <span aria-hidden="true">/</span>
                <span class="hy-crumb-now">{cal.year}</span>
              </nav>
              <p class="hy-kicker">CALENDAR · {cal.year}{zodiac && <> · {zodiac}</>}</p>
              <h1 class="hy-title">{cal.year} 年节假日</h1>
              <p class="hy-lede"><Fragment set:html={cal.lede} /></p>
            </div>

            <ul class="hy-stats hy-v2-stats">
              <li>
                <span class="hy-stat-num">{cal.stats.statutoryDays}</span><span class="hy-stat-unit">天</span>
                <span class="hy-stat-label">法定假日</span>
              </li>
              <li>
                <span class="hy-stat-num">{cal.stats.holidayDays}</span><span class="hy-stat-unit">天</span>
                <span class="hy-stat-label">放假天数</span>
              </li>
              <li>
                <span class="hy-stat-num">{cal.stats.makeupDays}</span><span class="hy-stat-unit">天</span>
                <span class="hy-stat-label">调休补班</span>
              </li>
            </ul>
          </header>

          <div class="hy-yearbar hy-v2-yearbar">
            <details class="hy-yearpick">
              <summary>
                <span class="hy-yearpick-cur">{cal.year} 年</span>
                <span class="hy-yearpick-hint">切换年份</span>
              </summary>
              <div class="hy-yearpick-panel">
                <p class="hy-yearpick-label">{yearItems[0]} – {yearItems[yearItems.length - 1]}</p>
                <ul class="hy-years">
                  {yearItems.map((yv: number) => (
                    <li>
                      {yv === cal.current ? (
                        <span class="is-cur" aria-current="page">{yv}</span>
                      ) : (
                        <a href={urlFor('/holidays/' + yv + '/')}>{yv}</a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </details>

            <nav class="hy-v2-yearstrip" aria-label="快捷切换年份">
              {yearItems.map((yv: number) => (
                yv === cal.current ? (
                  <span class="hy-v2-yr is-cur" aria-current="page">{yv}</span>
                ) : (
                  <a class="hy-v2-yr" href={urlFor('/holidays/' + yv + '/')}>{yv}</a>
                )
              ))}
            </nav>

            <span class="hy-note-seg">
              {cal.label}安排{cal.updated && <> · 更新于 {fmtItemDate(cal.updated)}</>}
            </span>
          </div>

          <div class="hy-filters" role="group" aria-label="按类型筛选日历">
            <button class="hy-chip is-active" type="button" data-filter="all" aria-pressed="true">全部 <span>{cal.stats.holidayCount} 段</span></button>
            <button class="hy-chip" type="button" data-filter="holiday" aria-pressed="false">放假 <span>{cal.stats.holidayDays} 天</span></button>
            <button class="hy-chip" type="button" data-filter="work" aria-pressed="false">补班 <span>{cal.stats.makeupDays} 天</span></button>
            <button class="hy-chip" type="button" data-filter="fest" aria-pressed="false">节气 <span>{cal.stats.termCount} 个</span></button>
          </div>

          <div class="hy-months">
            {view.monthTiles.map((tile: any) => (
              <article class={`hy-month${tile.m === view.focusMonth ? ' hy-month--focus is-current' : ''}`} data-month={tile.m}>
                <div class="hy-month-head">
                  <h2 class="hy-month-title">
                    <button class="hy-month-btn" type="button" data-month={tile.m} aria-controls={`hy-detail-${tile.m}`}>{tile.m} 月</button>
                  </h2>
                  <span class="hy-montags">
                    {tile.tags.slice(0, 3).map((name: string) => <span class="hy-tag">{name}</span>)}
                  </span>
                  {tile.m === view.focusMonth && tile.badge && <span class="hy-badge">{tile.badge}</span>}
                </div>
                <div class="hy-week" aria-hidden="true">
                  {WEEK.map((w: string) => <span>{w}</span>)}
                </div>
                <div class="hy-days">
                  {pads(tile.pad).map(() => <div class="hy-day hy-day--pad" aria-hidden="true"></div>)}
                  {tile.cells.map((c: any) => (
                    <div
                      class={`hy-day${c.state === 'holiday' ? ' hy-day--holiday' : ''}${c.state === 'makeup' ? ' hy-day--work' : ''}${c.w === 0 || c.w === 6 ? ' hy-day--weekend' : ''}`}
                      title={c.tip}
                    >
                      <span class="hy-dn">{c.d}</span>
                      {c.dot && <i class="hy-fest" aria-hidden="true"></i>}
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>

          <ul class="hy-legend">
            <li><span class="hy-lg hy-lg--holiday" aria-hidden="true"></span>{cal.label}放假</li>
            <li><span class="hy-lg hy-lg--work" aria-hidden="true"></span>调休补班</li>
            <li><span class="hy-lg hy-lg--weekend" aria-hidden="true"></span>周末</li>
            <li><span class="hy-lg hy-lg--fest" aria-hidden="true"></span>节日或节气</li>
            <li><span class="hy-lg hy-lg--focus" aria-hidden="true"></span>全年假期最集中的月份</li>
          </ul>

          <div class="hy-detail">
            <div class="hy-detail-head">
              <h2>月份明细</h2>
              <span>点月份卡上的月份可切换</span>
            </div>
            {view.monthTiles.map((tile: any) => (
              <div class="hy-panel" id={`hy-detail-${tile.m}`} data-month={tile.m} hidden={tile.m !== view.focusMonth}>
                <dl class="hy-rows">
                  <div class="hy-row">
                    <dt>假期段</dt>
                    <dd>
                      {tile.panel.segs.length ? (
                        tile.panel.segs.map((s: any, i: number) => (
                          <>
                            {i > 0 && <br />}
                            <strong>{s.label}</strong>（{s.arrange}） · 连休 {s.days} 天，法定 {s.statutory} 天
                          </>
                        ))
                      ) : (
                        <span class="hy-muted">本月无法定假期段</span>
                      )}
                    </dd>
                  </div>
                  <div class="hy-row">
                    <dt>调休补班</dt>
                    <dd>{tile.panel.works || <span class="hy-muted">本月无调休补班</span>}</dd>
                  </div>
                  <div class="hy-row">
                    <dt>节气与传统节日</dt>
                    <dd>{tile.panel.fests || <span class="hy-muted">本月无节气与传统节日</span>}</dd>
                  </div>
                </dl>
              </div>
            ))}
          </div>

          <noscript>
            <div class="hy-noscript">
              <h2>{cal.year} 年放假安排</h2>
              {noscriptSegs.map((line: string) => <p>{line}。</p>)}
              <p><b>调休上班日</b>：{noscriptMakeup.length ? noscriptMakeup.join('、') : '无'}。</p>
              <p><b>其他节日与节气</b>：{noscriptFests.join('、')}。</p>
            </div>
          </noscript>

          <section class="hy-sec hy-cards" id="holiday-cards" aria-labelledby="hy-cards-title">
            <div class="hy-sec-head">
              <h2 class="hy-sec-title" id="hy-cards-title">七个法定节假日</h2>
              <p class="hy-sec-sub">{cal.stats.holidayCount} 段 · 共 {cal.stats.holidayDays} 天</p>
            </div>
            <div class="hy-card-grid">
              {view.cards.map((h: any, i: number) => (
                <article class={`hy-card${i === view.cards.length - 1 ? ' hy-card--wide' : ''}`} id={h.anchor}>
                  <figure class="hy-card-media">
                    <div class="hy-card-photo">
                      <img src={h.img} alt={h.alt} loading="lazy" decoding="async" width="960" height="540" />
                    </div>
                    <figcaption class="hy-credit">
                      <a href={h.creditUrl} target="_blank" rel="noopener">{h.credit} · {h.creditLicense} · Wikimedia Commons</a>
                    </figcaption>
                  </figure>
                  <div class="hy-card-body">
                    <div class="hy-card-top">
                      <h3 class="hy-card-name">{h.name}</h3><span class="hy-pinyin">{h.pinyin}</span>
                    </div>
                    <p class="hy-card-lunar">{h.lunarNote} · {h.arrange}</p>
                    <p class="hy-card-range"><strong>{h.startLabel}–{h.endLabel}</strong> · 连休 {h.days} 天，法定 {h.statutory} 天</p>
                    <p class="hy-card-work">调休上班：{h.makeupLabel.length ? h.makeupLabel.join('、') : '无'}</p>
                    <p class="hy-card-desc">{h.desc}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="hy-sec" id="other-festivals" aria-labelledby="hy-other-title">
            <div class="hy-sec-head">
              <p class="hy-sec-kicker">Festivals &amp; Days</p>
              <h2 class="hy-sec-title" id="hy-other-title">其他节日与纪念日</h2>
              <p class="hy-sec-sub">{view.otherFestivals.length} 个非法定节假日，按日期排列</p>
            </div>
            <div class="hy-fest-grid">
              {view.otherFestivals.map((f: any) => (
                <article class="hy-fest-item">
                  <div class="hy-fest-date">
                    <b>{f.dateLabel}</b><span>{f.wName}</span>
                  </div>
                  <div class="hy-fest-body">
                    <div class="hy-fest-top">
                      <h3 class="hy-fest-name">{f.name}</h3>
                      <span class={`hy-kind${f.kind === '部分公民放假' ? ' hy-kind--accent' : ''}`}>{f.kind}</span>
                    </div>
                    <p class="hy-fest-note">{f.note}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="hy-sec" id="solar-terms" aria-labelledby="hy-terms-title">
            <div class="hy-sec-head">
              <p class="hy-sec-kicker">24 Solar Terms</p>
              <h2 class="hy-sec-title" id="hy-terms-title">二十四节气</h2>
              <p class="hy-sec-sub">四季 · 每季六个</p>
            </div>
            <div class="hy-season-grid">
              {view.seasons.map((s: any) => (
                <div class="hy-season">
                  <div class="hy-season-head"><h3>{s.name}</h3><span>{s.range}</span></div>
                  <ul class="hy-terms">
                    {s.terms.map((t: any) => (
                      <li><span class="hy-term-name">{t.name}</span><span class="hy-term-date">{t.label}</span></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <p class="hy-sec-note">节气按太阳每运行 15° 一个，日期每年相差一两天。</p>
          </section>

          {cal.faq.length > 0 && (
            <section class="hy-sec" id="faq" aria-labelledby="hy-faq-title">
              <div class="hy-sec-head">
                <p class="hy-sec-kicker">FAQ</p>
                <h2 class="hy-sec-title" id="hy-faq-title">关于 {cal.year} 年节假日的常见问题</h2>
                <p class="hy-sec-sub">{cal.faq.length} 条</p>
              </div>
              <div class="hy-faq-list">
                {cal.faq.map((item: any, i: number) => (
                  <details class="hy-faq-item" open={i === 0}>
                    <summary>{item.q}</summary>
                    <div class="hy-faq-a"><p>{item.a}</p></div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <p class="hy-note">
            节日当天的公历日期是确定的；放假区间与调休上班日以国务院办公厅通知为准，出行前请再确认。
            {cal.source && <> 来源：<a href={cal.source.url} target="_blank" rel="noopener">国务院办公厅 {cal.source.dateLabel}的通知</a>。</>}
          </p>

          <script is:inline>
            (function () {
              var root = document.querySelector('.hy-page');
              if (!root) return;
              var chips = Array.prototype.slice.call(root.querySelectorAll('.hy-chip'));
              chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                  var value = chip.getAttribute('data-filter');
                  root.setAttribute('data-filter', value);
                  chips.forEach(function (c) {
                    var on = c === chip;
                    c.classList.toggle('is-active', on);
                    c.setAttribute('aria-pressed', on ? 'true' : 'false');
                  });
                });
              });

              var cards = Array.prototype.slice.call(root.querySelectorAll('.hy-month'));
              var panels = Array.prototype.slice.call(root.querySelectorAll('.hy-panel'));
              function openMonth(m) {
                panels.forEach(function (p) {
                  p.hidden = p.getAttribute('data-month') !== m;
                });
                cards.forEach(function (c) {
                  c.classList.toggle('is-current', c.getAttribute('data-month') === m);
                });
              }
              cards.forEach(function (card) {
                var btn = card.querySelector('.hy-month-btn');
                if (!btn) return;
                btn.addEventListener('click', function () {
                  openMonth(btn.getAttribute('data-month'));
                });
              });
            })();
          </script>
        </>
      )}
    </div>
  </div>

  <style is:global>
    .hy-v2 .hy-v2-head{position:relative;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(260px,0.8fr);align-items:end;gap:clamp(1.4rem,4vw,3.5rem);padding:clamp(1rem,2.6vw,2.2rem) 0 clamp(1.8rem,3.6vw,2.6rem);margin:0 0 1.8rem;border-bottom:1px solid var(--line-color);overflow:clip}
    .hy-v2-head-main,.hy-v2-stats{position:relative;z-index:1}
    .hy-v2 .hy-title{font-family:var(--font-serif-title);font-size:clamp(2.2rem,4.6vw,3.5rem);line-height:1.08;letter-spacing:-0.02em}
    .hy-v2 .hy-kicker{font-family:var(--font-mono);font-size:.75rem;letter-spacing:.14em;color:var(--accent)}
    .hy-v2-stats{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:0!important;padding:0!important;background:transparent!important;border:0!important}
    .hy-v2-stats li{padding:.65rem 0 0!important;border:0!important;border-top:1px solid var(--line-color)!important;background:transparent!important;border-radius:0!important}
    .hy-v2-yearbar{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1.2rem;margin:0 0 1.5rem;padding-bottom:1.1rem;border-bottom:1px solid var(--line-color)}
    .hy-v2-yearstrip{display:flex;flex-wrap:wrap;gap:.25rem .35rem;flex:1 1 auto}
    .hy-v2-yr{display:inline-flex;align-items:center;justify-content:center;padding:.2rem .5rem;border-radius:999px;font-family:var(--font-mono);font-size:.76rem;color:var(--sec-text-color);text-decoration:none;transition:background-color 160ms ease,color 160ms ease}
    .hy-v2-yr:hover{color:var(--accent);background:var(--surface-tint)}
    .hy-v2-yr.is-cur{background:var(--accent);color:#fff;font-weight:700}
    .hy-v2 .hy-filters{margin-bottom:1.6rem}
    .hy-v2 .hy-chip{border-radius:999px;transition:border-color 180ms ease,color 180ms ease,background-color 180ms ease}
    .hy-v2 .hy-month{border-radius:var(--r-sm);transition:border-color 200ms ease,transform 220ms cubic-bezier(.22,1,.36,1)}
    .hy-v2 .hy-month:hover{border-color:var(--accent);transform:translateY(-2px)}
    .hy-v2 .hy-month.is-current{border-color:var(--accent)}
    .hy-v2 .hy-day{transition:opacity 200ms ease,transform 200ms ease}
    .hy-v2[data-filter="holiday"] .hy-day:not(.hy-day--holiday){opacity:.22}
    .hy-v2[data-filter="work"] .hy-day:not(.hy-day--work){opacity:.22}
    .hy-v2[data-filter="fest"] .hy-day:not(:has(.hy-fest)){opacity:.22}
    .hy-v2 .hy-detail{border-radius:var(--r-sm);border:0;border-top:1px solid var(--line-color);border-bottom:1px solid var(--line-color);background:transparent;padding:1.4rem 0}
    .hy-v2 .hy-card{border-radius:var(--r-sm);border:1px solid var(--line-color);background:transparent;overflow:hidden;transition:border-color 200ms ease,transform 240ms cubic-bezier(.22,1,.36,1)}
    .hy-v2 .hy-card:hover{border-color:var(--accent);transform:translateY(-2px)}
    .hy-v2 .hy-card-photo img{border-radius:0;transition:transform 480ms cubic-bezier(.22,1,.36,1)}
    .hy-v2 .hy-card:hover .hy-card-photo img{transform:scale(1.035)}
    .hy-v2 .hy-sec{margin-top:3rem;padding-top:2.2rem;border-top:1px solid var(--line-color)}
    .hy-v2 .hy-fest-item,.hy-v2 .hy-season,.hy-v2 .hy-faq-item{background:transparent;border-radius:0;border:0;border-bottom:1px solid var(--line-color)}
    @media (max-width:767.98px){.hy-v2 .hy-v2-head{grid-template-columns:minmax(0,1fr)}.hy-v2-yearstrip{display:none}}
    @media (prefers-reduced-motion:reduce){.hy-v2 .hy-month,.hy-v2 .hy-day,.hy-v2 .hy-card,.hy-v2 .hy-card-photo img{transition:none}}
  </style>
</BaseLayout>
