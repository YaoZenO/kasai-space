---
// <head> 内容：逐项对齐 _partials/head.ejs 的输出顺序。

import { siteConfig, themeConfig, documentTitle, canonicalEnable, darkModeEnable, openGraphEnable } from '../lib/site-config';
import { openGraphTags } from '../lib/opengraph';
import Styles from './Styles.astro';
import ExportConfig from './ExportConfig.astro';

interface Props {
  title?: string;
  description?: string;
  /** description 已由 excerptFromMarkdown 预转义（页面摘要），不要再转义一次 */
  descriptionPreformatted?: boolean;
  ogType?: 'website' | 'article';
  ogImages?: string[];
  ogKeywords?: string[];
  ogDate?: Date | null;
  ogUpdated?: Date | null;
  canonicalPath?: string;
  markdownPlugins?: boolean;
}

const { title, description, descriptionPreformatted, ogType, ogImages, ogKeywords, ogDate, ogUpdated, canonicalPath, markdownPlugins } = Astro.props;

const path = canonicalPath ?? Astro.url.pathname;
const absoluteUrl = new URL(path, siteConfig.url).toString();
const fullTitle = documentTitle(title);

const keywords: string = Array.isArray(siteConfig.keywords)
  ? siteConfig.keywords.join(',')
  : siteConfig.keywords || '';

const themeColor: string = themeConfig.color?.navbar_bg_color || '';

// 2026-11-09 防首屏 FOUC：内联、同步、阻塞，位置在首个 CSS link（Styles.astro）之前。
// /js/color-schema.js 是 defer，解析完成后才执行，已存 dark 的访客会先闪一帧浅色。
// 2026-11-11 Phase 4A：三层优先级「手动 > 时间层 > 系统层兜底」的首屏定态。
//   ① 读手动值，合法则写 data-user-color-scheme 并立即结束（不读时间缓存）；
//   ② 否则读当日天文时刻缓存，命中且有效则按同一 UTC 基准比较，写独立标记
//      data-sun-scheme（绝不写手动属性，否则系统兜底分支会被屏蔽）；
//   ③ 缓存缺失 / 失效 / 损坏则什么都不写，让 CSS 跟随系统分支接管。
// 全程同步返回、早于首次绘制；不做任何网络等待、不新增元素、不估算时刻。
// 与 themes/fluid/layout/_partials/head.ejs 的内联脚本逐行同源，两处须同步扩展。
const darkModeBootScript = `(function () {
  try {
    var r = document.documentElement;
    var v = localStorage.getItem('Fluid_Color_Scheme');
    if (v === 'light' || v === 'dark') {
      r.setAttribute('data-user-color-scheme', v);
      return;
    }
    var raw = localStorage.getItem('Fluid_Sun_Scheme');
    if (!raw) return;
    var c = JSON.parse(raw);
    if (!c || typeof c.date !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(c.date)
        || typeof c.sunrise !== 'number' || typeof c.sunset !== 'number'
        || typeof c.fp !== 'string' || !/^[0-9a-f]{8}$/.test(c.fp)
        || !(c.sunrise > 0) || !(c.sunset > c.sunrise)
        || (c.sunset - c.sunrise) > 86400000) return;
    var now = Date.now();
    if (now < c.sunrise - 86400000 || now >= c.sunrise + 86400000) return;
    r.setAttribute('data-sun-scheme', (now >= c.sunrise && now < c.sunset) ? 'light' : 'dark');
  } catch (e) {}
})();`;

const ogHtml = openGraphEnable
  ? openGraphTags({
      title: title || siteConfig.title,
      description,
      descriptionPreformatted,
      url: absoluteUrl,
      type: ogType,
      images: ogImages,
      keywords: ogKeywords,
      date: ogDate,
      updated: ogUpdated,
    })
  : '';
---

<meta charset="UTF-8">

<link rel="apple-touch-icon" sizes="180x180" href={themeConfig.apple_touch_icon} />
<link rel="icon" type="image/png" sizes="32x32" href={themeConfig.favicon} />
<link rel="icon" type="image/png" sizes="16x16" href={themeConfig.favicon_16} />

<link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/fraunces-600-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/nunito-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />

{canonicalEnable && <link rel="canonical" href={absoluteUrl} />}

<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, shrink-to-fit=no" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
{themeColor && <meta name="theme-color" content={themeColor} />}
{siteConfig.author && <meta name="author" content={siteConfig.author} />}
{keywords && <meta name="keywords" content={keywords} />}

{openGraphEnable && <Fragment set:html={ogHtml} />}

<title>{fullTitle}</title>

{darkModeEnable && <script is:inline set:html={darkModeBootScript} />}

<Styles markdownPlugins={markdownPlugins} />

<ExportConfig />

<script defer src="/js/utils.js"></script>
<script defer src="/js/color-schema.js"></script>
<script defer src="/js/sun-scheme.js"></script>

<script type="speculationrules" is:inline>
{
  "prefetch": [{
    "where": {
      "and": [
        { "href_matches": "/*" },
        { "not": { "href_matches": "/admin/*" } },
        { "not": { "href_matches": "/archives*" } },
        { "not": { "href_matches": "/categories/*" } },
        { "not": { "href_matches": "/tags/*" } },
        { "not": { "href_matches": "/*.xml" } }
      ]
    },
    "eagerness": "moderate"
  }]
}
</script>

<link rel="alternate" href="/atom.xml" title={siteConfig.title} type="application/atom+xml">
