{
  "name": "kasai-space",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run astro:build",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','.astro','static-public'])fs.rmSync(d,{recursive:true,force:true})\"",
    "server": "astro dev",
    "preview": "astro preview",
    "astro:assets": "node tools/prepare-assets.mjs",
    "astro:build": "node tools/prepare-assets.mjs && astro build && node tools/encode-module-paths.mjs && node tools/stamp-assets.mjs",
    "astro:verify": "node tools/verify-urls.mjs --mode=exact",
    "test:admin": "node test/admin-smoke.js",
    "test:pages": "node test/module-pages-e2e.js",
    "test:tokens": "node test/css-tokens.js",
    "test:claims": "node test/docs-claims.js",
    "test:blocks": "node test/md-blocks.js",
    "test:assets": "node test/asset-version.js",
    "test:dates": "node test/module-dates.js",
    "test:holidays": "node test/holidays-e2e.js",
    "test:zodiac": "node test/zodiac-e2e.js",
    "test:festival": "node test/festival-e2e.js",
    "test:cityrank": "node test/cityrank-e2e.js",
    "test:curation": "node test/curation.js",
    "test:search": "node test/search-index.js",
    "test:a10-render": "node test/a10-avatar-render.js",
    "test:env": "node test/build-env.js",
    "test:darkmode": "node test/darkmode-e2e.js",
    "test": "npm run astro:build && npm run test:admin && npm run test:pages && npm run test:tokens && npm run test:claims && npm run test:blocks && npm run test:assets && npm run test:dates && npm run test:holidays && npm run test:zodiac && npm run test:festival && npm run test:cityrank && npm run test:curation && npm run test:search && npm run test:darkmode && npm run test:env"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "astro": "^7.4.7",
    "hexo-util": "4.0.0",
    "js-yaml": "^4.3.2",
    "marked": "15.0.12",
    "rehype-slug": "^6.0.0",
    "stylus": "^0.64.0"
  }
}
