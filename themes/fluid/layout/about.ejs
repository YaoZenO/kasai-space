<%
// 关于页（纸面档案）：身份区（头像/名字/签名/社交图标）+ 正文 markdown；
// 内容全部来自真实配置与 about 页面内容，不虚构模块
// 数据源规则：intro/avatar 以 source/_data/site.yml（后台「设置」页）优先，
// theme.about.* 为 legacy 回退；name/icons 仍属主题配置（见 ENGINEERING.md P0-1）
page.layout = "about"
page.title = theme.about.title || __('about.title')
page.subtitle = theme.about.subtitle || __('about.subtitle')
page.hide_banner = true
var siteCfg = (site.data && site.data.site) || {}
var aboutIntro = siteCfg.intro || theme.about.introduce || theme.about.intro || ''
var aboutAvatar = siteCfg.avatar || theme.about.avatar || ''
var aboutIcons = (theme.about && theme.about.icons) || []
// copy 形态：图标不是链接，点击复制一段文本（邮箱/微信号）。
// 不用 mailto——它依赖访客本机注册了默认邮件客户端，没装的机器上点了没反应或弹「找不到应用」。
var hasCopyIcon = aboutIcons.some(function (e) { return e && e.class && !e.link && e.copy })
%>

<div class="paper-page">
  <div class="home-wrap about-page">

    <header class="about-head">
      <div class="about-head-main">
        <p class="page-head-kicker">ABOUT</p>
        <h1 class="page-head-title"><%- theme.about.name %></h1>
        <% if (aboutIntro) { %>
        <p class="about-head-intro"><%- aboutIntro %></p>
        <% } %>
        <% if (aboutIcons.length) { %>
        <ul class="about-icons">
          <% for (const each of aboutIcons) { %>
            <% if (!each.class) continue; %>
            <% var isQr = !!each.qrcode %>
            <% var isCopy = !isQr && !each.link && !!each.copy %>
            <%
            // 属性走数组拼接后用「原样输出」标签输出：E-006 记过属性值被转义成 &#34; 导致链接点不动的坑。
            // 注意：注释里不能再写 EJS 标签的字面量——脚本块内出现闭合标记会让 EJS 提前结束脚本块，
            // 后面的标签全部错配，报 “Could not find matching close tag”。
            var iAttrs = []
            if (!isQr) iAttrs.push('href="' + (isCopy ? 'javascript:;' : url_for(each.link)) + '"')
            iAttrs.push('target="' + (isQr || isCopy ? '_self' : '_blank') + '"')
            var iCls = [isQr ? 'qr-trigger' : '', isCopy ? 'about-icon-copy' : '', (!isQr && each.tip) ? 'hint--bottom hint--rounded' : ''].filter(Boolean).join(' ')
            if (iCls) iAttrs.push('class="' + iCls + '"')
            if (isCopy) iAttrs.push('data-copy="' + each.copy + '"')
            if (!isQr && each.tip) iAttrs.push('aria-label="' + each.tip + '"')
            %>
            <a <%- iAttrs.join(' ') %>>
              <i class="<%= each.class %>" aria-hidden="true"></i>
              <% if (isQr) { %>
                <%# 二维码原图较大（名片码 856x1142），横向宽度保持不变，只在首屏外加载 %>
                <img class="qr-img" src="<%= url_for(each.qrcode) %>" alt="qrcode" loading="lazy" />
              <% } %>
            </a>
          <% } %>
        </ul>
        <% } %>
      </div>
      <% if (aboutAvatar) { %>
      <div class="about-avatar-box">
        <img src="<%= url_for(aboutAvatar) %>" alt="avatar">
      </div>
      <% } %>
    </header>

    <article class="about-body">
      <div class="markdown-body">
        <%- page.content %>
      </div>

      <% if(page.comments) { %>
        <!-- Comments -->
        <article id="comments">
          <% var type %>
          <% if (typeof page.comment === 'string' && page.comment !== '') { %>
            <% type = '_partials/comments/' + page.comment %>
          <% } else { %>
            <% type = '_partials/comments/' + theme.post.comments.type %>
          <% } %>
          <%- partial(type) %>
        </article>
      <% } %>
    </article>

  </div>
</div>

<%- partial('_partials/markdown-plugins') %>

<% if (hasCopyIcon) { %>
<script src="<%= versionedAsset('/js/about.js') %>" defer></script>
<% } %>
