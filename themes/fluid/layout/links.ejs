<%
// 友链页（纸面样式）：条目全部来自主题配置 theme.links.items（主人维护）
// 无内容时显示诚实空态——不渲染任何伪造条目
page.layout = 'links'
page.hide_banner = true
page.title = theme.links.title || __('links.title')
var items = (theme.links && theme.links.items) || []
var valid = []
for (const each of items) { if (each && each.title && each.link) valid.push(each) }
%>

<div class="paper-page">
  <div class="home-wrap">
    <header class="page-head">
      <p class="page-head-kicker">LINKS</p>
      <h1 class="page-head-title"><%= page.title %></h1>
      <p class="archive-total">共 <%= valid.length %> 个</p>
    </header>

    <% if (valid.length) { %>
    <div class="module-grid">
      <% valid.forEach(function (each) { %>
      <a class="module-card" href="<%= url_for(each.link) %>" target="_blank" rel="noopener">
        <span class="module-card-body">
          <span class="module-card-title"><%= each.title %></span>
          <% if (each.intro) { %><span class="module-card-sum"><%= each.intro %></span><% } %>
        </span>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <p class="post-desc">还没有添加友链。想交换的话，从站内任意一个社交图标找到我——发站点链接和一句话介绍就行。</p>
    <% } %>
  </div>
</div>
