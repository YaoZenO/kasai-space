<%
// 标签总览页（纸面档案）：真实标签与真实计数，不伪装热度排名；
// 排序按实际文章数（与计数一致，非装饰性随机）
page.layout = "tags"
page.title = theme.tag.title || __('tag.title')
page.subtitle = theme.tag.subtitle || __('tag.subtitle')
page.hide_banner = true

var min_font = theme.tag.tagcloud.min_font || 15
var max_font = theme.tag.tagcloud.max_font || 30
var unit = theme.tag.tagcloud.unit || 'px'
var start_color = theme.tag.tagcloud.start_color || '#BBBBEE'
var end_color = theme.tag.tagcloud.end_color || '#337ab7'
var allTags = site.tags.filter(tag => tag.length).sort('-length')
%>

<div class="paper-page">
  <div class="home-wrap">
    <header class="page-head">
      <p class="page-head-kicker">TAGS</p>
      <h1 class="page-head-title">标签</h1>
    </header>

    <% if (allTags.length) { %>
    <ul class="tag-cloud">
      <% allTags.each(function (tag) { %>
        <li class="tag-chip">
          <a class="tag-chip-name" href="<%= url_for(tag.path) %>"># <%= tag.name %></a>
          <span class="tag-chip-count"><%= tag.posts.length %></span>
        </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</div>
