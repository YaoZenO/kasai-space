<%
// 城市大类索引页（/city/）：城市档案是与城市榜单并列的一大类。
//
// 2026-11-04 改版（PLAN-V3 §6）：原来把 431 座城市平铺成一列 431 行的名单，
// 读者滚到第 50 行就不知道自己在哪了，而且名单里城市之间没有任何可比的数字。
// 现在分两段：
//   ① 上榜最多的 30 座 → 榜单行（名次 / 城市·省·级别 / 上榜次数+横条 / GDP / 人口）
//   ② 其余按省份折叠 → 原生 <details>，不依赖 JS，无 JS 也能展开
//
// 2026-11-06 二次改版：① 从 3 列卡片换成榜单行——卡片的排序键（上榜次数）被压在
// 右下角灰字里，读者会把它读成「GDP 前 30」；同时删掉每城重复的「档案 N 项」。
//
// 数据：source/_data/cities.yml + cityrank.yml；计算：helpers/cityrank-data.js
// 样式：site.css §4.16（.cr-board / .cr-fold 规则）
page.layout = 'cityindex'
page.hide_banner = true

var CR = buildCityRanks(site.data)

/* 榜单里的数值统一加千分位（DESIGN-LANGUAGE §5.19）：1152822.4 读不出来，
   1,152,822.4 才读得出来。等宽栈下千分位不改变字宽节奏，只让位数可数。
   小数收到 1 位：GDP 的 2 位小数（24,763.61）是假精度，各城来源本身就在亿元级浮动。 */
function fmtCardNum(v) {
  if (v === null || v === undefined || v === '') return ''
  if (typeof v !== 'number') return String(v)
  var s = String(Math.round(v * 10) / 10)
  var parts = s.split('.')
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',')
  return parts.join('.')
}

/* 取城市某个指标的数值。metricValue 在 helper 里只做了 module.exports、
   没有注册成 Hexo helper，模板里拿不到，所以这里按其同一套判据内联一份：
   缺字段 / 值不是有限数字一律当「待补」，不按 0 处理。 */
function cardVal(city, field) {
  var m = (city && city.metrics) ? city.metrics[field] : null
  if (!m || typeof m !== 'object') return null
  var v = m.v
  return (typeof v === 'number' && isFinite(v)) ? v : null
}

// 按上榜次数降序，同次数按拼音 slug 升序（稳定次序）
var list = []
if (!CR.error) {
  for (var i = 0; i < CR.cities.length; i += 1) {
    var c = CR.cities[i]
    list.push({ c: c, n: cityMentionCount(CR, c.slug) })
  }
  list.sort(function (a, b) {
    if (b.n !== a.n) return b.n - a.n
    return String(a.c.slug).localeCompare(String(b.c.slug))
  })
}
var withMentions = 0
for (var j = 0; j < list.length; j += 1) { if (list[j].n > 0) withMentions += 1 }

// 前 30 座做成榜单行；其余按省折叠。城市不足 30 座时全部进榜，不产生空段。
var TOP_N = 30
var topRows = list.slice(0, TOP_N)
var restRows = list.slice(TOP_N)

// 横条按榜首的次数换算：读者不用读 30 个数字就能看出谁靠前。
var maxMentions = topRows.length ? topRows[0].n : 0
function barPct(n) {
  if (!maxMentions) return 0
  return Math.max(0, Math.round((n / maxMentions) * 100))
}

// 其余城市按省级行政区归组；没采集到归属的单列一组放最后
var byProv = {}
var provOrder = []
for (var r = 0; r < restRows.length; r += 1) {
  var pvName = restRows[r].c.province || '归属待补'
  if (!byProv[pvName]) {
    byProv[pvName] = []
    provOrder.push(pvName)
  }
  byProv[pvName].push(restRows[r])
}
// 省份次序沿用 GB/T 2260 的列表（与上方省份导航一致），未知归属排末尾
var provs = CR.error ? [] : cityProvinces(CR)
var provNames = []
for (var pv = 0; pv < provs.length; pv += 1) { provNames.push(provs[pv].name) }
provOrder.sort(function (a, b) {
  var ia = provNames.indexOf(a); if (ia < 0) ia = 999
  var ib = provNames.indexOf(b); if (ib < 0) ib = 999
  if (ia !== ib) return ia - ib
  return String(a).localeCompare(String(b), 'zh')
})
%>

<div class="paper-page cal-page cr-page">
  <div class="home-wrap">
    <header class="page-head">
      <nav class="cal-crumb" aria-label="面包屑">
        <%# 面包屑修正（2026-11-04，PLAN-V3 §5）：城市档案与城市排行榜是并列专题，
            不是它的子级。原来写成「资料库 / 城市排行榜 / 城市档案」，等于把城挂在了榜下面。 %>
        <a href="<%= url_for('/library/') %>">资料库</a><span aria-hidden="true">/</span><span class="cal-crumb-now">城市档案</span>
      </nav>
      <p class="page-head-kicker">CITY</p>
      <h1 class="page-head-title">城市档案</h1>
      <p class="cal-lede">收录在本站榜单中出现过的城市。有权威来源的字段直接列出并标注来源与年份，尚未采集到权威来源的字段一律标 [待补]，不做估算填充。</p>
      <p class="archive-total">更新于 <%= fmtItemDate(CR.meta.updated) %> · <%= list.length %> 座城市 · <%= withMentions %> 座有上榜记录 · 数据年份 <%= CR.cityMeta.dataYear || '2025' %></p>
    </header>

    <% if (CR.error) { %>
    <p class="post-desc">城市档案的数据还在整理中，暂时无法展示，欢迎稍后再来看看。</p>
    <!-- dev: <%= CR.error %> -->
    <% } else { %>

    <% if (provs.length) { %>
    <section class="cr-provnav">
      <h2 class="cr-sec-title">按省份浏览</h2>
      <ul class="cr-provnav-list">
        <% for (var pi = 0; pi < provs.length; pi += 1) { var pv2 = provs[pi] %>
        <%# 直辖市与特别行政区只有一座城市：中间的省级页只会再让人多按一次，
            直接链到那座城市的档案页（2026-11-06 主人指出「上海市还要再点一下上海」）。 %>
        <% var pvHref = (pv2.total === 1 && pv2.pageCount === 1 && pv2.cities && pv2.cities.length) ? ('/city/' + pv2.cities[0].slug + '/') : ('/city/province/' + pv2.slug + '/') %>
        <li><a href="<%= url_for(pvHref) %>"><%= pv2.name %><span class="cr-provnav-count"><%= pv2.total %></span></a></li>
        <% } %>
      </ul>
      <p class="cr-profile-note">按 GB/T 2260 行政区划代码排序。行政归属尚未采集的城市不进省级聚合，仍可在下方名单中查看。</p>
    </section>
    <% } %>

    <%# 2026-11-06 改版（主人：卡片「太离谱」）：原来 30 张等高卡片把「上榜次数」——
        本节的排序键——压在右下角 0.75rem 灰字里，视线第一落点反而是 GDP，读者会
        误读成「GDP 前 30」。改成榜单行：名次前置、上榜次数做主指标并配一条按榜首
        换算的横条、GDP 与人口右对齐；「档案 N 项」是后台采集进度，不是城市属性，
        整节删除（§5.19 同族，名次前置固定列）。 %>
    <section class="cr-sec-block">
      <h2 class="cr-sec-title">上榜最多的 <%= topRows.length %> 座</h2>
      <p class="cr-sec-note">按在本站榜单中出现的次数排序，次数相同按拼音次序。横条以榜首次数为满格；人口为常住人口。</p>
      <%#
        2026-11-08 三次改版（主人选 C：整页换回大图卡）：30 城配图到位后，
        榜单行里那张 44px 方图已没有存在意义，改成 16:9 封面的卡片网格。
        11-06 那条「排序键不能压在灰字里」的约束保留：名次做成封面角标，
        上榜次数做成正文第一行的大字 + 横条，GDP / 人口在下方、不再是第一落点。
        30 张按 3 / 2 / 1 列排（都是 30 的约数），任何断点末行都不留空格。
      %>
      <ol class="cr-tiles">
        <% var photos = (site.data && site.data.cityphotos) || {} %>
        <% for (var t = 0; t < topRows.length; t += 1) { var tr = topRows[t]; var tc = tr.c %>
        <% var gdp = cardVal(tc, 'gdp'); var pop = cardVal(tc, 'pop') %>
        <%# 只有 cityphotos.yml 登记过的城市才出图；没图的卡不放灰块、不放假图，
            用城市名排进封面区兜底（DESIGN §1「无数据不生成」）。 %>
        <% var photo = photos[tc.slug] %>
        <% var rankLabel = (t + 1) < 10 ? '0' + (t + 1) : String(t + 1) %>
        <li class="cr-tile">
          <a href="<%= url_for('/city/' + tc.slug + '/') %>">
            <span class="cr-tile-cover<% if (!photo) { %> cr-tile-cover--none<% } %>">
              <% if (photo) { %>
              <img class="cr-tile-photo" src="<%= url_for('/img/cities/' + tc.slug + '.jpg') %>" alt="<%= tc.name %>城市景观" width="1200" height="675" loading="lazy" decoding="async">
              <% } else { %>
              <span class="cr-tile-cover-name" aria-hidden="true"><%= tc.name %></span>
              <% } %>
              <span class="cr-tile-rank"><%= rankLabel %></span>
            </span>
            <span class="cr-tile-body">
              <span class="cr-tile-head">
                <span class="cr-tile-name"><%= tc.name %></span>
                <span class="cr-tile-meta"><%= tc.province || '' %><% if (tc.province && tc.level) { %> · <% } %><%= tc.level || '' %></span>
              </span>
              <span class="cr-tile-key">
                <b><%= tr.n > 0 ? tr.n : '—' %></b><i>次上榜</i>
                <span class="cr-tile-bar" aria-hidden="true"><span style="width: <%= barPct(tr.n) %>%"></span></span>
              </span>
              <span class="cr-tile-nums">
                <span class="cr-tile-num"><b><%= gdp === null ? '—' : fmtCardNum(gdp) %></b><% if (gdp !== null) { %><i>亿元</i><% } %></span>
                <span class="cr-tile-num"><b><%= pop === null ? '—' : fmtCardNum(pop) %></b><% if (pop !== null) { %><i>万人</i><% } %></span>
              </span>
            </span>
          </a>
        </li>
        <% } %>
      </ol>
    </section>

    <% if (restRows.length) { %>
    <section class="cr-sec-block">
      <h2 class="cr-sec-title">其余 <%= restRows.length %> 座</h2>
      <p class="cr-sec-note">按省级行政区折叠，点开即看。每行给出省份、级别与上榜次数，点城市名进档案。</p>
      <div class="cr-folds">
        <% for (var po = 0; po < provOrder.length; po += 1) { var pName = provOrder[po]; var pRows = byProv[pName] %>
        <details class="cr-fold">
          <summary class="cr-fold-head">
            <span class="cr-fold-name"><%= pName %></span>
            <span class="cr-fold-count"><%= pRows.length %> 座</span>
          </summary>
          <ul class="cr-fold-list">
            <% for (var q = 0; q < pRows.length; q += 1) { var qr = pRows[q]; var qc = qr.c %>
            <li class="cr-fold-item">
              <a href="<%= url_for('/city/' + qc.slug + '/') %>">
                <span class="cr-fold-city"><%= qc.name %></span>
                <span class="cr-fold-meta"><% if (qc.level) { %><%= qc.level %><% } %></span>
                <span class="cr-fold-n"><%= qr.n > 0 ? (qr.n + ' 次') : '—' %></span>
              </a>
            </li>
            <% } %>
          </ul>
        </details>
        <% } %>
      </div>
    </section>
    <% } %>

    <div class="cal-after">
      <p class="cal-note">城市档案持续扩充中：先收录榜单里出现过的城市，再逐步补齐面积、气候、环境、公共服务等字段，每一项都要有权威来源才写入。</p>
    </div>

    <% } %>
  </div>
</div>
