<%
// 城市榜详情页（/cityrank/<slug>/）：排名表 + 评分口径，右栏常驻同组榜单。
// 计算：themes/fluid/scripts/helpers/cityrank-data.js（名次现算；yml 里不存名次）
// 样式：site.css §4.16（.cr-* 规则）；视觉作用域复用 .cal-page
// 约定（PRD §5.1 P0 铁律）：computed 榜的名次是计算结果，页面必须公开指标与权重；
//   pending（参考榜）的来源说明、收录范围与免责柔和合并为页脚一条小字
//   （主人 2026-11-01 拍板：警示框与重复 lede 已删，全页只此一条）。
// 布局（主人 2026-10-28 定）：同组榜单放右侧常驻侧栏，不用划到页面底部才能看到。
page.layout = 'rank'
page.hide_banner = true

var CR = buildCityRanks(site.data)
var found = CR.error ? null : findRank(CR, page.rankSlug)
var g = found ? found.group : null
var r = found ? found.rank : null

var KIND_LABEL = { computed: '本站按公开数据计算', fact: '权威结果引用', pending: '参考榜' }
%>

<div class="paper-page cal-page cr-page">
  <div class="home-wrap">
    <% if (!r) { %>
    <header class="page-head">
      <p class="page-head-kicker">CITY RANK</p>
      <h1 class="page-head-title">城市排行榜</h1>
    </header>
    <p class="post-desc">这个榜单没有就位（<code><%= page.rankSlug || '未知榜单' %></code>）：<%= CR.error || '数据里找不到该榜单' %>。</p>
    <% } else { %>

    <header class="page-head">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href="<%= url_for('/library/') %>">资料库</a><span aria-hidden="true">/</span><a href="<%= url_for('/cityrank/') %>">城市排行榜</a><span aria-hidden="true">/</span><span class="cal-crumb-now"><%= r.title %></span>
      </nav>
      <p class="page-head-kicker"><%= g.kicker || 'CITY RANK' %></p>
      <h1 class="page-head-title"><%= r.title %></h1>
      <% if (r.lede) { %><p class="cal-lede"><%= r.lede %></p><% } %>
      <p class="archive-total">
        更新于 <%= fmtItemDate(CR.meta.updated) %> · 数据年份 <%= CR.cityMeta.dataYear || '2025' %> · 候选城市 <%= r.candidateCount %> 座 · <%= KIND_LABEL[r.kind] || r.kind %>
      </p>
    </header>

    <div class="cr-layout">
      <div class="cr-main">

        <% var hasReason = false; for (var hi = 0; hi < r.items.length; hi += 1) { if (r.items[hi].reason) { hasReason = true; break; } } %>
        <% var hasProv = false; for (var pi = 0; pi < r.items.length; pi += 1) { if (r.items[pi].province) { hasProv = true; break; } } %>
        <% if (r.items.length) { %>
        <table class="cr-table">
          <caption class="cr-caption"><%= r.title %>（按<%= r.kind === 'computed' ? '综合指数' : '名次' %>排列）</caption>
          <thead>
            <tr>
              <th scope="col" class="cr-th-rank">名次</th>
              <th scope="col" class="cr-th-city">城市</th>
              <% if (hasProv) { %><th scope="col" class="cr-th-prov">省级行政区</th><% } %>
              <% if (r.kind === 'computed') { %><th scope="col" class="cr-th-score">综合指数</th><% } %>
              <% if (hasReason) { %><th scope="col" class="cr-th-val">上榜说明</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% for (var i = 0; i < r.items.length; i += 1) { var it = r.items[i] %>
            <tr class="cr-row<%= it.rank <= 3 ? ' cr-row-top' : '' %>">
              <th scope="row" class="cr-rank"><span class="cr-rank-num"><%= it.rank < 10 ? '0' + it.rank : String(it.rank) %></span></th>
              <td class="cr-city">
                <a href="<%= url_for('/city/' + it.slug + '/') %>"><%= it.name %></a>
              </td>
              <% if (hasProv) { %><td class="cr-prov"><%= it.province %></td><% } %>
              <% if (r.kind === 'computed') { %><td class="cr-score"><%= it.score %></td><% } %>
              <% if (hasReason) { %><td class="cr-val"><%= it.reason %></td><% } %>
            </tr>
            <% } %>
          </tbody>
        </table>
        <% } else { %>
        <p class="cr-empty">这个榜还没有可发布的数据（候选城市不足）。</p>
        <% } %>

        <% if (r.kind === 'computed' && r.metrics.length) { %>
        <section class="cr-method">
          <h2 class="cr-method-title">评分口径</h2>
          <table class="cr-method-table">
            <thead>
              <tr>
                <th scope="col">指标</th>
                <th scope="col">权重</th>
                <th scope="col">方向</th>
                <th scope="col">刻度</th>
                <th scope="col">单位</th>
                <th scope="col">数据年份</th>
              </tr>
            </thead>
            <tbody>
              <% for (var mi = 0; mi < r.metrics.length; mi += 1) { var mt = r.metrics[mi] %>
              <tr>
                <td><%= mt.label || mt.field %></td>
                <td><%= mt.weight %></td>
                <td><%= mt.dir === 'down' ? '越小越好' : '越大越好' %></td>
                <td><%= mt.scale === 'log' ? '对数' : '线性' %></td>
                <td><%= mt.unit || '—' %></td>
                <td><%= CR.cityMeta.dataYear || '2025' %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
          <p class="cr-method-note">名次由数据算出，不是先定名次再配分数。每项指标在本榜 <strong><%= r.candidateCount %> 座候选城市</strong>内归一化到 0–100，再按上表权重加权求和得综合指数（保留 1 位小数）；100 分 = 候选池最高值，0 分 = 候选池最低值。缺任一指标的城市不参与本榜，不按 0 分处理。</p>
          <% var hasLog = false; for (var si = 0; si < r.metrics.length; si += 1) { if (r.metrics[si].scale === 'log') { hasLog = true; break; } } %>
          <% if (hasLog) { %><p class="cr-method-note">刻度为「线性」的指标按 <code>(x − 最小) / (最大 − 最小)</code> 计算；刻度为「对数」的指标（地区生产总值、常住人口、行政区域面积这类跨数量级的规模量）先取自然对数再按同一公式。后者按倍数关系定距，与联合国人类发展指数对收入维度的处理一致——这类量在候选池里是极端右偏分布，若用线性刻度，唯一的极端最大值会把整个刻度拽走，第 10 名与中位数城市都会被压到很低。</p><% } %>
          <% if (r.note) { %><p class="cr-method-note"><%= r.note %></p><% } %>
        </section>
        <% } %>

        <div class="cal-after">
          <p class="cal-note">
            <% if (r.kind === 'computed') { %>
            数据来自各地统计公报与行业主管部门公开名录；批量数据站只作交叉核对，不作唯一来源。数据年份 <%= CR.cityMeta.dataYear || '2025' %>。
            <% } else if (r.kind === 'fact') { %>
            本榜为权威评选结果引用，名次非本站计算，已注明来源与年度。
            <% } else { %>
            本榜名次整理自公开榜单，<%= hasReason ? '上榜理由见表内说明；' : '仅收录名次；' %>属观点性排名，未做量化核验，仅供参考。
            <% } %>
          </p>
        </div>

      </div>

      <%# 右栏常驻：同组榜单 + 其他主题组；桌面 sticky，移动端落到内容下方 %>
      <aside class="cr-side" aria-label="榜单导航">
        <%# 同组榜单：当前榜始终排在最前，其余按标题去重——对标站有同标题不同 id 的榜，
            不去重会在侧栏出现两条一模一样的链接。 %>
        <% var navItems = []; var seenT = {}; %>
        <% navItems.push(r); seenT[r.title] = true; %>
        <% for (var ni = 0; ni < g.ranks.length; ni += 1) { var nf = g.ranks[ni] %>
        <%   if (nf.slug !== r.slug && !seenT[nf.title]) { navItems.push(nf); seenT[nf.title] = true; } %>
        <% } %>
        <div class="cr-side-block">
          <p class="cr-side-label">同组榜单</p>
          <ul class="cr-side-list">
            <% for (var vi = 0; vi < navItems.length; vi += 1) { var nv = navItems[vi] %>
            <li>
              <% if (nv.slug === r.slug) { %>
              <span class="cr-side-current" aria-current="page"><%= nv.title %></span>
              <% } else { %>
              <a href="<%= url_for('/cityrank/' + nv.slug + '/') %>"><%= nv.title %></a>
              <% } %>
            </li>
            <% } %>
          </ul>
        </div>

        <div class="cr-side-block">
          <p class="cr-side-label">其他主题</p>
          <ul class="cr-side-list">
            <% for (var oi = 0; oi < CR.groups.length; oi += 1) { var og = CR.groups[oi] %>
            <li>
              <% if (og.key === g.key) { %>
              <span class="cr-side-muted"><%= og.title %></span>
              <% } else { %>
              <a href="<%= url_for('/cityrank/') %>#group-<%= og.key %>"><%= og.title %></a>
              <% } %>
            </li>
            <% } %>
          </ul>
        </div>

        <p class="cr-side-note"><a href="<%= url_for('/city/') %>">按城市查看档案 →</a></p>
      </aside>
    </div>

    <% } %>
  </div>
</div>
