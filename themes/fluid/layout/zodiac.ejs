<%
// 生肖页面族（/zodiac/、/zodiac/<动物>/）：与节假日页同族的工具型纸面页。
//   —— 页头（kicker + 标题 + 生肖导航）+ 双栏（左年份表 / 右基本信息）+
//      性格、配对、幸运物、词汇若干表 + 正文与常见问题 + 上一页/下一页。
// 数据：source/_data/zodiac.yml（唯一数据源，页面文案与词汇都在里面）
// 计算：themes/fluid/scripts/helpers/zodiac-data.js（干支、起止、地支关系）
// 样式：site.css §4.13（.z-* 规则）；视觉作用域复用 .cal-page（参考站破例，见 holidays.ejs）
// 约定：模板不含手写日期——页面上的每个日期都由 helper 从数据算出。
page.layout = 'zodiac'
page.hide_banner = true

var z = page.animal ? zodiacData(site.data.zodiac, page.animal) : null
// 索引数据在两种页面都要构建：动物页拿它的 rows 做生肖导航，索引页自身就是它
var ov = zodiacOverview(site.data.zodiac)
%>

<% if (!z && !ov) { %>
<div class="paper-page cal-page z-page">
  <div class="home-wrap">
    <header class="page-head">
      <p class="page-head-kicker">ZODIAC</p>
      <h1 class="page-head-title">十二生肖</h1>
    </header>
    <p class="post-desc">生肖数据还没填。先在 <code>source/_data/zodiac.yml</code> 里补上，页面会自动生成。</p>
  </div>
</div>
<% } else if (z) { %>

<div class="paper-page cal-page z-page">
  <div class="home-wrap">
    <header class="page-head">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href="<%= url_for('/zodiac/') %>">十二生肖</a><span aria-hidden="true">/</span><span class="cal-crumb-now"><%= z.animal %></span>
      </nav>
      <div class="cal-head-row">
        <div>
          <p class="page-head-kicker">ZODIAC</p>
          <h1 class="page-head-title"><%= z.title %></h1>
        </div>
        <%# 生肖导航：十二个生肖 4 列网格，当前生肖墨色加粗 + 2px 下划线（与节假日页年份块同一手法） %>
        <nav class="cal-years z-nav" aria-label="按生肖查看">
          <span class="cal-years-label">按生肖查看</span>
          <ul>
            <% for (var ai = 0; ai < ov.rows.length; ai += 1) { var na = ov.rows[ai] %>
            <li>
              <% if (na.key === z.key) { %>
              <span class="cal-year-current z-animal-current" aria-current="page"><%= na.animal %></span>
              <% } else { %>
              <a href="<%= url_for('/zodiac/' + na.key + '/') %>"><%= na.animal %></a>
              <% } %>
            </li>
            <% } %>
          </ul>
        </nav>
      </div>
      <p class="cal-lede"><%- z.lede %></p>
      <p class="archive-total">
        更新于 <%= fmtItemDate(z.updated) %> · 生肖年共 <%= z.spanDays %> 天 · 同一干支 <%= z.sameGanzhi.join(' · ') %>
      </p>
    </header>

    <div class="cal-top">
      <section class="cal-block">
        <div class="col-head">
          <h2 class="col-title"><%= z.animal %>年都有哪一年</h2>
          <span class="col-count">/ <%= z.occurrences.length %></span>
        </div>
        <div class="cal-table-wrap">
          <table class="cal-table">
            <thead>
              <tr>
                <th scope="col">年份</th>
                <th scope="col">干支</th>
                <th scope="col">五行 · 阴阳</th>
                <th scope="col">称号</th>
              </tr>
            </thead>
            <tbody>
              <% for (var oi = 0; oi < z.occurrences.length; oi += 1) { var oc = z.occurrences[oi] %>
              <tr<% if (oc.current) { %> class="is-hl"<% } %>>
                <th scope="row"><span class="cal-name"><%= oc.year %></span></th>
                <td><%= oc.ganzhi %></td>
                <td><%= oc.element %> · <%= oc.yinyang %></td>
                <td><%= oc.title %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="cal-block cal-year">
        <div class="col-head">
          <h2 class="col-title">基本信息</h2>
        </div>
        <div class="cal-table-wrap">
          <table class="cal-table z-facts">
            <tbody>
              <% for (var fi = 0; fi < z.facts.length; fi += 1) { var fa = z.facts[fi] %>
              <tr>
                <th scope="row"><%= fa.k %></th>
                <td><%- fa.v %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="cal-after">
          <p class="cal-note">生肖年从春节当天开始，到次年除夕结束；1、2 月出生的人属相可能属于上一年，需核对出生当年的春节日期。起止日期与本站<a href="<%= url_for('/holidays/' + z.featured + '/') %>"><%= z.featured %> 年节假日页</a>一致。</p>
        </div>
      </section>
    </div>

    <section class="cal-block z-traits">
      <div class="col-head">
        <h2 class="col-title">传统上的性格说法</h2>
        <span class="cal-tag">民间说法</span>
      </div>
      <div class="z-trait-cols">
        <div class="z-trait-col">
          <h3>常见优点</h3>
          <ul>
            <% for (var pi = 0; pi < z.pros.length; pi += 1) { %>
            <li><%= z.pros[pi] %></li>
            <% } %>
          </ul>
        </div>
        <div class="z-trait-col">
          <h3>常见短板</h3>
          <ul>
            <% for (var ci = 0; ci < z.cons.length; ci += 1) { %>
            <li><%= z.cons[ci] %></li>
            <% } %>
          </ul>
        </div>
      </div>
      <% if (z.theme) { %>
      <p class="z-theme">核心意象：<%= z.theme %></p>
      <% } %>
    </section>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">传统配对</h2>
        <span class="cal-tag">地支关系</span>
      </div>
      <div class="cal-table-wrap">
        <table class="cal-table z-relations">
          <thead>
            <tr>
              <th scope="col">关系</th>
              <th scope="col">生肖</th>
              <th scope="col">传统解释</th>
            </tr>
          </thead>
          <tbody>
            <% for (var ri = 0; ri < z.relations.length; ri += 1) { var rel = z.relations[ri] %>
            <tr>
              <th scope="row"><span class="cal-name"><%= rel.name %></span></th>
              <td><%= rel.partners.join('、') %></td>
              <td><%= rel.note %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <p class="z-note">这些关系出自地支之间固定的组合（三合 / 六合 / 六冲 / 六害 / 相刑），各参考书列法一致；但传统命理看整张命盘，不凭生肖一句定论。</p>
    </section>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">幸运数字与颜色</h2>
        <span class="cal-tag">民间说法</span>
      </div>
      <div class="cal-table-wrap">
        <table class="cal-table z-luck">
          <tbody>
            <% for (var li = 0; li < z.luck.length; li += 1) { var lk = z.luck[li] %>
            <tr>
              <th scope="row"><%= lk.k %></th>
              <td><%= lk.v %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (z.luckNote) { %>
      <p class="z-note"><%= z.luckNote %></p>
      <% } else if (z.luck.length <= 1) { %>
      <p class="z-note">民间流行的幸运数字与颜色各来源互有出入，本站只列有传统依据的五行对应，不列相互矛盾的吉凶数。</p>
      <% } %>
    </section>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">相关词汇</h2>
        <span class="col-count">/ <%= z.vocab.length %></span>
      </div>
      <div class="cal-table-wrap">
        <table class="cal-table z-vocab">
          <thead>
            <tr>
              <th scope="col">中文</th>
              <th scope="col">拼音</th>
              <th scope="col">含义</th>
              <th scope="col">备注</th>
            </tr>
          </thead>
          <tbody>
            <% for (var vi = 0; vi < z.vocab.length; vi += 1) { var vb = z.vocab[vi] %>
            <tr>
              <th scope="row"><span class="cal-name"><%= vb.t %></span></th>
              <td class="cal-pinyin"><%= vb.p %></td>
              <td><%= vb.m %></td>
              <td class="z-vocab-note"><%= vb.n %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="cal-notes">
      <article class="about-body cal-prose">
        <div class="markdown-body">
          <%- z.culture %>
        </div>
      </article>

      <% if (z.faq.length) { %>
      <aside class="cal-faq">
        <h2 class="col-title">关于 <%= z.featured %> <%= z.animal %>年的常见问题</h2>
        <% for (var qi = 0; qi < z.faq.length; qi += 1) { var item = z.faq[qi] %>
        <details class="cal-faq-item">
          <summary><%= item.q %></summary>
          <p><%= item.a %></p>
        </details>
        <% } %>
      </aside>
      <% } %>
    </div>

    <nav class="z-pager" aria-label="上下生肖">
      <a class="z-pager-prev" href="<%= url_for('/zodiac/' + z.prev.key + '/') %>">← <%= z.prev.animal %>年</a>
      <a class="z-pager-next" href="<%= url_for('/zodiac/' + z.next.key + '/') %>"><%= z.next.animal %>年 →</a>
    </nav>

    <div class="cal-after">
      <p class="cal-note">干支与农历日期依据公开历法资料整理，生肖年以农历正月初一为界（GB/T 33661-2017《农历的编算和颁行》）。性格、配对与幸运物是民间流传的说法，各来源措辞相近但并无统一出处，当作文化话题看即可。</p>
    </div>
  </div>
</div>

<% } else { %>

<div class="paper-page cal-page z-page">
  <div class="home-wrap">
    <header class="page-head">
      <div class="cal-head-row">
        <div>
          <p class="page-head-kicker">ZODIAC</p>
          <h1 class="page-head-title">十二生肖</h1>
        </div>
        <nav class="cal-years z-nav" aria-label="按生肖查看">
          <span class="cal-years-label">按生肖查看</span>
          <ul>
            <% for (var ni = 0; ni < ov.rows.length; ni += 1) { var nr = ov.rows[ni] %>
            <li>
              <a href="<%= url_for('/zodiac/' + nr.key + '/') %>"><%= nr.animal %></a>
            </li>
            <% } %>
          </ul>
        </nav>
      </div>
      <p class="cal-lede"><%- ov.lede %></p>
      <p class="archive-total">
        更新于 <%= fmtItemDate(ov.updated) %> · <%= ov.rows.length %> 个生肖 · 本轮 <%= ov.cycle.from %>–<%= ov.cycle.to %>
      </p>
    </header>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">十二生肖一览</h2>
        <span class="col-count">/ <%= ov.rows.length %></span>
      </div>
      <div class="cal-table-wrap">
        <table class="cal-table z-animals">
          <thead>
            <tr>
              <th scope="col">位次</th>
              <th scope="col">生肖</th>
              <th scope="col">拼音</th>
              <th scope="col">地支</th>
              <th scope="col">本轮年份</th>
              <th scope="col">干支</th>
              <th scope="col">称号</th>
            </tr>
          </thead>
          <tbody>
            <% for (var ri2 = 0; ri2 < ov.rows.length; ri2 += 1) { var r = ov.rows[ri2] %>
            <tr>
              <td class="z-pos"><%= r.position %></td>
              <th scope="row"><a class="z-animal-link" href="<%= url_for('/zodiac/' + r.key + '/') %>"><span class="cal-name"><%= r.animal %></span></a></th>
              <td class="cal-pinyin"><%= r.pinyin %></td>
              <td><%= r.branch %></td>
              <td><% if (r.span) { %><time datetime="<%= r.span.start %>"><%= r.featured %></time><% } else { %><%= r.featured %><% } %></td>
              <td><%= r.ganzhi %></td>
              <td><%= r.title %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">按出生年份查生肖</h2>
      </div>
      <p class="cal-fest-lead">找到出生年份对应的生肖即可。出生在 1 月或 2 月初的人，属相可能属于上一年——生肖年按春节更替，不按 1 月 1 日，请以出生当年的春节日期为准。</p>
      <div class="cal-table-wrap">
        <table class="cal-table z-birth">
          <thead>
            <tr>
              <th scope="col">生肖</th>
              <th scope="col">出生年份（每 12 年一轮）</th>
            </tr>
          </thead>
          <tbody>
            <% for (var bi = 0; bi < ov.rows.length; bi += 1) { var br = ov.rows[bi] %>
            <tr>
              <th scope="row"><a class="z-animal-link" href="<%= url_for('/zodiac/' + br.key + '/') %>"><span class="cal-name"><%= br.animal %></span></a></th>
              <td><%= br.birthYears.join(' · ') %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="cal-top">
      <section class="cal-block">
        <div class="col-head">
          <h2 class="col-title">五行与传统方位、颜色</h2>
        </div>
        <div class="cal-table-wrap">
          <table class="cal-table z-elements">
            <thead>
              <tr>
                <th scope="col">五行</th>
                <th scope="col">天干</th>
                <th scope="col">方位</th>
                <th scope="col">传统色</th>
              </tr>
            </thead>
            <tbody>
              <% for (var ei = 0; ei < ov.elements.length; ei += 1) { var el = ov.elements[ei] %>
              <tr>
                <th scope="row"><span class="cal-name"><%= el.element %></span></th>
                <td><%= el.stems %></td>
                <td><%= el.direction %></td>
                <td><%= el.color %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <p class="z-note">五行与方位、颜色的对应是传统说法（《黄帝内经》一系），不是命理吉凶；生肖的五行由天干决定，每十年一轮。</p>
      </section>

      <section class="cal-block cal-year">
        <div class="col-head">
          <h2 class="col-title">三合与相冲</h2>
        </div>
        <div class="cal-table-wrap">
          <table class="cal-table z-sanhe">
            <thead>
              <tr>
                <th scope="col">组合</th>
                <th scope="col">传统解释</th>
              </tr>
            </thead>
            <tbody>
              <% for (var si = 0; si < ov.sanhe.length; si += 1) { var sh = ov.sanhe[si] %>
              <tr>
                <th scope="row"><span class="cal-name"><%= sh.animals.join('') %></span></th>
                <td>三合，三者合成<%= sh.ju %>，互相增强</td>
              </tr>
              <% } %>
              <% for (var chi = 0; chi < ov.chong.length; chi += 1) { var ch = ov.chong[chi] %>
              <tr>
                <th scope="row"><span class="cal-name"><%= ch.join('') %></span></th>
                <td>六冲，正对相对，传统上是最强的对立</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="cal-notes">
      <article class="about-body cal-prose">
        <div class="markdown-body">
          <%- ov.prose %>
        </div>
      </article>

      <% if (ov.faq.length) { %>
      <aside class="cal-faq">
        <h2 class="col-title">关于生肖的常见问题</h2>
        <% for (var fi2 = 0; fi2 < ov.faq.length; fi2 += 1) { var item2 = ov.faq[fi2] %>
        <details class="cal-faq-item">
          <summary><%= item2.q %></summary>
          <p><%= item2.a %></p>
        </details>
        <% } %>
      </aside>
      <% } %>
    </div>

    <div class="cal-after">
      <p class="cal-note">生肖与干支依据公开历法资料整理，生肖年以农历正月初一为界（GB/T 33661-2017《农历的编算和颁行》）；各生肖年的起止日期与本站节假日页一致。性格与幸运物是民间流传的说法，只作参考。</p>
    </div>
  </div>
</div>

<% } %>
