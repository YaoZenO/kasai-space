<%
// 生肖页面族（/zodiac/、/zodiac/<动物>/）：2026-10-25 重构为「生肖主题页」。
//   —— 页头（标题只写生肖名）+ 全宽生肖导航条 + 配图 + 两栏（左正文 / 右 sticky 目录）；
//      目录带阅读进度环与收起按钮，移动端为底部抽屉（复刻参考站交互）。
// 数据：source/_data/zodiac.yml（唯一数据源）
// 计算：themes/fluid/scripts/helpers/zodiac-data.js（干支、起止、地支关系、章节注入）
// 样式：site.css §4.13（.z-* 规则）；视觉作用域复用 .cal-page（参考站破例）
// 脚本：source/js/zodiac.js（进度环 / scrollspy / 收起展开 / 移动抽屉；无脚本时目录锚点仍可用）
// 约定：模板不含手写日期——页面上的每个日期都由 helper 从数据算出。
page.layout = 'zodiac'
page.hide_banner = true

var z = page.animal ? zodiacData(site.data.zodiac, page.animal) : null
// 索引数据在两种页面都要构建：动物页拿它的 rows 做生肖导航，索引页自身就是它
var ov = zodiacOverview(site.data.zodiac)
%>

<% if (!z && !ov) { %>
<div class="paper-page cal-page z-page">
  <div class="home-wrap">
    <header class="page-head">
      <p class="page-head-kicker">ZODIAC</p>
      <h1 class="page-head-title">十二生肖</h1>
    </header>
    <p class="post-desc">生肖数据还没填。先在 <code>source/_data/zodiac.yml</code> 里补上，页面会自动生成。</p>
  </div>
</div>
<% } else if (z) { %>

<div class="paper-page cal-page z-page">
  <div class="home-wrap">
    <header class="page-head">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href="<%= url_for('/zodiac/') %>">十二生肖</a><span aria-hidden="true">/</span><span class="cal-crumb-now"><%= z.animal %></span>
      </nav>
      <p class="page-head-kicker">ZODIAC</p>
      <h1 class="page-head-title"><%= z.title %></h1>
      <p class="cal-lede"><%- z.lede %></p>
      <p class="archive-total">
        更新于 <%= fmtItemDate(z.updated) %> · <%= z.positionCn %>位 · 地支「<%= z.branch %>」 · 本轮 <%= z.featured %>
      </p>
    </header>

    <%# 生肖导航条：全宽横排，不再与标题挤同一行（2026-10-25 主人指出旧版右栏导航与标题视觉不对齐，
        横排条从结构上消除该问题）。当前生肖墨色加粗 + 2px 下划线。 %>
    <nav class="z-nav-strip" aria-label="按生肖查看">
      <span class="z-nav-strip-label">按生肖查看</span>
      <ul>
        <% for (var ai = 0; ai < ov.rows.length; ai += 1) { var na = ov.rows[ai] %>
        <li>
          <% if (na.key === z.key) { %>
          <span class="z-nav-current" aria-current="page"><%= na.animal %></span>
          <% } else { %>
          <a href="<%= url_for('/zodiac/' + na.key + '/') %>"><%= na.animal %></a>
          <% } %>
        </li>
        <% } %>
      </ul>
    </nav>

    <%# 配图：Wikimedia Commons 自由授权图，署名与授权是使用条件，必须渲染出来 %>
    <% if (z.image) { %>
    <figure class="z-figure">
      <img src="<%= z.image.file %>" alt="<%= z.image.alt %>" loading="lazy" decoding="async">
      <figcaption>
        图：<a href="<%= z.image.page %>" target="_blank" rel="noopener"><%= z.image.author %></a> / <%= z.image.license %>
      </figcaption>
    </figure>
    <% } %>

    <div class="z-layout">
      <div class="z-main">
        <% for (var si = 0; si < z.sections.length; si += 1) { var sec = z.sections[si] %>
        <section class="z-section" id="sec-<%= sec.id %>">
          <h2 class="z-section-title"><%= sec.title %></h2>

          <% if (sec.id === 'what') { %>
          <div class="markdown-body"><%- sec.body %></div>
          <% if (z.facts.length) { %>
          <div class="cal-table-wrap">
            <table class="cal-table z-facts">
              <tbody>
                <% for (var fi = 0; fi < z.facts.length; fi += 1) { var fa = z.facts[fi] %>
                <tr>
                  <th scope="row"><%= fa.k %></th>
                  <td><%- fa.v %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% } %>
          <h3 class="z-sub-title">历年的<%= z.animal %>年</h3>
          <div class="cal-table-wrap">
            <table class="cal-table z-years">
              <thead>
                <tr>
                  <th scope="col">年份</th>
                  <th scope="col">干支</th>
                  <th scope="col">五行 · 阴阳</th>
                  <th scope="col">称号</th>
                </tr>
              </thead>
              <tbody>
                <% for (var oi = 0; oi < z.occurrences.length; oi += 1) { var oc = z.occurrences[oi] %>
                <tr<% if (oc.current) { %> class="is-hl"<% } %>>
                  <th scope="row"><span class="cal-name"><%= oc.year %></span></th>
                  <td><%= oc.ganzhi %></td>
                  <td><%= oc.element %> · <%= oc.yinyang %></td>
                  <td><%= oc.title %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <p class="z-note">生肖年从春节当天开始；1、2 月出生的人属相可能属于上一年，需核对出生当年的春节日期。起止日期与本站<a href="<%= url_for('/holidays/' + z.featured + '/') %>"><%= z.featured %> 年节假日页</a>一致。</p>

          <% } else if (sec.id === 'relations') { %>
          <p>这些关系出自地支之间固定的组合，各参考书列法一致；但传统命理看整张命盘，不凭生肖一句定论。</p>
          <div class="cal-table-wrap">
            <table class="cal-table z-relations">
              <thead>
                <tr>
                  <th scope="col">关系</th>
                  <th scope="col">生肖</th>
                  <th scope="col">传统解释</th>
                </tr>
              </thead>
              <tbody>
                <% for (var ri = 0; ri < z.relations.length; ri += 1) { var rel = z.relations[ri] %>
                <tr>
                  <th scope="row"><span class="cal-name"><%= rel.name %></span></th>
                  <td><%= rel.partners.join('、') %></td>
                  <td><%= rel.note %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% } else if (sec.id === 'luck') { %>
          <div class="cal-table-wrap">
            <table class="cal-table z-luck">
              <tbody>
                <% for (var li = 0; li < z.luck.length; li += 1) { var lk = z.luck[li] %>
                <tr>
                  <th scope="row"><%= lk.k %></th>
                  <td><%= lk.v %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (z.luckNote) { %>
          <p class="z-note"><%= z.luckNote %></p>
          <% } else if (z.luck.length <= 1) { %>
          <p class="z-note">民间流行的幸运数字与颜色各来源互有出入，本站只列有传统依据的五行对应，不列相互矛盾的吉凶数。</p>
          <% } %>

          <% } else if (sec.id === 'vocab') { %>
          <div class="markdown-body"><%- sec.body %></div>
          <div class="cal-table-wrap">
            <table class="cal-table z-vocab">
              <thead>
                <tr>
                  <th scope="col">中文</th>
                  <th scope="col">拼音</th>
                  <th scope="col">含义</th>
                  <th scope="col">备注</th>
                </tr>
              </thead>
              <tbody>
                <% for (var vi = 0; vi < z.vocab.length; vi += 1) { var vb = z.vocab[vi] %>
                <tr>
                  <th scope="row"><span class="cal-name"><%= vb.t %></span></th>
                  <td class="cal-pinyin"><%= vb.p %></td>
                  <td><%= vb.m %></td>
                  <td class="z-vocab-note"><%= vb.n %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% } else if (sec.id === 'faq') { %>
          <% if (z.faq.length) { %>
          <div class="z-faq">
            <% for (var qi = 0; qi < z.faq.length; qi += 1) { var item = z.faq[qi] %>
            <details class="cal-faq-item">
              <summary><%= item.q %></summary>
              <p><%= item.a %></p>
            </details>
            <% } %>
          </div>
          <% } %>

          <% } else if (sec.body) { %>
          <div class="markdown-body"><%- sec.body %></div>
          <% } %>
        </section>
        <% } %>

        <nav class="z-pager" aria-label="上下生肖">
          <a class="z-pager-prev" href="<%= url_for('/zodiac/' + z.prev.key + '/') %>">← <%= z.prev.animal %>年</a>
          <a class="z-pager-next" href="<%= url_for('/zodiac/' + z.next.key + '/') %>"><%= z.next.animal %>年 →</a>
        </nav>

        <div class="cal-after">
          <p class="cal-note">干支与农历日期依据公开历法资料整理，生肖年以农历正月初一为界（GB/T 33661-2017《农历的编算和颁行》）。性格与幸运物是民间流传的说法，各来源措辞相近但并无统一出处，当作文化话题看即可。</p>
        </div>
      </div>

      <%# 右侧目录：桌面 sticky；列表由模板按 sections 渲染（无 JS 时锚点仍可用），
          JS 只增强：进度环、当前章高亮、收起展开。 %>
      <aside class="z-toc" aria-label="目录">
        <div class="z-toc-head">
          <span class="z-toc-label">目录</span>
          <button class="z-toc-toggle" type="button" aria-expanded="true" aria-label="收起目录">
            <svg class="z-toc-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
        </div>
        <ol class="z-toc-list">
          <% for (var ti = 0; ti < z.sections.length; ti += 1) { var tsec = z.sections[ti] %>
          <li>
            <a href="#sec-<%= tsec.id %>"><%= tsec.title %></a>
          </li>
          <% } %>
        </ol>
        <div class="z-toc-progress">
          <svg class="z-ring" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
            <circle class="z-ring-bg" cx="18" cy="18" r="15.5" />
            <circle class="z-ring-fill" id="zProgressRing" cx="18" cy="18" r="15.5" stroke-dasharray="97.4" stroke-dashoffset="97.4" />
          </svg>
          <span class="z-toc-progress-text">已读 0%</span>
        </div>
      </aside>
    </div>
  </div>
</div>

<%# 移动端目录：悬浮按钮 + 底部抽屉（参考站同款交互） %>
<button class="z-toc-fab" type="button" aria-label="打开目录">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18" /></svg>
  <span>目录</span>
</button>
<div class="z-toc-overlay"></div>
<div class="z-toc-sheet" role="dialog" aria-label="目录" aria-hidden="true">
  <div class="z-toc-sheet-head">
    <span class="z-toc-label">目录</span>
    <button class="z-toc-sheet-close" type="button" aria-label="关闭目录">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
  <ol class="z-toc-list">
    <% for (var mi = 0; mi < z.sections.length; mi += 1) { var msec = z.sections[mi] %>
    <li>
      <a href="#sec-<%= msec.id %>"><%= msec.title %></a>
    </li>
    <% } %>
  </ol>
</div>

<script src="<%= versionedAsset('/js/zodiac.js') %>" defer></script>

<% } else { %>

<div class="paper-page cal-page z-page">
  <div class="home-wrap">
    <header class="page-head">
      <p class="page-head-kicker">ZODIAC</p>
      <h1 class="page-head-title">十二生肖</h1>
      <p class="cal-lede"><%- ov.lede %></p>
      <p class="archive-total">
        更新于 <%= fmtItemDate(ov.updated) %> · <%= ov.rows.length %> 个生肖 · 本轮 <%= ov.cycle.from %>–<%= ov.cycle.to %>
      </p>
    </header>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">十二生肖一览</h2>
        <span class="col-count">/ <%= ov.rows.length %></span>
      </div>
      <div class="cal-table-wrap">
        <table class="cal-table z-animals">
          <thead>
            <tr>
              <th scope="col">位次</th>
              <th scope="col">生肖</th>
              <th scope="col">拼音</th>
              <th scope="col">地支</th>
              <th scope="col">本轮年份</th>
              <th scope="col">干支</th>
              <th scope="col">称号</th>
            </tr>
          </thead>
          <tbody>
            <% for (var ri2 = 0; ri2 < ov.rows.length; ri2 += 1) { var r = ov.rows[ri2] %>
            <tr>
              <td class="z-pos"><%= r.position %></td>
              <th scope="row"><a class="z-animal-link" href="<%= url_for('/zodiac/' + r.key + '/') %>"><span class="cal-name"><%= r.animal %></span></a></th>
              <td class="cal-pinyin"><%= r.pinyin %></td>
              <td><%= r.branch %></td>
              <td><% if (r.span) { %><time datetime="<%= r.span.start %>"><%= r.featured %></time><% } else { %><%= r.featured %><% } %></td>
              <td><%= r.ganzhi %></td>
              <td><%= r.title %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="cal-block">
      <div class="col-head">
        <h2 class="col-title">按出生年份查生肖</h2>
      </div>
      <p class="cal-fest-lead">找到出生年份对应的生肖即可。出生在 1 月或 2 月初的人，属相可能属于上一年——生肖年按春节更替，不按 1 月 1 日，请以出生当年的春节日期为准。</p>
      <div class="cal-table-wrap">
        <table class="cal-table z-birth">
          <thead>
            <tr>
              <th scope="col">生肖</th>
              <th scope="col">出生年份（每 12 年一轮）</th>
            </tr>
          </thead>
          <tbody>
            <% for (var bi = 0; bi < ov.rows.length; bi += 1) { var br = ov.rows[bi] %>
            <tr>
              <th scope="row"><a class="z-animal-link" href="<%= url_for('/zodiac/' + br.key + '/') %>"><span class="cal-name"><%= br.animal %></span></a></th>
              <td><%= br.birthYears.join(' · ') %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="cal-top">
      <section class="cal-block">
        <div class="col-head">
          <h2 class="col-title">五行与传统方位、颜色</h2>
        </div>
        <div class="cal-table-wrap">
          <table class="cal-table z-elements">
            <thead>
              <tr>
                <th scope="col">五行</th>
                <th scope="col">天干</th>
                <th scope="col">方位</th>
                <th scope="col">传统色</th>
              </tr>
            </thead>
            <tbody>
              <% for (var ei = 0; ei < ov.elements.length; ei += 1) { var el = ov.elements[ei] %>
              <tr>
                <th scope="row"><span class="cal-name"><%= el.element %></span></th>
                <td><%= el.stems %></td>
                <td><%= el.direction %></td>
                <td><%= el.color %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <p class="z-note">五行与方位、颜色的对应是传统说法（《黄帝内经》一系），不是命理吉凶；生肖的五行由天干决定，每十年一轮。</p>
      </section>

      <section class="cal-block cal-year">
        <div class="col-head">
          <h2 class="col-title">三合与相冲</h2>
        </div>
        <div class="cal-table-wrap">
          <table class="cal-table z-sanhe">
            <thead>
              <tr>
                <th scope="col">组合</th>
                <th scope="col">传统解释</th>
              </tr>
            </thead>
            <tbody>
              <% for (var si2 = 0; si2 < ov.sanhe.length; si2 += 1) { var sh = ov.sanhe[si2] %>
              <tr>
                <th scope="row"><span class="cal-name"><%= sh.animals.join('') %></span></th>
                <td>三合，三者合成<%= sh.ju %>，互相增强</td>
              </tr>
              <% } %>
              <% for (var chi = 0; chi < ov.chong.length; chi += 1) { var ch = ov.chong[chi] %>
              <tr>
                <th scope="row"><span class="cal-name"><%= ch.join('') %></span></th>
                <td>六冲，正对相对，传统上是最强的对立</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="cal-notes">
      <article class="about-body cal-prose">
        <div class="markdown-body">
          <%- ov.prose %>
        </div>
      </article>

      <% if (ov.faq.length) { %>
      <aside class="cal-faq">
        <h2 class="col-title">关于生肖的常见问题</h2>
        <% for (var fi2 = 0; fi2 < ov.faq.length; fi2 += 1) { var item2 = ov.faq[fi2] %>
        <details class="cal-faq-item">
          <summary><%= item2.q %></summary>
          <p><%= item2.a %></p>
        </details>
        <% } %>
      </aside>
      <% } %>
    </div>

    <div class="cal-after">
      <p class="cal-note">生肖与干支依据公开历法资料整理，生肖年以农历正月初一为界（GB/T 33661-2017《农历的编算和颁行》）；各生肖年的起止日期与本站节假日页一致。性格与幸运物是民间流传的说法，只作参考。</p>
    </div>
  </div>
</div>

<% } %>
