<%
// ============================================================
// 首页（V2 构图·对齐原始效果图）
// 首屏：A 身份域（左） | B 内容墙（右，主卡 + 入口格网格）
// 下半部：C 精选内容 | D 最新文字 | E 近期动态；F 页脚收尾
// 原则：全部真实数据驱动；无数据不渲染空模块；计数=真实条目数；
//       类型无汇总页时入口格为非链接展示格，不制造失效链接
// ============================================================
page.hide_banner = true

/* 空壳文章判定：正文去掉空白与标点后没有任何文字，才算「空」。
   不用固定字数阈值——「我要环游世界。」只有 7 个字，但它是作者真写了的一句话，
   不该被挡在门外；而「11」这类标题即全文的空壳必须挡掉。 */
var PUNCT_RE = /[\s\u3000-\u303f\uff00-\uffef!-\/:-@\[-`{-~]/g

/* ---------- 文章数据 ---------- */
var postsArr = page.posts.sort('date', -1).toArray()

/* 主卡资格原先在这里按「正文 ≥40 字 + 有封面」判定（POST_FEATURE_MIN_CHARS）。
   2026-11-04 起主卡改由跨类型精选池决定，准入闸（文章 ≥800 字 + 有分类 + 非空壳）
   在 curation-pool.js 里，这里只保留「最新文字」列表用的空壳判定。 */

function bodyTextLength(post) {
  var raw = post.content || post._content || ''
  return String(strip_html(raw) || '').replace(PUNCT_RE, '')
}

/* 正文实际写了多少字（排除「正文只是把标题又敲了一遍」这种空壳）。
   后台新建文章时标题会自动填进正文，这类文章在页面上等于没内容。 */
function realBodyText(post) {
  var body = bodyTextLength(post)
  var title = String(post.title || '').replace(PUNCT_RE, '')
  if (title && body === title) { return '' }
  return body
}

/* 进「最新文字」列表的资格：写了东西就算，空壳除外 */
function postHasSubstance(post) {
  if (realBodyText(post).length >= 1) { return true }
  if (post.cover) { return true }
  if (post.featured) { return true }
  return false
}

/* 占首页主卡的资格：已移交精选池（curation-pool.js 的闸一） */

/* ---------- 精选池（PLAN-V3 §1） ----------
   主卡不再「谁新谁上」：改由跨类型池决定，池里装文章 / 项目 / 游戏 / 收藏 / 资料库专题。
   置顶（60 天租期）直通主卡；无有效置顶时按分数排，且挑战者必须高出 2 分才顶掉在位者。
   池的完整规则、台账与排队历史在 themes/fluid/scripts/helpers/curation-pool.js。 */
var pool = buildCurationPool(site, site.data)
var hero = pool.hero
var heroIsPost = !!(hero && hero.kind === 'post')
var heroExcerpt = ''
if (hero) {
  heroExcerpt = hero.summary || (hero._raw ? excerptText(hero._raw, 150) : '')
}
/* 「最新文字」栏在 2026-11-04 瘦身（PLAN-V3 §2.1）：5 条带摘要 → 3 条纯标题。
   个人主页需要「最近写了什么」，但不需要它跟左边的精选栏抢版面；
   摘要是精选栏该干的事，时间流只负责让人看见标题。 */
var LATEST_MAX = 3
var latestPosts = []
/* 2026-10-21 主人拍板：不再跳过主卡那一篇。「最新文字」从全站真正最新开始列，
   与首屏主卡重复出现同一标题是可接受结果——栏目标题承诺的就是全站最新，
   读者有权期待列表头条与主卡是同一篇；此前的去重过滤（跳过 featuredPost）
   会让列表「最新」一篇比主卡旧，标题与范围不一致。 */
for (var j = 0; j < postsArr.length; j++) {
  if (latestPosts.length >= LATEST_MAX) { break }
  latestPosts.push(postsArr[j])
}
/* 「最新文字」只列有内容的文章：空文不进列表（与主卡同一把尺子，避免「点进去只有 11」） */
latestPosts = latestPosts.filter(function (p) { return postHasSubstance(p) })
var totalPosts = site.posts.length

/* 摘要统一走 excerptText helper（VD-8）；主卡摘要见上方 heroExcerpt。
   「最新文字」2026-11-04 起不再显示摘要，所以这里不再包 postExcerpt 一层。 */

/* ---------- 类型注册表 ----------
   新增模块类型 = 在此加一行配置
   accent: 无 cover 时的色块格颜色（yellow / orange / 空则排版格）
   page  : 类型汇总页路径；站点尚未建该页时留空 → 入口格为非链接展示格 */
/* ---------- 内容模块入口格定义 ----------
   单一数据源为 source/_data/modules.yml（与后台 api 共用）。
   文件缺失或内容为空时回退内置默认，保证首页不空白。 */
var HOME_MODULES = []
var moduleCfg = []
if (site.data && site.data.modules && site.data.modules.items) { moduleCfg = site.data.modules.items }
moduleCfg.forEach(function (m) {
  if (m && m.key) {
    HOME_MODULES.push({ data: m.key, title: m.title || m.key, accent: m.accent || '', page: m.page || '' })
  }
})
if (!HOME_MODULES.length) {
  HOME_MODULES = [
    { data: 'projects',    title: '项目', accent: 'yellow', page: '/projects/' },
    { data: 'games',       title: '游戏', accent: 'orange', page: '/games/' },
    { data: 'collections', title: '收藏', accent: '',       page: '/collections/' }
  ]
}

/* 有效条目（title 必填）聚合为类型入口数据；count 为真实条目数 */
var wallModules = []
HOME_MODULES.forEach(function (m) {
  var d = site.data ? site.data[m.data] : null
  var items = []
  if (d && d.items) {
    d.items.forEach(function (it) { if (it && it.title) { items.push(it) } })
  }
  if (!items.length) { return }
  var cover = ''
  items.forEach(function (it) { if (!cover && it.cover) { cover = it.cover } })
  wallModules.push({ key: m.data, title: m.title, accent: m.accent, page: m.page, count: items.length, cover: cover, items: items })
})

/* ---------- 跨类型动态聚合（文章 + 各类型带 date 的条目） ---------- */
var feed = []
var feedSeen = {}
site.posts.each(function (p) {
  var key = '文章|' + p.path
  if (feedSeen[key]) { return }
  feedSeen[key] = 1
  feed.push({ type: '文章', title: p.title, link: url_for(p.path), date: p.date.valueOf() })
})
wallModules.forEach(function (m) {
  m.items.forEach(function (it) {
    if (!it.date) { return }
    var key = m.title + '|' + it.title
    if (feedSeen[key]) { return }
    feedSeen[key] = 1
    /* 模块条目优先链到站内详情页（UX-4）：与精选栏同一套 slug 拼接；
       it.link 仅作无详情页时的外链兜底 */
    var feedDetail = m.page ? '/' + m.key + '/' + (it.slug || encodeURIComponent(String(it.title))) + '/' : ''
    feed.push({ type: m.title, title: it.title, link: feedDetail || it.link || '', date: new Date(it.date).valueOf() })
  })
})
feed.sort(function (a, b) { return b.date - a.date })

var FEED_MAX = 6
var feedTypes = {}
feed.forEach(function (f) { feedTypes[f.type] = 1 })
var feedTypeCount = Object.keys(feedTypes).length
/* 仅 1 种有效类型时与最新文章重复 → 动态区不渲染，聚合能力保留 */
var feedRows = feedTypeCount > 1 ? feed.slice(0, FEED_MAX) : []

/* ---------- 身份域 / 页脚配置（site.data.site 优先，回退主题配置；不编造文案） ---------- */
var siteCfg = (site.data && site.data.site) || {}
/* A9 身份词铭牌已于 2026-10-21 被主人整块撤回（「01 Developer / 02 Writer 哪好看」，
   见 ERRORS.md E-040 后续记录与 DESIGN-LANGUAGE §10 拍板状态）。
   site.yml 的 identity_words 数据保留不删，但本模板不再渲染该块；
   恢复展示需重新加回模板块与 .identity-words 样式，并先走 §10 拍板流程。 */
var motto = siteCfg.motto || (theme.about && theme.about.motto) || ''
var identityIntro = siteCfg.intro || (theme.about && theme.about.intro) || ''
var identityAvatar = siteCfg.avatar || (theme.about && theme.about.avatar) || ''

var earliestTs = Infinity
site.posts.each(function (p) {
  var t = p.date.valueOf()
  if (t < earliestTs) { earliestTs = t }
})
var sinceYear = isFinite(earliestTs) ? new Date(earliestTs).getFullYear() : ''

var postUrlTarget = theme.index.post_url_target || '_self'

/* 精选栏原先绑死 projects 模块平铺全部条目（那不是评选，是把项目清单原样铺开）。
   现在改用池内第 2 位起的 5 条，跨类型混排，规则见 curation-pool.js。 */
var featuredPicks = pool.picks || []

/* 资料库专题数：入口格上的数字从数据文件现取，不写死。
   topics 缺失时显示 0，入口格仍可点（/library/ 自身有空态兜底）。 */
var libraryTopicCount = (site.data && site.data.library && Array.isArray(site.data.library.topics))
  ? site.data.library.topics.length
  : 0
%>

<div class="home" id="top">

  <!-- 首屏：身份域 + 内容墙 -->
  <section class="home-hero home-wrap">
    <div class="identity">
      <div class="identity-avatar">
        <% if (identityAvatar) { %>
          <img class="identity-avatar-img" src="<%= url_for(identityAvatar) %>" alt="<%= config.title %> 头像">
        <% } else { %>
          <span class="identity-avatar-fallback"><%= (config.title || 'K').substring(0, 1) %></span>
        <% } %>
      </div>
      <h1 class="identity-name"><%= config.title %></h1>
      <% if (identityIntro) { %>
      <p class="identity-tagline"><%= identityIntro %></p>
      <% } %>
      <div class="identity-cta">
        <a class="cta-solid" href="<%= url_for('/archives/') %>">进入文字 →</a>
        <a class="cta-link" href="<%= url_for('/about/') %>">关于我 →</a>
      </div>
    </div>

    <%
    /* 墙格收口（RL-1）。主卡 .wall-feature 占 col1 两行 → 前两行留给入口格的空位是
       2 列 × 2 行 = 4 个。入口格 ≤4 时正好铺满、不产生第三行；超过 4 个时由末格
       （分类格）跨剩余列兜住。
       2026-10-19：标签格按方案 A 撤出（标签不占首页入口格，只活在详情页），
       入口格数从「模块 + 分类 + 标签」改为「模块 + 分类」。 */
    var wallCellCount = wallModules.length + 1
    var wallOverflow = wallCellCount > 4
    %>
    <div class="wall">
      <% if (hero) { %>
      <article class="wall-feature<%= hero.cover ? ' has-cover' : '' %>">
        <% if (hero.cover) { %>
        <img class="wall-feature-img" src="<%= url_for(hero.cover) %>" alt="<%= hero.title %>">
        <div class="wall-feature-mask"></div>
        <% } %>
        <div class="wall-feature-body">
          <% /* 三档标注，都不是谎话：PINNED=主人指定；FEATURED=池内评选第一；
                LATEST=全站没有够格参评的内容时退回最新一篇 */ %>
          <p class="wall-feature-meta"><%= hero.fallback ? 'LATEST' : (hero.pin && hero.pin.active ? 'PINNED' : 'FEATURED') %> · <%= hero.kindLabel %><% if (hero.date) { %> · <%= fmtItemDate(hero.date) %><% } %></p>
          <h2 class="wall-feature-title"><a href="<%= url_for(hero.url) %>" target="<%= postUrlTarget %>"><%= hero.title %></a></h2>
          <% if (heroExcerpt) { %><p class="wall-feature-desc"><%= heroExcerpt %></p><% } %>
          <a class="wall-feature-more" href="<%= url_for(hero.url) %>" target="<%= postUrlTarget %>">查看详情 →</a>
        </div>
      </article>
      <% } %>

      <% wallModules.forEach(function (m) { %>
      <<%= m.page ? 'a' : 'div' %> class="wall-cell cell-<%= m.accent || 'plain' %>"<% if (m.page) { %> href="<%= url_for(m.page) %>"<% } %>>
        <% var latestTitle = (m.items && m.items.length) ? m.items[0].title : '' %>
        <% if (m.cover) { %>
        <img class="wall-cell-img" src="<%= url_for(m.cover) %>" alt="<%= m.title %>">
        <div class="wall-cell-mask"></div>
        <div class="wall-cell-body">
          <% if (latestTitle) { %>
          <span class="wall-cell-tag">最新 · <%= latestTitle %></span>
          <% } else { %>
          <span class="wall-cell-tag"># <%= m.title %></span>
          <% } %>
          <span class="wall-cell-name"><%= m.title %> / <%= m.count %> →</span>
        </div>
        <% } else { %>
        <div class="wall-cell-body">
          <span class="wall-cell-title"><%= m.title %><span class="wall-cell-count"> · <%= m.count %></span></span>
          <% if (latestTitle) { %><span class="wall-cell-item">最新 · <%= latestTitle %></span><% } %>
        </div>
        <% } %>
      </<%= m.page ? 'a' : 'div' %>>
      <% }) %>

      <% /* 入口格「分类」→「资料库」（2026-11-04，PLAN-V3 §2.1）。
          分类是博客的编目概念，读者进个人主页想看的是「你整理了什么」，
          不是「你按什么主题给文章编了目」。分类页与标签页都还在、URL 不变，
          只是不再占首页入口——从文章详情页的元信息仍然能进去。 */ %>
      <a class="wall-cell cell-plain<%= wallOverflow ? ' wall-cell-wide' : '' %>" href="<%= url_for('/library/') %>">
        <div class="wall-cell-body">
          <span class="wall-cell-title">资料库<span class="wall-cell-count"> · <%= libraryTopicCount %></span></span>
          <span class="wall-cell-item">按专题浏览</span>
        </div>
      </a>
      <% /* 标签格已撤（2026-10-19，方案 A：标签降级为详情页检索）。/tags/ 页面与所有
          标签 URL 保留可访问，只是不再占首页入口格；文章详情页的标签行是它该在的地方。 */ %>
    </div>
  </section>

  <%
  /* 下半部两栏：C 精选内容（projects 有条目才渲染）+ D 最新文字。
     E 最近更新按方向 A 提为墨底整屏区块（R-1 豁免：每屏最多一个反色区块），见文件末尾。 */
  var activeCols = []
  if (featuredPicks.length) { activeCols.push('c') }
  activeCols.push('d')
  %>
  <div class="home-wrap home-cols cols-<%= activeCols.length %>">

    <% if (featuredPicks.length) { %>
    <section class="home-col">
      <div class="col-head">
        <h2 class="col-title">精选内容 <span class="col-count">/<%= featuredPicks.length %></span></h2>
      </div>
      <div class="pick-list">
        <% featuredPicks.forEach(function (it, idx) { %>
        <a class="pick-row<%= idx === 0 ? ' is-lead' : '' %>" href="<%= url_for(it.url) %>">
          <% if (it.cover) { %><img class="pick-img" src="<%= url_for(it.cover) %>" alt="<%= it.title %>"><% } %>
          <div class="pick-main">
            <span class="pick-title"><%= it.title %><span class="pick-kind"><%= it.kindLabel %></span></span>
            <% if (it.summary) { %><span class="pick-desc"><%= it.summary %></span><% } %>
          </div>
        </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="home-col">
      <div class="col-head">
        <h2 class="col-title">最新文字 <span class="col-count">/<%= latestPosts.length %></span></h2>
        <a class="col-more" href="<%= url_for('/archives/') %>">查看全部文字 →</a>
      </div>
      <ol class="post-list">
        <% latestPosts.forEach(function (post) { %>
        <li class="post-row">
          <div class="post-main">
            <time class="post-time" datetime="<%= full_date(post.date, 'YYYY-MM-DD HH:mm') %>" pubdate><%= date(post.date, config.date_format) %></time>
            <a class="post-title" href="<%= url_for(post.path) %>" target="<%= postUrlTarget %>"><%= post.title %></a>
            <% /* 摘要已撤（PLAN-V3 §2.1）：时间流只负责让人看见标题，摘要是精选栏的活 */ %>
          </div>
          <% var cat = post.categories.length ? post.categories[0] : null %>
          <% if (cat) { %><a class="post-cat" href="<%= url_for(cat.path) %>"><%= cat.name %></a><% } %>
        </li>
        <% }) %>
      </ol>
    </section>

  </div>

  <% if (feedRows.length) { %>
  <% /* 墨底整屏区块（方向 A，2026-10-19 落地）：R-1 豁免允许每屏一个反相墨底区块。
         区块内一切文字只用纸色及其透明度衍生（13.5:1 / 7.69:1，均过 AA），
         不引入第二彩色、不放装饰色块；全站同时只允许存在这一个墨底区块。
         ⚠️ 必须与上面的 .home-cols **平级**：放进两栏容器里它会变成网格的第三个
         格子、只占第一列宽，墨底就通不了铺（2026-10-19 实测踩到）。
         计数用 feedRows.length（FEED_MAX 截断后的实际渲染数），不用 feed.length。
         样式见 site.css §4.11。 */ %>
  <section class="ink-band">
    <div class="home-wrap">
      <div class="col-head">
        <h2 class="col-title">最近更新 <span class="col-count">/<%= feedRows.length %></span></h2>
      </div>
      <div class="feed-grid">
        <% feedRows.forEach(function (f) { %>
        <div class="feed-row">
          <span class="feed-type"># <%= f.type %></span>
          <% if (f.link) { %>
          <a class="feed-title" href="<%= f.link %>" target="<%= f.link.indexOf('http') === 0 ? '_blank' : '_self' %>" rel="noopener"><%= f.title %></a>
          <% } else { %>
          <span class="feed-title"><%= f.title %></span>
          <% } %>
          <time class="feed-date" datetime="<%= fmtItemDate(f.date) %>"><%= fmtItemDate(f.date) %></time>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- 页脚收尾 -->
  <footer class="home-end">
    <p class="end-line"><% if (motto) { %>—— <%= motto %><% } else if (sinceYear) { %>SINCE <%= sinceYear %> · <%= config.title %><% } %></p>
    <a class="end-top" href="#top">TOP ↑</a>
  </footer>

</div>
