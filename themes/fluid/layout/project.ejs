<%
// 项目详情页（纸面档案）：封面 + 元信息 + 四个长文 section。
// 铁律：只渲染有内容的 section，无内容不占位、不伪造。
page.layout = 'project'
page.hide_banner = true
var it = page.item || {}
/* 正文自带 h2 时不渲染壳标题：否则壳标题与正文第一个 ## 之间零内容、只隔 22px，
   读起来像两个标题打堆（2026-10-19 实测，Ties 四处：项目背景→它解决什么、
   实现过程→工程过程、技术方案→技术栈、成果→目前的状态，四个长文都以 ## 开头）。
   壳标题的职责是给没有小标题的长文一个概要，正文已有小标题时它是冗余层级。 */
var startsWithH2 = (html) => html && /^\s*<h2[\s>]/.test(String(html))
var sections = [
  ['项目背景', it.background_html],
  ['实现过程', it.process_html],
  ['技术方案', it.tech_html],
  ['成果', it.outcome_html],
].filter(function (s) { return s[1] && String(s[1]).trim() })
%>

<div class="paper-page">
  <div class="home-wrap module-detail">
    <header class="about-head">
      <div class="about-head-main">
        <p class="page-head-kicker"><a href="<%= url_for('/projects/') %>">PROJECTS · 项目</a></p>
        <h1 class="page-head-title"><%= it.title %></h1>
        <% if (it.summary) { %><p class="about-head-intro"><%= it.summary %></p><% } %>
        <p class="detail-meta">
          <% if (it.date) { %><time class="mono" datetime="<%= fmtItemDate(it.date, 'YYYY-MM-DD') %>"><%= fmtItemDate(it.date) %></time><% } %>
          <% if (it.status) { %><span class="detail-tag detail-tag-solid"><%= it.status %></span><% } %>
          <% (it.tags || []).forEach(function (t) { %><span class="detail-tag">#<%= t %></span><% }) %>
        </p>
        <% if (it.link) { %><a class="cta-solid" href="<%= it.link %>" target="_blank" rel="noopener">访问项目 →</a><% } %>
      </div>
      <% if (it.cover) { %>
      <div class="about-avatar-box detail-cover">
        <img src="<%= url_for(it.cover) %>" alt="<%= it.title %>">
      </div>
      <% } %>
    </header>

    <article class="about-body">
      <div class="markdown-body">
      <% sections.forEach(function (s) { %>
      <section class="rich-section">
        <% if (!startsWithH2(s[1])) { %><h2><%= s[0] %></h2><% } %>
        <%- s[1] %>
      </section>
      <% }) %>
      <% if (!sections.length) { %><p class="empty">详细介绍整理中。</p><% } %>
      </div>
    </article>

    <footer class="detail-foot">
      <% if (page.prevItem || page.nextItem) { %>
      <nav class="detail-prevnext" aria-label="项目之间的前后导航">
        <% if (page.prevItem) { %>
        <a class="detail-prev" href="<%= url_for(page.prevItem.path) %>">← <%= page.prevItem.title %></a>
        <% } %>
        <% if (page.nextItem) { %>
        <a class="detail-next" href="<%= url_for(page.nextItem.path) %>"><%= page.nextItem.title %> →</a>
        <% } %>
      </nav>
      <% } %>
      <a class="cta-link" href="<%= url_for('/projects/') %>">← 返回项目列表</a>
    </footer>
  </div>
</div>
