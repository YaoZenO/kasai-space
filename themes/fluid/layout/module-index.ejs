<%
// 模块列表页（项目 / 游戏 / 收藏）：条目卡片网格，全部来自 source/_data/<module>.yml。
// 铁律：无数据不渲染（generator 已保证有数据才会生成本页）。
// collections 为纯外链模块：卡片直接跳 it.link；无 link 的条目渲染为非链接卡（不制造失效链接）。
page.layout = 'module-index'
page.hide_banner = true
var mod = page.moduleKey || 'projects'
var items = page.items || []
var isCollections = mod === 'collections'
%>

<div class="paper-page">
  <div class="home-wrap module-index">
    <header class="page-head-plain">
      <p class="page-head-kicker"><%= isCollections ? 'COLLECTIONS' : (mod === 'games' ? 'GAMES' : 'PROJECTS') %> · <%= page.moduleTitle %></p>
      <h1 class="page-head-title">全部<%= page.moduleTitle %></h1>
      <p class="list-count">共 <%= items.length %> 个</p>
    </header>

    <% if (mod === 'games') { %>
    <% /* 游戏模块用「封面网格」（主人 2026-10-19 定）：非均质图墙，1 大 + 2 中 + 2 小 + 1 横幅，
           摘要 hover 时展开，样式见 site.css §4.10。项目 / 收藏仍是行式卡片网格，不受影响。
           cover 缺失的条目降级为纸底格（铁律：无数据不渲染，也不制造空图位）。 */ %>
    <div class="games-wall">
      <% items.forEach(function (it) { %>
      <a class="games-tile<%= it.cover ? '' : ' no-cover' %>" href="<%= url_for('/' + mod + '/' + (it.slug || encodeURIComponent(String(it.title))) + '/') %>">
        <% if (it.cover) { %><img class="games-tile-img" src="<%= url_for(it.cover) %>" alt="<%= it.title %>" loading="lazy"><% } %>
        <span class="games-tile-cap">
          <span class="games-tile-title"><%= it.title %></span>
          <% var gsum = it.summary || it.desc %>
          <% if (gsum) { %><span class="games-tile-sum"><%= gsum %></span><% } %>
          <% if (it.genre || it.status) { %><span class="games-tile-meta"><%= [it.genre, it.status].filter(Boolean).join(' · ') %></span><% } %>
        </span>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="module-grid">
      <% items.forEach(function (it) { %>
      <% var collHref = isCollections ? (it.link || '') : '' %>
      <% var Card = (isCollections && collHref) ? 'a' : (isCollections ? 'div' : 'a') %>
      <<%= Card %> class="module-card<%= it.cover ? ' has-cover' : '' %>"
        <% if (!isCollections) { %>href="<%= url_for('/' + mod + '/' + (it.slug || encodeURIComponent(String(it.title))) + '/') %>"<% } else if (collHref) { %>href="<%= collHref %>" target="_blank" rel="noopener"<% } %>>
        <% if (it.cover) { %>
        <span class="module-card-img"><img src="<%= url_for(it.cover) %>" alt="<%= it.title %>" loading="lazy"></span>
        <% } %>
        <span class="module-card-body">
          <span class="module-card-title"><%= it.title %></span>
          <% var sum = it.summary || it.desc %>
          <% if (sum) { %><span class="module-card-sum"><%= sum %></span><% } %>
          <span class="module-card-meta">
            <% if (it.date) { %><time class="mono" datetime="<%= fmtItemDate(it.date, 'YYYY-MM-DD') %>"><%= fmtItemDate(it.date) %></time><% } %>
            <% if (mod === 'games' && it.genre) { %><span class="detail-tag detail-tag-solid"><%= it.genre %></span><% } %>
            <% if (mod === 'games' && it.status) { %><span class="detail-tag"><%= it.status %></span><% } %>
            <% if (isCollections && collHref) { %><span class="detail-tag">外链</span><% } %>
          </span>
        </span>
      </<%= Card %>>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>
