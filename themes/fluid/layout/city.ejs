<%
// 城市档案页（/city/<slug>/）：数值档案 + 全国分位 + 上榜记录。
// 数据：source/_data/cities.yml；计算：helpers/cityrank-data.js
// 样式：site.css §4.16（.cr-* 规则）；视觉作用域复用 .cal-page
// 约定：字段缺值显示 [待补]，严禁填估算值（CITY-RANK-CONTENT §4 / §7 C-1）。
// 分位（2026-11-01 方向一）：每个已采字段在该字段候选池内「从高到低第几位」——
// 是排序位置的事实陈述，不含优劣评价，与 computed 榜的综合指数是两回事。
page.layout = 'city'
page.hide_banner = true

var CR = buildCityRanks(site.data)
var c = CR.error ? null : findCity(CR, page.citySlug)
var mentions = c ? cityMentions(CR, c.slug) : []
var standings = c ? cityMetricStandings(CR, c) : {}

var FIELD_LABEL = {
  gdp: '地区生产总值', gdp_growth: 'GDP 增速', gdp_per_capita: '人均 GDP',
  fiscal_rev: '一般公共预算收入', wage_avg: '在岗职工平均工资',
  income_disp: '人均可支配收入', consume_exp: '人均消费支出', trade_total: '进出口总额',
  retail_sales: '社会消费品零售总额', deposits: '住户存款余额',
  pop: '常住人口', pop_urban_rate: '城镇化率', pop_net_inflow: '人口净流入',
  area_km2: '行政面积', pop_density: '人口密度', builtup_km2: '建成区面积',
  temp_jan: '1 月均温', temp_jul: '7 月均温', temp_year: '年均温',
  precip: '年降水量', rain_days: '年降水日数', sun_hours: '年日照时数',
  thunder_days: '雷暴日数', latitude: '纬度',
  pm25: 'PM2.5 年均', air_good_ratio: '空气优良率', air_good_days: '空气优良天数',
  green_rate: '建成区绿化覆盖率', forest_rate: '森林覆盖率', water_per_capita: '人均水资源',
  hosp_3a: '三甲医院', beds_per_k: '千人床位', doctors_per_k: '千人医师',
  hospitals: '医院数', doctors: '执业（助理）医师数',
  universities: '本科高校', double_first_class: '双一流高校', patents: '专利授权',
  scenic_5a: '5A 景区', scenic_4a: '4A 景区', heritage: '世界遗产',
  visitors: '年接待游客', museums: '博物馆',
  metro_km: '地铁运营里程', metro_lines: '地铁线路', metro_open_year: '地铁开通年份',
  metro_first_year: '地铁首线开通年份',
  airport_pax: '机场旅客吞吐', rail_hubs: '高铁枢纽', port_cargo: '港口吞吐',
  express_handle: '快递处理量',
  house_price: '二手住宅均价', rent: '住宅租金'
}

var srcMap = {}
for (var si = 0; si < CR.citySources.length; si += 1) { srcMap[CR.citySources[si].key] = CR.citySources[si] }
%>

<div class="paper-page cal-page cr-page cr-citypage">
  <div class="home-wrap">
    <% if (!c) { %>
    <header class="page-head">
      <h1 class="page-head-title">城市档案</h1>
    </header>
    <p class="post-desc">这座城市的档案还在整理中，暂时无法展示，欢迎稍后再来看看。</p>
    <!-- dev: slug=<%= page.citySlug || '未知城市' %>; <%= CR.error || '数据里找不到该城市' %> -->
    <% } else { %>

    <%
    // 档案导语与要点（2026-11-02）：头图改为完整呈现后，左侧只留标题会空出半屏，
    // 图就成了孤零零的贴片。这里补上与图版对等的文字量——全部由已核验字段现算，
    // 只陈述「有多少字段、位次第几」这类事实，不做综合评价（CITY-RANK-CONTENT §7）。
    var measured = [];
    var mk = Object.keys(c.metrics || {});
    for (var mi = 0; mi < mk.length; mi += 1) {
      var mv0 = c.metrics[mk[mi]];
      if (mv0 && typeof mv0.v === 'number') measured.push(mk[mi]);
    }
    var poolCnt = 0;
    for (var pi = 0; pi < measured.length; pi += 1) {
      if (standings[measured[pi]]) poolCnt += 1;
    }

    // 要点取「规模与公共资源」类字段，顺序固定，不随数据多少抖动
    var GLANCE_ORDER = ['gdp', 'pop', 'area_km2', 'metro_km', 'universities', 'scenic_5a', 'trade_total', 'sun_hours'];
    var glance = [];
    for (var gi = 0; gi < GLANCE_ORDER.length && glance.length < 4; gi += 1) {
      var gk = GLANCE_ORDER[gi];
      var gv = c.metrics[gk];
      if (gv && typeof gv.v === 'number') {
        glance.push({ label: FIELD_LABEL[gk] || gk, v: gv.v, unit: gv.unit || '', st: standings[gk] || null });
      }
    }
    var gdpM = c.metrics.gdp;
    var gdpSt = standings.gdp;
    %>
    <header class="page-head">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href="<%= url_for('/library/') %>">资料库</a><span aria-hidden="true">/</span><a href="<%= url_for('/cityrank/') %>">城市排行榜</a><span aria-hidden="true">/</span><span class="cal-crumb-now"><%= c.name %></span>
      </nav>
      <div class="cr-head-row">
        <div class="cr-head-text">
          <h1 class="page-head-title"><%= c.name %></h1>
          <p class="archive-total"><% if (c.province) { %><%= c.province %><% } %><% if (c.province && c.level) { %> · <% } %><% if (c.level) { %><%= c.level %><% } %><% if (!c.province && !c.level) { %>行政归属待补<% } %> · 数据年份 <%= CR.cityMeta.dataYear || '2025' %></p>

          <p class="cr-lede">本站为<%= c.name %>建档 <%= measured.length %> 项已核验的统计字段<% if (poolCnt === measured.length && measured.length) { %>，全部可放进全国候选池比较位次<% } else if (poolCnt) { %>，其中 <%= poolCnt %> 项可放进全国候选池比较位次<% } %><% if (gdpM && typeof gdpM.v === 'number') { %>；地区生产总值 <%= gdpM.v %> <%= gdpM.unit || '' %><% if (gdpSt) { %>，在 <%= gdpSt.total %> 座城市中列第 <%= gdpSt.rank %> 位<% } %><% } %>。</p>

          <% if (glance.length) { %>
          <dl class="cr-glance">
            <% for (var gj = 0; gj < glance.length; gj += 1) { var g = glance[gj]; %>
            <div class="cr-glance-item">
              <dt><%= g.label %></dt>
              <dd><%= g.v %><% if (g.unit) { %><span class="cr-glance-sub"><%= g.unit %></span><% } %><% if (g.st) { %><span class="cr-glance-sub">第 <%= g.st.rank %> / <%= g.st.total %></span><% } %></dd>
            </div>
            <% } %>
          </dl>
          <% } %>
        </div>
        <% if (page.cityPhoto) { %>
        <figure class="cr-hero-fig">
          <%# 图按原比例完整呈现（不裁切）：width/height 用图片真实像素，只作宽高比参考，
              CSS 用 width:100% + height:auto 自适应列宽 %>
          <img src="<%= page.cityPhoto.src %>" alt="<%= c.name %>城市景观照片"<% if (page.cityPhoto.width) { %> width="<%= page.cityPhoto.width %>" height="<%= page.cityPhoto.height %>"<% } %> loading="lazy">
          <figcaption><%= page.cityPhoto.credit %></figcaption>
        </figure>
        <% } %>
      </div>
    </header>

    <% if (page.cityMap) { %>
    <%# 位置图（2026-11-02）：一省一份静态 SVG，本省填 accent。
        底图只做投影与抽稀、不改边界；数据来源见 tools/build-china-map-data.js %>
    <figure class="cr-map">
      <img src="<%= page.cityMap.src %>" alt="<%= page.cityMap.province %>在中国的方位" width="420" height="396" loading="lazy">
      <figcaption>深色为 <%= page.cityMap.province %>。底图为公开省级边界数据的投影简版，边界未作改动。</figcaption>
    </figure>
    <% } %>

    <section class="cr-profile">
      <h2 class="cr-sec-title">城市档案</h2>
      <% var keys = Object.keys(c.metrics || {}); %>
      <% if (!keys.length) { %>
      <p class="cr-empty">这座城市的统计字段还没有采集到权威来源，暂不列出——不填估算值。</p>
      <% } else { %>
      <dl class="cr-profile-list">
        <% for (var ki = 0; ki < keys.length; ki += 1) { var fk = keys[ki]; var mv = c.metrics[fk];
          // 来源注记不再逐条平铺（2026-11-01 可读性改版）：收进行级 title 悬停 + 页尾来源清单，
          // 位次（页面最有信息量的字段）升为徽标。口径词「城参比」「从高到低第」被
          // test/cityrank-e2e.js S17 产物断言锁定，改措辞必须连断言一起改。
          var hasV = mv && typeof mv.v === 'number';
          var mvTitle = hasV ? ((mv.asOf || '') + (srcMap[mv.source] ? ' · ' + srcMap[mv.source].name : '')) : ''; %>
        <div class="cr-profile-item"<% if (mvTitle) { %> title="<%= mvTitle %>"<% } %>>
          <dt><%= FIELD_LABEL[fk] || fk %></dt>
          <dd>
            <% if (hasV) { %>
            <span class="cr-pval"><%= mv.v %></span><% if (mv.unit) { %><span class="cr-punit"><%= mv.unit %></span><% } %>
            <% var st = standings[fk]; if (st) { %>
            <span class="cr-standing-badge"><%= st.total %> 城参比 · 第 <%= st.rank %> 位</span>
            <% } %>
            <% } else { %>
            <span class="cr-pending">[待补]</span>
            <% } %>
          </dd>
        </div>
        <% } %>
      </dl>
      <% } %>
    </section>

    <% if (mentions.length) { %>
    <section class="cr-mentions">
      <h2 class="cr-sec-title">上榜记录</h2>
      <% for (var mi = 0; mi < mentions.length; mi += 1) { var mg = mentions[mi]
        var best = mg.hits[0].rank
        for (var bi = 1; bi < mg.hits.length; bi += 1) { if (mg.hits[bi].rank < best) best = mg.hits[bi].rank }
      %>
      <div class="cr-mention-group">
        <p class="cr-mention-group-title"><%= mg.group %><span class="cr-mention-sum">上榜 <%= mg.hits.length %> 项 · 最好成绩第 <%= best %> 名</span></p>
        <ul class="cr-mention-list">
          <% for (var hi = 0; hi < mg.hits.length; hi += 1) { var ht = mg.hits[hi] %>
          <li>
            <a href="<%= url_for('/cityrank/' + ht.slug + '/') %>"><%= ht.title %></a>
            <span class="cr-mention-rank">第 <%= ht.rank %> 名<% if (ht.kind === 'computed' && typeof ht.score === 'number') { %> · 指数 <%= ht.score %><% } %></span>
          </li>
          <% } %>
        </ul>
      </div>
      <% } %>
    </section>
    <% } %>

    <%
    // 本页来源清单（2026-11-01 可读性改版）：原逐条 cr-pmeta 的来源收拢到这里，
    // 与 cr-profile-note、cal-note 三处说明合并为页尾一处。
    var usedSources = [];
    for (var ui = 0; ui < keys.length; ui += 1) {
      var umv = c.metrics[keys[ui]];
      if (umv && typeof umv.v === 'number' && srcMap[umv.source] && usedSources.indexOf(srcMap[umv.source].name) === -1) {
        usedSources.push(srcMap[umv.source].name);
      }
    }
    %>
    <div class="cal-after">
      <p class="cal-note">以上只列已核验过的字段，缺值一律标 [待补]、不填估算值；位次是同字段候选池内从高到低第几位的排序位置（同值按拼音定序），不含优劣评价。数据来自各地统计公报与行业主管部门公开名录，批量数据站只作交叉核对、不作唯一来源，单条数据的年份与来源可悬停字段行查看。<% if (usedSources.length) { %>本页来源：<%= usedSources.join('、') %>。<% } %></p>
    </div>

    <% } %>
  </div>
</div>
