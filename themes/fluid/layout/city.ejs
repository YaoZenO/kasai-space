<%
// 城市档案页（/city/<slug>/）：数值档案 + 全国分位 + 上榜记录。
// 数据：source/_data/cities.yml；计算：helpers/cityrank-data.js
// 样式：site.css §4.16（.cr-* 规则）；视觉作用域复用 .cal-page
// 约定：字段缺值显示 [待补]，严禁填估算值（CITY-RANK-CONTENT §4 / §7 C-1）。
// 分位（2026-11-01 方向一）：每个已采字段在该字段候选池内「从高到低第几位」——
// 是排序位置的事实陈述，不含优劣评价，与 computed 榜的综合指数是两回事。
page.layout = 'city'
page.hide_banner = true

var CR = buildCityRanks(site.data)
var c = CR.error ? null : findCity(CR, page.citySlug)
var mentions = c ? cityMentions(CR, c.slug) : []
var standings = c ? cityMetricStandings(CR, c) : {}

// 字段中文名、分组与组内顺序由 helpers/city-fields.js 单一维护——模板里不再各留一份
//（E-052 同型：两处各写一份必然漂移）。
// 数值加千分位：1152822.4 读不出来，1,152,822.4 才读得出来。
var CF = cityFields()
function fmtNum(v) {
  if (typeof v !== 'number' || !isFinite(v)) return String(v)
  var neg = v < 0
  var s = String(Math.abs(v))
  var dot = s.indexOf('.')
  var ip = dot === -1 ? s : s.slice(0, dot)
  var fp = dot === -1 ? '' : s.slice(dot)
  var out = ''
  for (var i = 0; i < ip.length; i += 1) {
    if (i && (ip.length - i) % 3 === 0) out += ','
    out += ip[i]
  }
  return (neg ? '-' : '') + out + fp
}

var srcMap = {}
for (var si = 0; si < CR.citySources.length; si += 1) { srcMap[CR.citySources[si].key] = CR.citySources[si] }
%>

<div class="paper-page cal-page cr-page cr-citypage">
  <div class="home-wrap">
    <% if (!c) { %>
    <header class="page-head">
      <h1 class="page-head-title">城市档案</h1>
    </header>
    <p class="post-desc">这座城市的档案还在整理中，暂时无法展示，欢迎稍后再来看看。</p>
    <!-- dev: slug=<%= page.citySlug || '未知城市' %>; <%= CR.error || '数据里找不到该城市' %> -->
    <% } else { %>

    <%
    // 档案导语与要点（2026-11-02）：头图改为完整呈现后，左侧只留标题会空出半屏，
    // 图就成了孤零零的贴片。这里补上与图版对等的文字量——全部由已核验字段现算，
    // 只陈述「有多少字段、位次第几」这类事实，不做综合评价（CITY-RANK-CONTENT §7）。
    var measured = [];
    var mk = Object.keys(c.metrics || {});
    for (var mi = 0; mi < mk.length; mi += 1) {
      var mv0 = c.metrics[mk[mi]];
      if (mv0 && typeof mv0.v === 'number') measured.push(mk[mi]);
    }
    var poolCnt = 0;
    for (var pi = 0; pi < measured.length; pi += 1) {
      if (standings[measured[pi]]) poolCnt += 1;
    }

    // 要点取「规模与公共资源」类字段，顺序固定，不随数据多少抖动
    var GLANCE_ORDER = ['gdp', 'pop', 'area_km2', 'metro_km', 'universities', 'scenic_5a', 'trade_total', 'sun_hours'];
    var glance = [];
    for (var gi = 0; gi < GLANCE_ORDER.length && glance.length < 4; gi += 1) {
      var gk = GLANCE_ORDER[gi];
      var gv = c.metrics[gk];
      if (gv && typeof gv.v === 'number') {
        glance.push({ key: gk, label: CF.label(gk), v: gv.v, unit: gv.unit || '', st: standings[gk] || null });
      }
    }
    var gdpM = c.metrics.gdp;
    var gdpSt = standings.gdp;

    // 档案表与页头要点互补，不重叠：要点负责「一眼看全」，档案负责其余明细。
    // 431 座城市里中位字段数只有 2，要点（最多 4 项）常常已经把它们全收走了——
    // 这种城市让档案表全量呈现、页头不再出要点表，同一个数字就不会在上下两处各出现一次。
    var keys = Object.keys(c.metrics || {});
    var glanceKeys = [];
    for (var gq = 0; gq < glance.length; gq += 1) glanceKeys.push(glance[gq].key);
    var specGroups = CF.groups(c.metrics, glanceKeys);
    if (!specGroups.length && keys.length) {
      specGroups = CF.groups(c.metrics, []);
      glance = [];
    }

    var mentionsAll = 0;
    for (var mn = 0; mn < mentions.length; mn += 1) mentionsAll += mentions[mn].hits.length;
    %>
    <header class="page-head">
      <nav class="cal-crumb" aria-label="面包屑">
        <a href="<%= url_for('/library/') %>">资料库</a><span aria-hidden="true">/</span><a href="<%= url_for('/city/') %>">城市档案</a><span aria-hidden="true">/</span><span class="cal-crumb-now"><%= c.name %></span>
      </nav>
      <div class="cr-head-row">
        <div class="cr-head-text">
          <h1 class="page-head-title"><%= c.name %></h1>
          <p class="archive-total"><% if (c.province) { %><%= c.province %><% } %><% if (c.province && c.level) { %> · <% } %><% if (c.level) { %><%= c.level %><% } %><% if (!c.province && !c.level) { %>行政归属待补<% } %> · 数据年份 <%= CR.cityMeta.dataYear || '2025' %></p>

          <p class="cr-lede">本站为<%= c.name %>建档 <%= measured.length %> 项已核验的统计字段<% if (poolCnt === measured.length && measured.length) { %>，全部可放进全国候选池比较位次<% } else if (poolCnt) { %>，其中 <%= poolCnt %> 项可放进全国候选池比较位次<% } %><% if (gdpM && typeof gdpM.v === 'number') { %>；地区生产总值 <%= fmtNum(gdpM.v) %> <%= gdpM.unit || '' %><% if (gdpSt) { %>，在 <%= gdpSt.total %> 座城市中列第 <%= gdpSt.rank %> 位<% } %><% } %>。</p>

          <% if (glance.length) { %>
          <dl class="cr-glance">
            <% for (var gj = 0; gj < glance.length; gj += 1) { var g = glance[gj]; %>
            <div class="cr-glance-item">
              <dt><%= g.label %></dt>
              <dd><%= fmtNum(g.v) %><% if (g.unit) { %><span class="cr-glance-sub"><%= g.unit %></span><% } %><% if (g.st) { %><span class="cr-glance-sub">第 <%= g.st.rank %> / <%= g.st.total %></span><% } %></dd>
            </div>
            <% } %>
          </dl>
          <% } %>
        </div>
        <% if (page.cityPhoto) { %>
        <figure class="cr-hero-fig">
          <%# 图按原比例完整呈现（不裁切）：width/height 用图片真实像素，只作宽高比参考，
              CSS 用 width:100% + height:auto 自适应列宽 %>
          <img src="<%= page.cityPhoto.src %>" alt="<%= c.name %>城市景观照片"<% if (page.cityPhoto.width) { %> width="<%= page.cityPhoto.width %>" height="<%= page.cityPhoto.height %>"<% } %> loading="lazy">
          <figcaption><%= page.cityPhoto.credit %></figcaption>
        </figure>
        <% } %>
      </div>
    </header>

    <% if (page.cityMap) { %>
    <%# 位置图（2026-11-02，2026-11-04 改回单幅）：一省一份静态 SVG，本省沿边界填 accent。
        底图只做投影与抽稀、不改边界；数据来源见 tools/build-china-map-data.js。
        一幅画到底——南海诸岛与大陆同框，不再做右下角插图。 %>
    <section class="cr-mapsec">
      <h2 class="cr-sec-title">位置</h2>
      <figure class="cr-map">
        <img src="<%= page.cityMap.src %>" alt="<%= page.cityMap.province %>在中国的方位" width="<%= page.cityMap.width %>" height="<%= page.cityMap.height %>" loading="lazy">
        <figcaption>红色为 <%= page.cityMap.province %>；底图为公开省级边界数据的投影简版，含南海诸岛，边界未作改动。</figcaption>
      </figure>
    </section>
    <% } %>

    <% if (keys.length && specGroups.length) { %>
    <%# 城市档案（2026-11-04 结构改版）：原来是 21 行横贯全宽的 dt/dd 同构横条，
        顺序还沿用 yml 的采集批次——上海页第一行是「地铁首线开通年份」，地区生产总值排到倒数第二。
        现在按 PRD §4.2 的十组呈现，排法是「规格表」：组名在左成一个竖列，字段在右排两列。
        组名竖排成一列之后，七个组名一眼扫得完，纵向长度也只有单栏的一半。 %>
    <section class="cr-profile">
      <h2 class="cr-sec-title">城市档案</h2>
      <div class="cr-spec">
        <% for (var sgi = 0; sgi < specGroups.length; sgi += 1) { var sg = specGroups[sgi]; %>
        <section class="cr-spec-group">
          <h3 class="cr-spec-title"><%= sg.name %></h3>
          <dl class="cr-spec-list">
            <% for (var sji = 0; sji < sg.items.length; sji += 1) { var it = sg.items[sji]; var mv = it.metric
              // 来源注记不再逐条平铺（2026-11-01 可读性改版）：收进行级 title 悬停 + 页尾来源清单；
              // 位次（页面最有信息量的字段）作为徽标留在行尾。候选池总数进悬停，
              // 行内只留「第 N 位」——两列并排时「36 城参比 · 第 2 位」会把行撑破。
              // 口径词「城参比」「从高到低第」被 test/cityrank-e2e.js S17 产物断言锁定，
              // 改措辞必须连断言一起改。
              var hasV = mv && typeof mv.v === 'number'
              var st = standings[it.key]
              var tip = []
              if (hasV && mv.asOf) tip.push(mv.asOf)
              if (srcMap[mv.source]) tip.push(srcMap[mv.source].name)
              if (st) tip.push('共 ' + st.total + ' 城参比 · 第 ' + st.rank + ' 位') %>
            <div class="cr-spec-item"<% if (tip.length) { %> title="<%= tip.join(' · ') %>"<% } %>>
              <dt><%= it.label %></dt>
              <dd>
                <% if (hasV) { %>
                <span class="cr-pval"><%= fmtNum(mv.v) %></span><% if (mv.unit) { %><span class="cr-punit"><%= mv.unit %></span><% } %><% if (st) { %><span class="cr-standing-badge">第 <%= st.rank %> 位</span><% } %>
                <% } else { %>
                <span class="cr-pending">[待补]</span>
                <% } %>
              </dd>
            </div>
            <% } %>
          </dl>
        </section>
        <% } %>
      </div>
    </section>
    <% } else if (!keys.length) { %>
    <p class="cr-empty">这座城市的统计字段还没有采集到权威来源，暂不列出——不填估算值。</p>
    <% } %>

    <% if (mentions.length) { %>
    <%# 上榜记录（2026-11-04 结构改版）：原先是 45 条横贯全宽的单列，一条一条垂直拉满两屏，
        整页读到这里就成了流水账。现在两栏并流、名次前置成固定列——名次是这一节唯一可比的
        信息，固定列宽才能竖着扫；榜单名在右，撑满剩余宽度。 %>
    <section class="cr-mentions">
      <h2 class="cr-sec-title">上榜记录</h2>
      <p class="cr-mentions-note">共上榜 <strong><%= mentionsAll %></strong> 项，按 <strong><%= mentions.length %></strong> 组归类；名次为该项榜单内的排位，综合指数见悬停。</p>
      <div class="cr-mention-cols">
      <% for (var mi = 0; mi < mentions.length; mi += 1) { var mg = mentions[mi]
        var best = mg.hits[0].rank
        for (var bi = 1; bi < mg.hits.length; bi += 1) { if (mg.hits[bi].rank < best) best = mg.hits[bi].rank }
      %>
      <section class="cr-mention-group">
        <h3 class="cr-mention-group-title"><%= mg.group %><span class="cr-mention-sum">上榜 <%= mg.hits.length %> 项 · 最好成绩第 <%= best %> 名</span></h3>
        <ul class="cr-mention-list">
          <% for (var hi = 0; hi < mg.hits.length; hi += 1) { var ht = mg.hits[hi] %>
          <li>
            <span class="cr-mention-rank">第 <b><%= ht.rank %></b></span>
            <a href="<%= url_for('/cityrank/' + ht.slug + '/') %>"<% if (ht.kind === 'computed' && typeof ht.score === 'number') { %> title="综合指数 <%= ht.score %>"<% } %>><%= ht.title %></a>
          </li>
          <% } %>
        </ul>
      </section>
      <% } %>
      </div>
    </section>
    <% } %>

    <%
    // 本页来源清单（2026-11-01 可读性改版）：原逐条 cr-pmeta 的来源收拢到这里，
    // 与 cr-profile-note、cal-note 三处说明合并为页尾一处。
    var usedSources = [];
    for (var ui = 0; ui < keys.length; ui += 1) {
      var umv = c.metrics[keys[ui]];
      if (umv && typeof umv.v === 'number' && srcMap[umv.source] && usedSources.indexOf(srcMap[umv.source].name) === -1) {
        usedSources.push(srcMap[umv.source].name);
      }
    }
    %>
    <div class="cal-after">
      <p class="cal-note">以上只列已核验过的字段，缺值一律标 [待补]、不填估算值；位次是同字段候选池内从高到低第几位的排序位置（同值按拼音定序），不含优劣评价。数据来自各地统计公报与行业主管部门公开名录，批量数据站只作交叉核对、不作唯一来源，单条数据的年份与来源可悬停字段行查看。<% if (usedSources.length) { %>本页来源：<%= usedSources.join('、') %>。<% } %></p>
    </div>

    <% } %>
  </div>
</div>
