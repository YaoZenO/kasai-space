<%- css_ex(theme.static_prefix.bootstrap, 'css/bootstrap.min.css') %>

<% var css_snippets = deduplicate(page.css_snippets) %>
<% for (var idx = 0; idx < css_snippets.length; idx++) { %>
  <%- css_snippets[idx] %>
<% } %>
<% page.css_snippets = [] %>

<!-- 主题依赖的图标库（2026-10-15 起为自托管镜像 /lib/iconfont-theme.css，字体在 source/fonts/，勿单独删文件） -->
<!-- Do not modify the link that theme dependent icons -->
<%- css('/lib/iconfont-theme.css') %>

<%- css(theme.static_prefix.iconfont || theme.iconfont) %>

<%- css_ex(theme.static_prefix.internal_css, 'main.css') %>

<% if (theme.code.highlight.enable) { %>
  <%# 代码配色不参与首屏渲染，改异步加载（T3-3）：先以 media="print" 进入，
      加载完 onload 切回 all。这里手写标签而不用 css_ex——它拼出的标签
      只有 rel 与 href，加不了 media 与 onload。 %>
  <link id="highlight-css" rel="stylesheet" href="<%= url_join(theme.static_prefix.internal_css, 'highlight.css') %>" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="<%= url_join(theme.static_prefix.internal_css, 'highlight.css') %>"></noscript>
  <% if (theme.dark_mode.enable) { %>
    <link id="highlight-css-dark" rel="stylesheet" href="<%= url_join(theme.static_prefix.internal_css, 'highlight-dark.css') %>" media="print" onload="this.media='all'">
  <% } %>
<% } %>

<% if (theme.custom_css) { %>
  <%# 不用 css() helper：它会给不以 .css 结尾的 URL 追加 .css，
      碰到 /css/site.css?v=<hash> 会拼成 .css?v=<hash>.css（404）。
      版本号由 scripts/filters/asset-version.js 在生成期附加。 %>
  <link rel="stylesheet" href="<%- url_for(theme.custom_css) %>">
<% } %>
