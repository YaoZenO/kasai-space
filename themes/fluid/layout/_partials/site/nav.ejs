<%
// 方案 C 悬浮胶囊导航：品牌外置左侧 · 菜单胶囊居中 · 搜索外置右侧
// 当前页选中态：深色实心胶囊（.active）
var currentPath = ('/' + (page.path || '')).replace(/index\.html$/, '')
%>

<nav id="navbar" class="navbar fixed-top navbar-dark scrolling-navbar site-nav">
  <div class="site-nav-inner">
    <a class="navbar-brand site-brand" href="<%= url_for() %>">
      <strong><%= theme.navbar.blog_title || config.title %></strong>
    </a>

    <%# 中列：主胶囊 + 辅助导航组（节假日 / 资料库，2026-10-25 主人要求独立右置）
       V4：断点由 Bootstrap lg(992) 改为 840，由 site.css 的 .site-nav-center / .site-nav-toggle 互斥控制 %>
    <div class="site-nav-center">
      <div class="site-nav-capsule">
        <ul class="site-nav-list">
          <% for (const each of theme.navbar.menu || []) { %>
            <% if (!each.submenu && !each.link) continue %>
            <% var text = each.name || __(each.key + '.menu') || __(each.key + '.title') %>
            <% if (text.indexOf('.menu') !== -1 || text.indexOf('.title') !== -1) { text = each.key } %>
            <% if (each.submenu) { %>
              <%
              /* IA-11：下拉子项命中当前路径时，父项与子项都要有「你在这里」 */
              var subActive = false
              for (const s of (each.submenu || [])) {
                if (s && s.link && currentPath.indexOf(url_for(s.link)) === 0) { subActive = true; break }
              }
              %>
              <li class="nav-item dropdown<%= subActive ? ' active' : '' %>">
                <a class="nav-link dropdown-toggle" target="_self" href="javascript:;" role="button"
                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <%- each.icon ? '<i class="' + each.icon + '"></i>' : '' %>
                  <span><%- text %></span>
                </a>
                <div class="dropdown-menu">
                  <% for (const subEach of each.submenu || []) { %>
                    <% if (!subEach.link) continue %>
                    <% var subText = subEach.name || __(subEach.key + '.title') %>
                    <% if (subText.indexOf('.title') !== -1) { subText = subEach.key } %>
                    <%
                    var subIsActive = currentPath.indexOf(url_for(subEach.link)) === 0
                    %>
                    <a class="dropdown-item<%= subIsActive ? ' active' : '' %>" href="<%= url_for(subEach.link) %>" target="<%= subEach.target || '_self' %>"<%= subIsActive ? ' aria-current="page"' : '' %>>
                      <%- subEach.icon ? '<i class="' + subEach.icon + '"></i>' : '' %>
                      <span><%- subText %></span>
                    </a>
                  <% } %>
                </div>
              </li>
            <% } else { %>
              <% var isActive = each.link === '/'
                ? currentPath === '/'
                : currentPath.indexOf(url_for(each.link)) === 0 %>
              <li class="nav-item<%= isActive ? ' active' : '' %>">
                <a class="nav-link" href="<%= url_for(each.link) %>" target="<%= each.target || '_self' %>"<%= isActive ? ' aria-current="page"' : '' %>>
                  <%- each.icon ? '<i class="' + each.icon + '"></i>' : '' %>
                  <span><%- text %></span>
                </a>
              </li>
            <% } %>
          <% } %>
        </ul>
      </div>

      <%# 辅助导航：与主胶囊之间留白 + 左侧细分隔线，形态独立（不用胶囊底） %>
      <% if (theme.navbar.aux_menu && theme.navbar.aux_menu.length) { %>
      <nav class="site-nav-aux" aria-label="资料与工具">
        <% for (const each of theme.navbar.aux_menu) { %>
          <% if (!each.link) continue %>
          <% var auxText = each.name || each.key %>
          <% var auxActive = currentPath.indexOf(url_for(each.link)) === 0 %>
          <a class="site-nav-aux-link<%= auxActive ? ' active' : '' %>" href="<%= url_for(each.link) %>"<%= auxActive ? ' aria-current="page"' : '' %>>
            <span><%- auxText %></span>
          </a>
        <% } %>
      </nav>
      <% } %>
    </div>

    <div class="site-nav-actions">
      <% if (theme.search.enable) { %>
        <a id="search-btn" class="nav-link" target="_self" href="javascript:;"
           data-toggle="modal" data-target="#modalSearch" aria-label="Search">
          <i class="iconfont icon-search"></i>
        </a>
        <%#
          P0-4：local-search.js 是 IIFE，解析期立即执行并直接调用 jQuery，
          而 jquery.min.js 已改 defer（晚于解析期）。必须也改 defer 才能保序：
          defer 脚本按文档顺序执行，jquery 在前 → local-search 在其后，依赖成立。
        %>
        <% import_js(theme.static_prefix.internal_js, 'local-search.js', 'defer') %>
      <% } %>
      <button id="navbar-toggler-btn" class="navbar-toggler site-nav-toggle" type="button"
              aria-controls="mobile-grid-menu" aria-expanded="false" aria-label="Toggle navigation">
        <div class="animated-icon"><span></span><span></span><span></span></div>
      </button>
      <% if (theme.dark_mode && theme.dark_mode.enable) { %>
        <a class="nav-link d-none d-lg-flex" target="_self" href="javascript:;" aria-label="Color Toggle">
          <i class="iconfont icon-dark" id="color-toggle-icon"></i>
        </a>
      <% } %>
    </div>
  </div>
</nav>

<!-- Mobile grid menu overlay -->
<div id="mobile-grid-menu" class="site-mobile-menu">
  <div class="mobile-grid-menu-inner">
    <div class="container">
      <div class="row">
        <% for (const each of theme.navbar.menu || []) { %>
          <% if (!each.submenu && !each.link) continue %>
          <% var gridText = each.name || __(each.key + '.menu') || __(each.key + '.title') %>
          <% if (gridText.indexOf('.menu') !== -1 || gridText.indexOf('.title') !== -1) {
            gridText = each.key
          } %>
          <% if (each.submenu) { %>
            <div class="col-12 mobile-grid-group-header">
              <%- each.icon ? '<i class="' + each.icon + '"></i>' : '' %>
              <span><%- gridText %></span>
            </div>
            <% for (const subEach of each.submenu || []) { %>
              <% if (!subEach.link) continue %>
              <% var subGridText = subEach.name || __(subEach.key + '.title') %>
              <% if (subGridText.indexOf('.title') !== -1) {
                subGridText = subEach.key
              } %>
              <div class="col-4 mobile-grid-cell">
                <a href="<%= url_for(subEach.link) %>" target="<%= subEach.target || '_self' %>">
                  <div class="mobile-grid-item">
                    <%- subEach.icon ? '<i class="' + subEach.icon + '"></i>' : '<i class="iconfont icon-link-fill"></i>' %>
                    <span><%- subGridText %></span>
                  </div>
                </a>
              </div>
            <% } %>
          <% } else { %>
            <div class="col-4 mobile-grid-cell">
              <a href="<%= url_for(each.link) %>" target="<%= each.target || '_self' %>">
                <div class="mobile-grid-item">
                  <%- each.icon ? '<i class="' + each.icon + '"></i>' : '<i class="iconfont icon-link-fill"></i>' %>
                  <span><%- gridText %></span>
                </div>
              </a>
            </div>
          <% } %>
        <% } %>
        <% if (theme.search.enable) { %>
          <div class="col-4 mobile-grid-cell" id="mobile-search-btn">
            <a href="javascript:;" data-toggle="modal" data-target="#modalSearch" aria-label="Search">
              <div class="mobile-grid-item">
                <i class="iconfont icon-search"></i>
                <span><%= __('search.title') !== 'search.title' ? __('search.title') : 'Search' %></span>
              </div>
            </a>
          </div>
        <% } %>
        <%# 辅助导航（节假日 / 资料库）同步进移动端九宫格 %>
        <% for (const each of theme.navbar.aux_menu || []) { %>
          <% if (!each.link) continue %>
          <div class="col-4 mobile-grid-cell">
            <a href="<%= url_for(each.link) %>">
              <div class="mobile-grid-item">
                <i class="iconfont icon-link-fill"></i>
                <span><%- each.name || each.key %></span>
              </div>
            </a>
          </div>
        <% } %>
        <% if (theme.dark_mode && theme.dark_mode.enable) { %>
          <div class="col-4 mobile-grid-cell" id="mobile-color-toggle-btn"
               data-label-light="<%= __('darkmode.light') %>"
               data-label-dark="<%= __('darkmode.dark') %>">
            <a href="javascript:;" aria-label="Color Toggle">
              <div class="mobile-grid-item">
                <i class="iconfont icon-dark" id="mobile-color-toggle-icon"></i>
                <span id="mobile-color-toggle-label"><%= __('darkmode.dark') %></span>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
